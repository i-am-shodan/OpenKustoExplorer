<Application
    x:Class="OpenKustoExplorer.Browser.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedThemeVariant="Default">
  <Application.Styles>
    <StyleInclude Source="avares://OpenKustoExplorer.Avalonia/WorkbenchStyles.axaml" />
    <Style Selector="UserControl.workbench">
      <Setter Property="FontFamily" Value="fonts:Inter#Inter" />
    </Style>
  </Application.Styles>
</Application>