<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <PackageReference Include="Azure.AI.OpenAI" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Microsoft.Azure.Kusto.Language" />
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <PackageReference Include="Microsoft.Identity.Client" />
    <PackageReference Include="Microsoft.Identity.Web" />
    <ProjectReference Include="..\OpenKustoExplorer.Web.Hosting\OpenKustoExplorer.Web.Hosting.csproj" />
    <ProjectReference Include="..\OpenKustoExplorer.Kusto\OpenKustoExplorer.Kusto.csproj" />
    <ProjectReference
        Include="..\OpenKustoExplorer.Browser\OpenKustoExplorer.Browser.csproj"
        ReferenceOutputAssembly="false"
        SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Assistance\IWebCopilotService.cs" />
    <Compile Remove="Assistance\WebCopilotUnavailableException.cs" />
    <Compile Remove="Authentication\FederatedWebSignOutService.cs" />
    <Compile Remove="Authentication\IWebSignOutService.cs" />
    <Compile Remove="Authentication\LocalDevelopmentWebSignOutService.cs" />
    <Compile Remove="Kusto\IHostAddressResolver.cs" />
    <Compile Remove="Kusto\KustoGatewayEndpoints.cs" />
    <Compile Remove="Kusto\KustoOperationRegistry.cs" />
    <Compile Remove="Kusto\LocalDevelopmentKustoAccessTokenProvider.cs" />
    <Compile Remove="Kusto\PublicAdxEndpointPolicy.cs" />
    <Compile Remove="Kusto\SystemHostAddressResolver.cs" />
    <Compile Remove="Kusto\WebKustoAccessTokenProvider.cs" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsAotCompatible>false</IsAotCompatible>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <UserSecretsId>OpenKustoExplorer-Web-Development</UserSecretsId>
  </PropertyGroup>

  <Import Project="..\OpenKustoExplorer.Browser\OpenKustoExplorer.BrowserHost.targets" />

</Project>
