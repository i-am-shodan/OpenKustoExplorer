<UserControl
  x:Class="OpenKustoExplorer.Desktop.WorkbenchView"
    x:CompileBindings="True"
    x:DataType="presentation:MainWindowViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:assistance="clr-namespace:OpenKustoExplorer.Application.Assistance;assembly=OpenKustoExplorer.Application"
    xmlns:avaloniaEdit="using:AvaloniaEdit"
    xmlns:charts="clr-namespace:OpenKustoExplorer.Desktop.Charts"
    xmlns:controls="using:OpenKustoExplorer.Desktop.Controls"
    xmlns:desktop="using:OpenKustoExplorer.Desktop"
    xmlns:editor="clr-namespace:OpenKustoExplorer.Desktop.Editor"
    xmlns:graph="clr-namespace:OpenKustoExplorer.Graph;assembly=OpenKustoExplorer.Graph"
    xmlns:presentation="clr-namespace:OpenKustoExplorer.Presentation.Workbench;assembly=OpenKustoExplorer.Presentation"
    AutomationProperties.AutomationId="MainWorkbench"
    Classes="workbench"
    KeyDown="OnWindowKeyDown"
    SizeChanged="OnWindowSizeChanged">
  <UserControl.Styles>
    <Style Selector="SplitView.databaseExplorer:left:open /template/ Panel#PART_PaneRoot">
      <Setter Property="Transitions">
        <Transitions />
      </Setter>
    </Style>
    <Style Selector="SplitView.databaseExplorer:left:closed /template/ Panel#PART_PaneRoot">
      <Setter Property="Transitions">
        <Transitions />
      </Setter>
    </Style>
    <Style Selector="LucideIcon.copilotSpinner">
      <Setter Property="RenderTransformOrigin" Value="50%,50%" />
      <Setter Property="RenderTransform">
        <RotateTransform />
      </Setter>
      <Style.Animations>
        <Animation Duration="0:0:0.8" IterationCount="INFINITE">
          <KeyFrame Cue="0%">
            <Setter Property="RotateTransform.Angle" Value="0" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="RotateTransform.Angle" Value="360" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="52,*">
    <Border
        Grid.Row="0"
        Background="{DynamicResource ChromeSurfaceBrush}"
        BorderBrush="{DynamicResource DecorativeDividerBrush}"
        BorderThickness="0,0,0,1">
      <Grid Margin="12,0" ColumnDefinitions="Auto,1,*" ColumnSpacing="12">
        <StackPanel x:Name="HeaderBrand" Grid.Column="0" VerticalAlignment="Center" Orientation="Horizontal">
          <StackPanel VerticalAlignment="Center" Spacing="0">
            <TextBlock
                FontSize="{DynamicResource TypeTitleSize}"
                FontWeight="SemiBold"
                Text="Open Kusto Explorer" />
            <TextBlock
                Classes="tertiary"
                FontSize="{DynamicResource TypeSmallSize}"
                Text="Query workbench" />
          </StackPanel>
        </StackPanel>

        <Border
          x:Name="HeaderDivider"
            Grid.Column="1"
            Height="24"
            Background="{DynamicResource DecorativeDividerBrush}" />

        <StackPanel
            Grid.Column="2"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="8">
          <Border
              x:Name="TabSearchContainer"
              Width="320"
              Height="34"
              Background="{DynamicResource RaisedSurfaceBrush}"
              BorderBrush="{DynamicResource ControlBoundaryBrush}"
              BorderThickness="1"
              CornerRadius="5">
            <Grid ColumnDefinitions="34,*,30">
              <LucideIcon
                  Grid.Column="0"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Kind="Search"
                  Size="15"
                  Foreground="{DynamicResource TextSecondaryBrush}" />
              <TextBox
                  x:Name="TabSearchBox"
                  Grid.Column="1"
                  Height="32"
                  AutomationProperties.Name="Search all query tabs"
                  Background="Transparent"
                  BorderThickness="0"
                  KeyDown="OnTabSearchKeyDown"
                  Text="{Binding TabSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  ToolTip.Tip="Search all tabs (Ctrl+Shift+F)"
                  VerticalContentAlignment="Center"
                  PlaceholderText="Search all tabs" />
              <Button
                  Grid.Column="2"
                  Width="26"
                  Height="26"
                  VerticalAlignment="Center"
                  AutomationProperties.Name="Clear tab search"
                  Classes="treeAction"
                  Command="{Binding CloseTabSearchCommand}"
                  IsVisible="{Binding IsTabSearchOpen}"
                  ToolTip.Tip="Clear search">
                <LucideIcon Kind="X" Size="13" />
              </Button>
            </Grid>
          </Border>
          <Button
              x:Name="UpdateButton"
              Height="32"
              VerticalAlignment="Center"
              AutomationProperties.Name="Download available update"
              Classes="primaryCommand"
              Click="OnOpenUpdateClick"
              IsVisible="False"
              ToolTip.Tip="Open the latest official GitHub release">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <LucideIcon Kind="Download" Size="13" />
              <TextBlock Text="Update" />
            </StackPanel>
          </Button>
          <ScrollViewer MaxWidth="180" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="SignedInUsersList" AutomationProperties.Name="Signed-in users">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="5" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="desktop:SignedInUserAvatarViewModel">
                  <Button
                      Width="32"
                      Height="32"
                      AutomationProperties.Name="{Binding AutomationName}"
                      Background="{DynamicResource AccentSubtleBrush}"
                      BorderBrush="{DynamicResource ControlBoundaryBrush}"
                      BorderThickness="1"
                      ClipToBounds="True"
                      CornerRadius="16"
                      Padding="0"
                      ToolTip.Tip="{Binding ToolTipText}">
                    <Button.Flyout>
                      <Flyout Placement="BottomEdgeAlignedRight">
                        <StackPanel MinWidth="190" Spacing="8">
                          <StackPanel Spacing="1">
                            <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                            <TextBlock Classes="tertiary" FontSize="{DynamicResource TypeMetadataSize}" Text="{Binding AccountName}" />
                          </StackPanel>
                          <Button
                              AutomationProperties.Name="Sign out of Kusto"
                              Classes="command"
                              Click="OnSignOutClick"
                              CommandParameter="{Binding AccountId}"
                              HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                              <LucideIcon Kind="LogOut" Size="14" />
                              <TextBlock Text="Sign out" />
                            </StackPanel>
                          </Button>
                        </StackPanel>
                      </Flyout>
                    </Button.Flyout>
                    <Grid>
                      <LucideIcon
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                        Kind="User"
                        Size="16"
                          Foreground="{DynamicResource AccentBrush}"
                        IsVisible="{Binding !HasProfilePhoto}" />
                      <Image
                        Width="32"
                        Height="32"
                          IsVisible="{Binding HasProfilePhoto}"
                          Source="{Binding ProfilePhoto}"
                          Stretch="UniformToFill" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>
      </Grid>
    </Border>

    <Border
        Grid.Row="0"
        Grid.RowSpan="2"
        ZIndex="90"
        Width="420"
        MaxHeight="430"
        Margin="0,48,12,0"
        Padding="8"
        HorizontalAlignment="Right"
        VerticalAlignment="Top"
        Background="{DynamicResource RaisedSurfaceBrush}"
        BorderBrush="{DynamicResource ControlBoundaryBrush}"
        BorderThickness="1"
        CornerRadius="6"
        IsVisible="{Binding IsTabSearchOpen}">
      <Grid RowDefinitions="34,*">
        <Grid Grid.Row="0" Margin="6,0" ColumnDefinitions="*,Auto">
          <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Across open tabs" />
          <TextBlock Grid.Column="1" Classes="tertiary" VerticalAlignment="Center" FontSize="{DynamicResource TypeSmallSize}" Text="{Binding TabSearchSummary}" />
        </Grid>
        <ListBox
            Grid.Row="1"
            MaxHeight="370"
            Background="Transparent"
            BorderThickness="0"
            IsVisible="{Binding HasTabSearchResults}"
            ItemsSource="{Binding TabSearchResults}"
            SelectionChanged="OnTabSearchSelectionChanged">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="presentation:KustoTabSearchResultViewModel">
              <Grid MinWidth="374" Margin="7,4" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <TextBlock FontSize="{DynamicResource TypeCompactSize}" FontWeight="SemiBold" Text="{Binding DocumentTitle}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Classes="tertiary" FontSize="{DynamicResource TypeMetadataSize}" Text="{Binding LocationText}" />
                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Classes="muted" FontFamily="Cascadia Code, JetBrains Mono, Noto Sans Mono, monospace" FontSize="{DynamicResource TypeSmallSize}" Text="{Binding PreviewText}" TextTrimming="CharacterEllipsis" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="1" Margin="18,28" HorizontalAlignment="Center" IsVisible="{Binding !HasTabSearchResults}" Spacing="6">
          <LucideIcon HorizontalAlignment="Center" Kind="SearchX" Size="20" Foreground="{DynamicResource TextTertiaryBrush}" />
          <TextBlock Classes="muted" Text="No matches across open tabs" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="48,*,Auto">
      <Border
          Grid.Column="0"
          Background="{DynamicResource ChromeSurfaceBrush}"
          BorderBrush="{DynamicResource DecorativeDividerBrush}"
          BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto,*,Auto">
          <StackPanel Grid.Row="0" Margin="0,4,0,0">
            <Button
                x:Name="ConnectionsButton"
                AutomationProperties.Name="Database explorer"
                Classes="activity"
                Classes.selected="{Binding IsQueryWorkbenchView}"
                Click="OnConnectionsClick"
                ToolTip.Tip="Database explorer">
              <LucideIcon Kind="Database" Size="20" StrokeWidth="1.8" />
            </Button>
            <Button
                x:Name="DashboardButton"
                AutomationProperties.Name="Dashboards"
                Classes="activity"
                Classes.selected="{Binding IsDashboardView}"
                Click="OnDashboardsClick"
                ToolTip.Tip="Query dashboards">
              <LucideIcon Kind="LayoutDashboard" Size="20" StrokeWidth="1.8" />
            </Button>
            <Button
                x:Name="AutomationButton"
                AutomationProperties.Name="Automations"
                Classes="activity"
                Classes.selected="{Binding IsAutomationView}"
                Click="OnAutomationsClick"
                ToolTip.Tip="Scheduled query automations">
              <LucideIcon Kind="Clock3" Size="20" StrokeWidth="1.8" />
            </Button>
            <Button
                x:Name="SessionsButton"
                AutomationProperties.Name="Recorded investigations"
                Classes="activity"
                Classes.selected="{Binding IsSessionsView}"
                Click="OnSessionsClick"
                ToolTip.Tip="Recorded investigations">
              <LucideIcon Kind="GitBranch" Size="20" StrokeWidth="1.8" />
            </Button>
            <Button
                x:Name="GraphButton"
                AutomationProperties.Name="Investigation graph"
                Classes="activity"
                Classes.selected="{Binding IsGraphView}"
                Click="OnGraphClick"
                ToolTip.Tip="Investigation graph">
              <LucideIcon Kind="GitGraph" Size="20" StrokeWidth="1.8" />
            </Button>
          </StackPanel>

          <StackPanel Grid.Row="2" Margin="0,0,0,4">
            <Button
                x:Name="SettingsButton"
                AutomationProperties.Name="Application settings"
                Classes="activity"
                Click="OnSettingsClick"
                ToolTip.Tip="Application settings">
              <LucideIcon Kind="Settings" Size="20" StrokeWidth="1.8" />
            </Button>
            <Button
              x:Name="AppearanceButton"
              AutomationProperties.Name="Appearance"
              Classes="activity"
              ToolTip.Tip="Appearance">
            <LucideIcon Kind="Sun" Size="20" StrokeWidth="1.8" />
            <Button.Flyout>
              <Flyout Placement="Right">
                <Border Width="270" Padding="16">
                  <StackPanel Spacing="10">
                    <TextBlock
                        FontSize="{DynamicResource TypeTitleSize}"
                        FontWeight="SemiBold"
                        Text="Appearance" />
                    <TextBlock Classes="sectionLabel" Margin="0,4,0,0" Text="THEME" />
                    <RadioButton
                        x:Name="SystemThemeOption"
                        MinHeight="32"
                        Content="System"
                      GroupName="ThemePreference"
                      IsCheckedChanged="OnSystemThemeChecked" />
                    <RadioButton
                        x:Name="LightThemeOption"
                        MinHeight="32"
                        Content="Light"
                      GroupName="ThemePreference"
                      IsCheckedChanged="OnLightThemeChecked" />
                    <RadioButton
                        x:Name="DarkThemeOption"
                        MinHeight="32"
                        Content="Dark"
                      GroupName="ThemePreference"
                      IsCheckedChanged="OnDarkThemeChecked" />
                    <Border
                        Height="1"
                        Margin="0,4"
                        Background="{DynamicResource DecorativeDividerBrush}" />
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="4">
                      <TextBlock FontWeight="SemiBold" Text="Interface text" />
                      <TextBlock
                        x:Name="TextZoomValue"
                        Grid.Column="1"
                        Classes="tertiary"
                        FontSize="{DynamicResource TypeCompactSize}"
                        Text="100%" />
                      <Slider
                        x:Name="TextZoomSlider"
                        Grid.Row="1"
                        Grid.ColumnSpan="2"
                        AutomationProperties.Name="Interface text zoom"
                        IsSnapToTickEnabled="True"
                        Maximum="140"
                        Minimum="85"
                        TickFrequency="5"
                        ValueChanged="OnTextZoomChanged" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="4">
                      <TextBlock FontWeight="SemiBold" Text="Result table text" />
                      <TextBlock
                        x:Name="ResultTextZoomValue"
                        Grid.Column="1"
                        Classes="tertiary"
                        FontSize="{DynamicResource TypeCompactSize}"
                        Text="100%" />
                      <Slider
                        x:Name="ResultTextZoomSlider"
                        Grid.Row="1"
                        Grid.ColumnSpan="2"
                        AutomationProperties.Name="Result table text zoom"
                        IsSnapToTickEnabled="True"
                        Maximum="250"
                        Minimum="85"
                        TickFrequency="5"
                        ValueChanged="OnResultTextZoomChanged" />
                    </Grid>
                    <Border
                      Height="1"
                      Margin="0,4"
                      Background="{DynamicResource DecorativeDividerBrush}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                      <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock FontWeight="SemiBold" Text="Comfortable density" />
                        <TextBlock
                            x:Name="DensityDescription"
                            Classes="muted"
                            FontSize="{DynamicResource TypeCompactSize}"
                            Text="Compact controls and rows" />
                      </StackPanel>
                      <ToggleSwitch
                          x:Name="DensityToggle"
                          Grid.Column="1"
                          AutomationProperties.Name="Comfortable density"
                          VerticalAlignment="Center"
                          IsCheckedChanged="OnDensityToggleChanged" />
                    </Grid>
                    <Border
                        x:Name="HighContrastNotice"
                        IsVisible="False"
                        Margin="0,4,0,0"
                        Padding="8,7"
                        Background="{DynamicResource AccentSubtleBrush}"
                        BorderBrush="{DynamicResource ControlBoundaryBrush}"
                        BorderThickness="1"
                        CornerRadius="5">
                      <TextBlock
                          FontSize="{DynamicResource TypeCompactSize}"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          Text="System high contrast is active"
                          TextWrapping="Wrap" />
                    </Border>
                  </StackPanel>
                </Border>
              </Flyout>
            </Button.Flyout>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <SplitView
          x:Name="NavigationSplitView"
          Grid.Column="1"
          Classes="databaseExplorer"
          CompactPaneLength="0"
          DisplayMode="Inline"
          IsVisible="{Binding IsQueryWorkbenchView}"
          IsPaneOpen="True"
          OpenPaneLength="280"
          PaneBackground="{DynamicResource SurfaceBrush}">
        <SplitView.Pane>
          <Border
              Width="280"
              Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource DecorativeDividerBrush}"
              BorderThickness="0,0,1,0">
            <Grid RowDefinitions="52,Auto,*,Auto">
              <Grid Grid.Row="0" Margin="14,0,8,0">
                <StackPanel VerticalAlignment="Center" Spacing="1">
                  <TextBlock
                      FontSize="{DynamicResource TypeEmphasisSize}"
                      FontWeight="SemiBold"
                      Text="Explorer" />
                  <TextBlock Classes="tertiary" FontSize="{DynamicResource TypeSmallSize}" Text="Clusters and databases" />
                </StackPanel>
              </Grid>

              <Grid Grid.Row="1" Margin="12,8,12,8">
                <TextBox
                    x:Name="SchemaSearch"
                    AutomationProperties.Name="Filter Explorer"
                    Classes="schemaSearch"
                    PlaceholderText="Filter"
                    Text="{Binding SchemaFilterText}" />
                <LucideIcon
                    Margin="9,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False"
                    Kind="Search"
                    Size="14"
                    Foreground="{DynamicResource TextTertiaryBrush}" />
              </Grid>

              <Grid Grid.Row="2">
                  <TreeView
                      x:Name="ConnectionTree"
                      Margin="6,0,6,12"
                      AutomationProperties.Name="Azure Data Explorer connections"
                      ContainerPrepared="OnConnectionTreeContainerPrepared"
                      ItemsSource="{Binding VisibleExplorerItems}"
                      SelectedItem="{Binding SelectedExplorerItem, Mode=TwoWay}">
                    <TreeView.DataTemplates>
                      <TreeDataTemplate
                          x:DataType="presentation:KustoFolderViewModel"
                          ItemsSource="{Binding VisibleClusters}">
                        <Grid MinWidth="224" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                          <LucideIcon
                              Grid.Column="0"
                              VerticalAlignment="Center"
                              Kind="Folder"
                              Size="16"
                              Foreground="{DynamicResource WarningBrush}" />
                          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                            <TextBlock
                                FontSize="{DynamicResource TypeCaptionSize}"
                                FontWeight="SemiBold"
                                Text="{Binding Name}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock Classes="tertiary" FontSize="{DynamicResource TypeMetadataSize}" Text="{Binding StatusText}" />
                          </StackPanel>
                        </Grid>
                      </TreeDataTemplate>
                      <TreeDataTemplate
                          x:DataType="presentation:KustoClusterViewModel"
                          ItemsSource="{Binding VisibleDatabases}">
                        <Grid MinWidth="218" ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="5">
                          <Grid.ContextMenu>
                            <ContextMenu>
                              <MenuItem Header="Move to folder..." Command="{Binding OrganizeCommand}" />
                              <MenuItem Header="Refresh databases" Command="{Binding RefreshCommand}" />
                              <Separator />
                              <MenuItem Header="Remove cluster" Command="{Binding RemoveCommand}">
                                <MenuItem.Icon>
                                  <LucideIcon Kind="Trash" Size="14" />
                                </MenuItem.Icon>
                              </MenuItem>
                            </ContextMenu>
                          </Grid.ContextMenu>
                          <LucideIcon
                              Grid.Column="0"
                              VerticalAlignment="Center"
                              Kind="Server"
                              Size="16"
                              Foreground="{DynamicResource AccentBrush}" />
                          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                            <TextBlock
                                FontSize="{DynamicResource TypeCaptionSize}"
                                FontWeight="SemiBold"
                                Text="{Binding DisplayName}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Classes="tertiary"
                                FontSize="{DynamicResource TypeMetadataSize}"
                                Text="{Binding StatusText}"
                                TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <Button
                              Grid.Column="2"
                              AutomationProperties.Name="Organize cluster"
                              Classes="treeAction"
                              Command="{Binding OrganizeCommand}"
                              ToolTip.Tip="Move to folder">
                            <LucideIcon Kind="Folder" Size="13" />
                          </Button>
                          <Button
                              Grid.Column="3"
                              AutomationProperties.Name="Refresh cluster"
                              Classes="treeAction"
                              Command="{Binding RefreshCommand}"
                              ToolTip.Tip="Refresh databases">
                            <LucideIcon Kind="RefreshCw" Size="13" />
                          </Button>
                          <Button
                              Grid.Column="4"
                              AutomationProperties.Name="Remove cluster"
                              Classes="treeAction"
                              Command="{Binding RemoveCommand}"
                              ToolTip.Tip="Remove cluster">
                            <LucideIcon Kind="Trash" Size="13" />
                          </Button>
                        </Grid>
                      </TreeDataTemplate>
                      <TreeDataTemplate
                          x:DataType="presentation:KustoDatabaseViewModel"
                          ItemsSource="{Binding VisibleSchemaItems}">
                        <Grid MinWidth="194" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                          <LucideIcon
                              Grid.Column="0"
                              VerticalAlignment="Center"
                              Kind="Database"
                              Size="15"
                              Foreground="{DynamicResource AccentBrush}" />
                          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                            <TextBlock
                                FontSize="{DynamicResource TypeCompactSize}"
                                FontWeight="SemiBold"
                                Text="{Binding DisplayName}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Classes="tertiary"
                                FontSize="{DynamicResource TypeMetadataSize}"
                                Text="{Binding StatusText}"
                                TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </Grid>
                      </TreeDataTemplate>
                      <TreeDataTemplate
                          x:DataType="presentation:SchemaFunctionsFolderViewModel"
                          ItemsSource="{Binding VisibleFunctions}">
                        <Grid MinWidth="190" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                          <LucideIcon
                              Grid.Column="0"
                              VerticalAlignment="Center"
                              Kind="Folder"
                              Size="15"
                              Foreground="{DynamicResource SyntaxFunctionBrush}" />
                          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                            <TextBlock FontSize="{DynamicResource TypeCompactSize}" FontWeight="SemiBold" Text="{Binding Name}" />
                            <TextBlock Classes="tertiary" FontSize="{DynamicResource TypeMetadataSize}" Text="{Binding StatusText}" />
                          </StackPanel>
                        </Grid>
                      </TreeDataTemplate>
                      <DataTemplate x:DataType="presentation:SchemaFunctionViewModel">
                        <Grid MinWidth="180" ColumnDefinitions="Auto,*" ColumnSpacing="8" ToolTip.Tip="{Binding ToolTipText}">
                          <LucideIcon
                              Grid.Column="0"
                              VerticalAlignment="Center"
                              Kind="Braces"
                              Size="14"
                              Foreground="{DynamicResource SyntaxFunctionBrush}" />
                          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                            <TextBlock
                                FontFamily="Cascadia Code, JetBrains Mono, Noto Sans Mono, monospace"
                                FontSize="{DynamicResource TypeSmallSize}"
                                Text="{Binding Signature}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Classes="tertiary"
                                FontSize="{DynamicResource TypeMetadataSize}"
                                IsVisible="{Binding Folder, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                Text="{Binding Folder}"
                                TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </Grid>
                      </DataTemplate>
                      <TreeDataTemplate
                          x:DataType="presentation:SchemaTableViewModel"
                          ItemsSource="{Binding Columns}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                          <LucideIcon
                              Grid.Column="0"
                              VerticalAlignment="Center"
                              Kind="Table2"
                              Size="15"
                              Foreground="{DynamicResource WarningBrush}" />
                          <TextBlock
                              Grid.Column="1"
                              VerticalAlignment="Center"
                              FontSize="{DynamicResource TypeCaptionSize}"
                              FontWeight="SemiBold"
                              Text="{Binding Name}" />
                        </Grid>
                      </TreeDataTemplate>
                      <DataTemplate x:DataType="presentation:SchemaColumnViewModel">
                        <Grid MinWidth="180" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                          <TextBlock
                              Grid.Column="0"
                              VerticalAlignment="Center"
                              FontSize="{DynamicResource TypeCompactSize}"
                              Text="{Binding Name}" />
                          <TextBlock
                              Grid.Column="1"
                              Classes="tertiary"
                              VerticalAlignment="Center"
                              FontFamily="Cascadia Code, JetBrains Mono, Noto Sans Mono, monospace"
                              FontSize="{DynamicResource TypeSmallSize}"
                              Text="{Binding TypeName}" />
                        </Grid>
                      </DataTemplate>
                    </TreeView.DataTemplates>
                  </TreeView>
                  <StackPanel
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      IsVisible="{Binding HasNoSchemaMatches}"
                      Spacing="5">
                    <LucideIcon
                        HorizontalAlignment="Center"
                        Kind="Search"
                        Size="19"
                        Foreground="{DynamicResource TextTertiaryBrush}" />
                    <TextBlock Classes="muted" FontSize="{DynamicResource TypeCompactSize}" Text="No connections match" />
                  </StackPanel>
              </Grid>
              <Border
                  Grid.Row="3"
                  Padding="10,8"
                  Background="{DynamicResource RaisedSurfaceBrush}"
                  BorderBrush="{DynamicResource DecorativeDividerBrush}"
                  BorderThickness="0,1,0,0">
                <StackPanel Spacing="4">
                  <Button
                      AutomationProperties.Name="Add Azure Data Explorer cluster"
                      Classes="command"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Left"
                      Command="{Binding OpenAddClusterCommand}"
                      ToolTip.Tip="Add Azure Data Explorer cluster">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <LucideIcon Kind="Plus" Size="16" StrokeWidth="1.8" />
                      <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Add" />
                    </StackPanel>
                  </Button>
                  <Button
                      AutomationProperties.Name="Import connections from Microsoft Kusto Explorer"
                      Classes="command"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Left"
                      IsVisible="{Binding HostCapabilities.SupportsKustoExplorerImport}"
                      Command="{Binding ImportKustoExplorerDataCommand}"
                      ToolTip.Tip="Import all open tabs, connections, and groups without credentials, history, or cached results">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <LucideIcon Kind="Download" Size="16" StrokeWidth="1.8" />
                      <TextBlock VerticalAlignment="Center" Text="Import from Kusto Explorer" />
                    </StackPanel>
                  </Button>
                  <Button
                      x:Name="RecordButton"
                      AutomationProperties.Name="Start recording session"
                      Classes="command"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Left"
                      Click="OnOpenRecordingClick"
                      IsEnabled="{Binding Recording.IsAvailable}"
                      IsVisible="{Binding !Recording.IsRecording}"
                      ToolTip.Tip="Start recording query activity">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <LucideIcon Kind="Circle" Size="16" StrokeWidth="2" />
                      <TextBlock VerticalAlignment="Center" Text="Start recording session" />
                    </StackPanel>
                  </Button>
                  <Button
                      AutomationProperties.Name="Stop recording session"
                      Classes="dangerCommand"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Left"
                      Command="{Binding Recording.StopRecordingCommand}"
                      IsVisible="{Binding Recording.IsRecording}"
                      ToolTip.Tip="{Binding Recording.ActiveSessionName}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <LucideIcon Kind="Square" Size="14" StrokeWidth="2" />
                      <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Stop recording session" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Border>
            </Grid>
          </Border>
        </SplitView.Pane>

        <Grid RowDefinitions="Auto,Auto,Auto,55*,4,45*">
          <Border
              Grid.Row="0"
              Background="{DynamicResource TabBarSurfaceBrush}"
              BorderBrush="{DynamicResource DecorativeDividerBrush}"
              BorderThickness="0,0,0,1">
            <Grid>
              <Button
                  x:Name="NewQueryButton"
              ZIndex="2"
                  Width="28"
                  Height="28"
                  Margin="2"
              HorizontalAlignment="Left"
              VerticalAlignment="Top"
                  AutomationProperties.Name="New query"
                  Classes="toolbar"
                  Command="{Binding NewQueryCommand}"
                  ToolTip.Tip="New query">
                <LucideIcon Kind="Plus" Size="18" StrokeWidth="1.8" />
              </Button>
              <TabStrip
                  x:Name="DocumentTabs"
                  AutomationProperties.HelpText="Press Control Shift Page Up or Page Down to move the selected tab or tab group"
                  AutomationProperties.Name="Query documents"
                  Classes="documentTabs"
                  ContainerPrepared="OnDocumentTabContainerPrepared"
                  ItemsSource="{Binding Documents}"
                  PointerCaptureLost="OnDocumentTabsPointerCaptureLost"
                  PointerMoved="OnDocumentTabsPointerMoved"
                  PointerReleased="OnDocumentTabsPointerReleased"
                  SelectedItem="{Binding SelectedDocument, Mode=TwoWay}">
                <TabStrip.ItemsPanel>
                  <ItemsPanelTemplate>
                    <controls:FirstLineInsetWrapPanel
                      FirstLineInset="32"
                      ItemSpacing="1"
                      LineSpacing="1" />
                  </ItemsPanelTemplate>
                </TabStrip.ItemsPanel>
                  <TabStrip.ItemTemplate>
                    <DataTemplate x:DataType="presentation:KustoDocumentViewModel">
                      <Grid
                          AutomationProperties.Name="{Binding TabAutomationText}"
                          Background="{Binding GroupBackgroundHex}"
                          ColumnDefinitions="3,*,Auto"
                          ColumnSpacing="4"
                          PointerPressed="OnDocumentTabPointerPressed"
                          PointerReleased="OnDocumentTabPointerReleased"
                          ToolTip.Tip="{Binding TargetDisplayText}">
                      <Grid.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="Rename tab..." Command="{Binding RenameCommand}">
                            <MenuItem.Icon>
                              <LucideIcon Kind="Pencil" Size="14" />
                            </MenuItem.Icon>
                          </MenuItem>
                          <MenuItem Header="Tab color">
                            <MenuItem.Icon>
                              <LucideIcon Kind="Palette" Size="14" />
                            </MenuItem.Icon>
                            <MenuItem Header="Default" Command="{Binding SetColorCommand}" CommandParameter="Default">
                              <MenuItem.Icon><Ellipse Width="10" Height="10" Fill="#6B7280" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Red" Command="{Binding SetColorCommand}" CommandParameter="Red">
                              <MenuItem.Icon><Ellipse Width="10" Height="10" Fill="#D64545" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Orange" Command="{Binding SetColorCommand}" CommandParameter="Orange">
                              <MenuItem.Icon><Ellipse Width="10" Height="10" Fill="#C56A16" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Yellow" Command="{Binding SetColorCommand}" CommandParameter="Yellow">
                              <MenuItem.Icon><Ellipse Width="10" Height="10" Fill="#A47700" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Green" Command="{Binding SetColorCommand}" CommandParameter="Green">
                              <MenuItem.Icon><Ellipse Width="10" Height="10" Fill="#27864A" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Teal" Command="{Binding SetColorCommand}" CommandParameter="Teal">
                              <MenuItem.Icon><Ellipse Width="10" Height="10" Fill="#15858A" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Blue" Command="{Binding SetColorCommand}" CommandParameter="Blue">
                              <MenuItem.Icon><Ellipse Width="10" Height="10" Fill="#3675C8" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Purple" Command="{Binding SetColorCommand}" CommandParameter="Purple">
                              <MenuItem.Icon><Ellipse Width="10" Height="10" Fill="#7656B5" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Pink" Command="{Binding SetColorCommand}" CommandParameter="Pink">
                              <MenuItem.Icon><Ellipse Width="10" Height="10" Fill="#B94D7D" /></MenuItem.Icon>
                            </MenuItem>
                          </MenuItem>
                          <MenuItem Header="Assign to group..." Command="{Binding GroupCommand}">
                            <MenuItem.Icon>
                              <LucideIcon Kind="Folder" Size="14" />
                            </MenuItem.Icon>
                          </MenuItem>
                          <MenuItem Header="Run on schedule..." Command="{Binding ScheduleCommand}">
                            <MenuItem.Icon>
                              <LucideIcon Kind="Clock3" Size="14" />
                            </MenuItem.Icon>
                          </MenuItem>
                          <Separator />
                          <MenuItem Header="Close tab" Command="{Binding CloseCommand}">
                            <MenuItem.Icon>
                              <LucideIcon Kind="X" Size="14" />
                            </MenuItem.Icon>
                          </MenuItem>
                        </ContextMenu>
                      </Grid.ContextMenu>
                      <Border
                          Grid.Column="0"
                          Width="3"
                          Height="24"
                          VerticalAlignment="Center"
                          Background="{Binding TabColorHex}"
                          CornerRadius="2" />
                          <Grid Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock
                            FontWeight="SemiBold"
                            Text="{Binding Title}"
                            TextTrimming="CharacterEllipsis" />
                          </Grid>
                      <Button
                          Grid.Column="2"
                          AutomationProperties.Name="Close query document"
                          Classes="treeAction"
                          Command="{Binding CloseCommand}"
                          ToolTip.Tip="Close query">
                        <LucideIcon Kind="X" Size="12" />
                      </Button>
                      <Border
                          Grid.ColumnSpan="3"
                          Height="2"
                          VerticalAlignment="Bottom"
                          Background="{Binding GroupAccentHex}"
                          IsVisible="{Binding HasGroup}" />
                      </Grid>
                    </DataTemplate>
                </TabStrip.ItemTemplate>
              </TabStrip>
            </Grid>
          </Border>

          <Border
              Grid.Row="1"
              Background="{DynamicResource ToolbarSurfaceBrush}"
              BorderBrush="{DynamicResource DecorativeDividerBrush}"
              BorderThickness="0,0,0,1">
            <ScrollViewer
                MinHeight="38"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Disabled">
              <StackPanel Margin="8,0" VerticalAlignment="Center" Orientation="Horizontal" Spacing="6">
              <Border
                  Height="30"
                  MaxWidth="180"
                  Padding="9,0"
                  VerticalAlignment="Center"
                  Background="{DynamicResource SubtleSurfaceBrush}"
                  BorderBrush="{DynamicResource DecorativeDividerBrush}"
                  BorderThickness="1"
                  CornerRadius="4"
                  ToolTip.Tip="{Binding ActiveTargetToolTip}">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="7">
                  <LucideIcon
                      VerticalAlignment="Center"
                      Kind="Database"
                      Size="14"
                      Foreground="{DynamicResource AccentBrush}" />
                  <TextBlock
                      MaxWidth="140"
                      VerticalAlignment="Center"
                      FontSize="{DynamicResource TypeCompactSize}"
                      FontWeight="SemiBold"
                      Text="{Binding ActiveTargetDisplayName}"
                      TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Border>
              <Button
                  AutomationProperties.Name="Run query"
                  Classes="primaryCommand"
                  Command="{Binding RunQueryCommand}"
                  Height="30"
                  IsVisible="{Binding !IsRunningQuery}"
                  ToolTip.Tip="Run query at caret (F5 or Shift+Enter)">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <LucideIcon Kind="Play" Size="14" StrokeWidth="2" />
                  <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Run" />
                </StackPanel>
              </Button>
              <Button
                  AutomationProperties.Name="Cancel query"
                  Classes="command"
                  Command="{Binding CancelQueryCommand}"
                  Height="30"
                  IsVisible="{Binding IsRunningQuery}"
                  ToolTip.Tip="Cancel query">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <LucideIcon Kind="Square" Size="13" StrokeWidth="2" />
                  <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Cancel" />
                </StackPanel>
              </Button>
              <Border Width="1" Height="20" Margin="2,0" Background="{DynamicResource DecorativeDividerBrush}" />
              <Button
                  AutomationProperties.Name="Choose visualization"
                  Classes="command"
                  Height="30"
                  ToolTip.Tip="Visualize current results">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <LucideIcon Kind="ChartNoAxesCombined" Size="15" />
                  <TextBlock VerticalAlignment="Center" Text="Visualize" />
                  <LucideIcon VerticalAlignment="Center" Kind="ChevronDown" Size="12" />
                </StackPanel>
                <Button.Flyout>
                  <Flyout Placement="BottomEdgeAlignedLeft">
                    <Grid Width="360" Margin="4" ColumnDefinitions="*,*" ColumnSpacing="6">
                      <StackPanel Grid.Column="0" Spacing="2">
                        <Button Classes="command" HorizontalContentAlignment="Left" Command="{Binding RenderVisualizationCommand}" CommandParameter="TimeChart" Content="Time chart" />
                        <Button Classes="command" HorizontalContentAlignment="Left" Command="{Binding RenderVisualizationCommand}" CommandParameter="AnomalyChart" Content="Anomaly chart" />
                        <Button Classes="command" HorizontalContentAlignment="Left" Command="{Binding RenderVisualizationCommand}" CommandParameter="LineChart" Content="Line chart" />
                        <Button Classes="command" HorizontalContentAlignment="Left" Command="{Binding RenderVisualizationCommand}" CommandParameter="AreaChart" Content="Area chart" />
                        <Button Classes="command" HorizontalContentAlignment="Left" Command="{Binding RenderVisualizationCommand}" CommandParameter="StackedAreaChart" Content="Stacked area chart" />
                        <Button Classes="command" HorizontalContentAlignment="Left" Command="{Binding RenderVisualizationCommand}" CommandParameter="ScatterChart" Content="Scatter chart" />
                        <Button Classes="command" HorizontalContentAlignment="Left" Command="{Binding RenderVisualizationCommand}" CommandParameter="TimePivot" Content="Time pivot" />
                        <Button Classes="command" HorizontalContentAlignment="Left" Command="{Binding RenderVisualizationCommand}" CommandParameter="Table" Content="Table" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="2">
                        <Button Classes="command" HorizontalContentAlignment="Left" Command="{Binding RenderVisualizationCommand}" CommandParameter="ColumnChart" Content="Column chart" />
                        <Button Classes="command" HorizontalContentAlignment="Left" Command="{Binding RenderVisualizationCommand}" CommandParameter="BarChart" Content="Bar chart" />
                        <Button Classes="command" HorizontalContentAlignment="Left" Command="{Binding RenderVisualizationCommand}" CommandParameter="PieChart" Content="Pie chart" />
                        <Button Classes="command" HorizontalContentAlignment="Left" Command="{Binding RenderVisualizationCommand}" CommandParameter="TreeMap" Content="Treemap" />
                        <Button Classes="command" HorizontalContentAlignment="Left" Command="{Binding RenderVisualizationCommand}" CommandParameter="Card" Content="Card" />
                        <Button Classes="command" HorizontalContentAlignment="Left" Command="{Binding RenderVisualizationCommand}" CommandParameter="LadderChart" Content="Ladder chart" />
                        <Button Classes="command" HorizontalContentAlignment="Left" Command="{Binding RenderVisualizationCommand}" CommandParameter="PivotChart" Content="Pivot chart" />
                        <Button Classes="command" HorizontalContentAlignment="Left" Command="{Binding RenderVisualizationCommand}" CommandParameter="Graph" Content="Graph" />
                      </StackPanel>
                    </Grid>
                  </Flyout>
                </Button.Flyout>
              </Button>
              <Button
                  AutomationProperties.Name="Pin query to dashboard"
                  Classes="command"
                  Command="{Binding OpenPinToDashboardCommand}"
                  Height="30"
                  ToolTip.Tip="Pin the query at the caret to a dashboard">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <LucideIcon Kind="Pin" Size="15" />
                  <TextBlock VerticalAlignment="Center" Text="Pin" />
                </StackPanel>
              </Button>
              <Button
                  AutomationProperties.Name="Schedule query"
                  Classes="command"
                  Command="{Binding OpenScheduleAutomationCommand}"
                  Height="30"
                  ToolTip.Tip="Run the query at the caret on a schedule">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <LucideIcon Kind="Clock3" Size="15" />
                  <TextBlock VerticalAlignment="Center" Text="Schedule" />
                </StackPanel>
              </Button>
              <Button
                  AutomationProperties.Name="Export data"
                  Classes="command"
                  Height="30"
                  ToolTip.Tip="Export current results">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <LucideIcon Kind="Download" Size="15" />
                  <TextBlock VerticalAlignment="Center" Text="Data export" />
                  <LucideIcon VerticalAlignment="Center" Kind="ChevronDown" Size="12" />
                </StackPanel>
                <Button.Flyout>
                  <Flyout Placement="BottomEdgeAlignedLeft">
                    <StackPanel Width="210" Spacing="2">
                      <Button Classes="command" HorizontalContentAlignment="Left" Click="OnExportCsvClick" Content="CSV" />
                      <Button Classes="command" HorizontalContentAlignment="Left" Click="OnExportExcelClick" Content="Excel workbook" />
                      <Button Classes="command" HorizontalContentAlignment="Left" Click="OnExportJsonClick" Content="JSON" />
                      <Button Classes="command" HorizontalContentAlignment="Left" Click="OnCopyResultsClick" Content="Copy to clipboard" />
                    </StackPanel>
                  </Flyout>
                </Button.Flyout>
              </Button>
              <Button
                  AutomationProperties.Name="Result formatting"
                  Classes="command"
                  Height="30"
                  ToolTip.Tip="Customize result table formatting">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <LucideIcon Kind="Paintbrush" Size="15" />
                  <TextBlock VerticalAlignment="Center" Text="Formatting" />
                  <LucideIcon VerticalAlignment="Center" Kind="ChevronDown" Size="12" />
                </StackPanel>
                <Button.Flyout>
                  <Flyout Placement="BottomEdgeAlignedLeft">
                    <StackPanel Width="240" Spacing="8">
                      <CheckBox
                          AutomationProperties.Name="Shade alternating result rows"
                          Content="Shade alternating rows"
                          IsChecked="{Binding SelectedDocument.UseAlternatingRows}" />
                      <Button
                          Classes="command"
                          HorizontalContentAlignment="Left"
                          Command="{Binding OpenConditionalFormattingCommand}"
                          Content="Conditional formatting..." />
                    </StackPanel>
                  </Flyout>
                </Button.Flyout>
              </Button>
              </StackPanel>
            </ScrollViewer>
          </Border>

          <Border
              Grid.Row="2"
              Margin="8,6"
              Padding="10,7"
              AutomationProperties.Name="Application data save warning"
              Background="{DynamicResource SubtleSurfaceBrush}"
              BorderBrush="{DynamicResource ErrorBrush}"
              BorderThickness="1"
              CornerRadius="4"
              IsVisible="{Binding HasPersistenceError}">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
              <LucideIcon VerticalAlignment="Center" Kind="TriangleAlert" Size="15" Foreground="{DynamicResource ErrorBrush}" />
              <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding PersistenceErrorText}" TextWrapping="Wrap" />
              <Button
                  Grid.Column="2"
                  AutomationProperties.Name="Retry saving application data"
                  Classes="command"
                  Command="{Binding RetryPersistenceCommand}"
                  Content="Retry" />
            </Grid>
          </Border>

          <Border
              Grid.Row="3"
              Classes="editorFrame"
              Background="{DynamicResource SurfaceBrush}">
            <editor:AccessibleKustoTextEditor
                x:Name="QueryEditor"
                AutomationProperties.HelpText="Edit the active Kusto query"
                AutomationProperties.Name="KQL query editor"
                Padding="10,12"
                Background="{DynamicResource SurfaceBrush}"
                Foreground="{DynamicResource TextPrimaryBrush}"
                FontFamily="Cascadia Code, JetBrains Mono, Noto Sans Mono, monospace"
                FontSize="{DynamicResource QueryEditorTextSize}"
                ShowLineNumbers="True"
                Theme="{StaticResource {x:Type avaloniaEdit:TextEditor}}"
                WordWrap="False">
              <editor:AccessibleKustoTextEditor.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Copy" Click="OnCopyQueryEditorClick">
                    <MenuItem.Icon>
                      <LucideIcon Kind="Copy" Size="14" />
                    </MenuItem.Icon>
                  </MenuItem>
                  <Separator />
                  <MenuItem Header="Run on schedule..." Command="{Binding OpenScheduleAutomationCommand}">
                    <MenuItem.Icon>
                      <LucideIcon Kind="Clock3" Size="14" />
                    </MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Header="Pin to dashboard..." Command="{Binding OpenPinToDashboardCommand}">
                    <MenuItem.Icon>
                      <LucideIcon Kind="Pin" Size="14" />
                    </MenuItem.Icon>
                  </MenuItem>
                </ContextMenu>
              </editor:AccessibleKustoTextEditor.ContextMenu>
            </editor:AccessibleKustoTextEditor>
          </Border>

          <GridSplitter
              Grid.Row="4"
              Background="{DynamicResource DecorativeDividerBrush}"
              ResizeDirection="Rows" />

          <Border
              Grid.Row="5"
              Classes="toolPane"
              BorderThickness="0,1,0,0">
            <TabControl
                x:Name="ResultTabs"
                AutomationProperties.Name="Query output"
              FontSize="{DynamicResource TypeCompactSize}"
              SelectedIndex="{Binding SelectedOutputTabIndex, Mode=TwoWay}">
              <TabItem AutomationProperties.Name="Results" Classes="toolTab">
                <TabItem.Header>
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <LucideIcon Kind="Table2" Size="14" />
                    <TextBlock Text="Results" />
                  </StackPanel>
                </TabItem.Header>
                    <Grid>
                  <StackPanel
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      IsVisible="{Binding ShowResultEmptyState}"
                      Spacing="5">
                    <LucideIcon
                        HorizontalAlignment="Center"
                        Kind="Table2"
                        Size="22"
                        Foreground="{DynamicResource TextTertiaryBrush}" />
                    <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="No results yet" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Classes="muted"
                        FontSize="{DynamicResource TypeCompactSize}"
                        Text="Results appear here after query execution" />
                  </StackPanel>

                  <StackPanel
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      IsVisible="{Binding IsRunningQuery}"
                      Spacing="10">
                    <ProgressBar Width="180" Height="4" IsIndeterminate="True" />
                    <TextBlock FontWeight="SemiBold" Text="Authenticating and running query" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Classes="muted"
                        FontSize="{DynamicResource TypeCompactSize}"
                        Text="Complete sign-in in your browser if prompted" />
                  </StackPanel>

                  <Border
                      MaxWidth="680"
                      Margin="20"
                      Padding="14,12"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Background="{DynamicResource SubtleSurfaceBrush}"
                      BorderBrush="{DynamicResource ErrorBrush}"
                      BorderThickness="1"
                      CornerRadius="5"
                      IsVisible="{Binding HasQueryError}">
                    <Border.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="Copy error" Click="OnCopyQueryErrorClick" />
                      </ContextMenu>
                    </Border.ContextMenu>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                      <LucideIcon
                          Grid.Column="0"
                          Kind="CircleAlert"
                          Size="18"
                          Foreground="{DynamicResource ErrorBrush}" />
                      <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock FontWeight="SemiBold" Text="Query failed" />
                        <TextBlock
                            Classes="sectionLabel"
                            Foreground="{DynamicResource ErrorBrush}"
                            IsVisible="{Binding HasQueryErrorHighlight}"
                            Text="{Binding QueryErrorLocationText}" />
                        <TextBlock
                            Classes="muted"
                            FontSize="{DynamicResource TypeCompactSize}"
                            Text="{Binding QueryErrorText}"
                            TextWrapping="Wrap" />
                        <Button
                          x:Name="FixQueryWithCopilotButton"
                            Margin="0,5,0,0"
                            HorizontalAlignment="Left"
                            AutomationProperties.Name="Fix failed query with Copilot"
                            Classes="primaryCommand"
                            Command="{Binding FixQueryWithCopilotCommand}"
                            ToolTip.Tip="Open Copilot and request a validated query repair">
                          <StackPanel Orientation="Horizontal" Spacing="7">
                            <LucideIcon Kind="Sparkles" Size="14" />
                            <TextBlock VerticalAlignment="Center" Text="Fix with Copilot" />
                          </StackPanel>
                        </Button>
                      </StackPanel>
                    </Grid>
                  </Border>

                    <Grid
                      x:Name="ResultView"
                      IsVisible="{Binding HasResultTable}"
                      RowDefinitions="42,*,Auto">
                    <Grid
                        Grid.Row="0"
                        Margin="12,5"
                        ColumnDefinitions="*,220,Auto,Auto"
                        ColumnSpacing="8">
                      <TextBlock
                          Grid.Column="0"
                          VerticalAlignment="Center"
                          Classes="muted"
                          FontSize="{DynamicResource TypeCompactSize}"
                          Text="{Binding ResultSummary}"
                          TextTrimming="CharacterEllipsis" />
                      <Grid Grid.Column="1">
                        <TextBox
                          x:Name="ResultSearchBox"
                            AutomationProperties.Name="Search result rows"
                            Height="30"
                            Padding="28,0,8,0"
                          KeyDown="OnResultSearchKeyDown"
                          LostFocus="OnResultSearchLostFocus"
                            PlaceholderText="Search rows"
                          Text="{Binding ResultSearchText, Mode=OneWay}"
                          TextChanged="OnResultSearchTextChanged"
                            VerticalContentAlignment="Center" />
                        <LucideIcon
                            Margin="8,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False"
                            Kind="Search"
                            Size="13"
                            Foreground="{DynamicResource TextTertiaryBrush}" />
                      </Grid>
                      <TextBlock
                          Grid.Column="2"
                          VerticalAlignment="Center"
                          Classes="tertiary"
                          FontSize="{DynamicResource TypeSmallSize}"
                          Text="{Binding ResultViewSummary}" />
                      <Button
                          Grid.Column="3"
                          AutomationProperties.Name="Clear result filters"
                          Classes="treeAction"
                          Command="{Binding ClearResultFiltersCommand}"
                          IsVisible="{Binding HasResultFilters}"
                          ToolTip.Tip="Clear row search and column filters">
                        <LucideIcon Kind="X" Size="13" />
                      </Button>
                    </Grid>
                      <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                      <ScrollViewer
                          x:Name="ResultScrollViewer"
                        Grid.Column="0"
                          HorizontalContentAlignment="Stretch"
                          HorizontalScrollBarVisibility="Hidden"
                          ScrollChanged="OnResultScrollChanged"
                          VerticalScrollBarVisibility="Disabled">
                        <Grid
                          AutomationProperties.AccessibilityView="Control"
                          AutomationProperties.ControlTypeOverride="DataGrid"
                          AutomationProperties.Name="Query result data grid"
                            MinWidth="{Binding ResultTableMinimumWidth}"
                            HorizontalAlignment="Stretch"
                            RowDefinitions="Auto,*">
                        <ItemsControl
                          Grid.Row="0"
                          AutomationProperties.ControlTypeOverride="Header"
                          AutomationProperties.Name="Query result columns"
                          ItemsSource="{Binding ResultColumns}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <controls:KustoResultRowPanel />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="presentation:KustoResultColumnViewModel">
                              <Border
                                  MinWidth="{Binding DisplayWidth}"
                                  Padding="3"
                                  HorizontalAlignment="Stretch"
                                  Background="{DynamicResource SubtleSurfaceBrush}"
                                  BorderBrush="{DynamicResource DecorativeDividerBrush}"
                                  BorderThickness="0,1,1,1">
                                <Grid ColumnDefinitions="*,26" ColumnSpacing="2">
                                  <Button
                                      Grid.Column="0"
                                      Padding="5,1"
                                      HorizontalContentAlignment="Stretch"
                                      AutomationProperties.Name="{Binding SortAutomationName}"
                                      AutomationProperties.ControlTypeOverride="HeaderItem"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Click="OnResultColumnHeaderClick"
                                      CornerRadius="3"
                                      ToolTip.Tip="{Binding SortAutomationName}">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="3">
                                      <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="0">
                                        <TextBlock
                                          FontSize="{DynamicResource ResultHeaderTextSize}"
                                            FontWeight="SemiBold"
                                            Text="{Binding Name}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Classes="tertiary"
                                            FontFamily="Cascadia Code, JetBrains Mono, Noto Sans Mono, monospace"
                                          FontSize="{DynamicResource ResultMetadataTextSize}"
                                            Text="{Binding TypeName}"
                                            TextTrimming="CharacterEllipsis" />
                                      </StackPanel>
                                      <LucideIcon
                                          Grid.Column="1"
                                          VerticalAlignment="Center"
                                          IsVisible="{Binding !IsSortActive}"
                                          Kind="ArrowUpDown"
                                          Size="11"
                                          Foreground="{DynamicResource TextTertiaryBrush}" />
                                      <LucideIcon
                                          Grid.Column="1"
                                          VerticalAlignment="Center"
                                          IsVisible="{Binding IsSortAscending}"
                                          Kind="ArrowUp"
                                          Size="12"
                                          Foreground="{DynamicResource AccentBrush}" />
                                      <LucideIcon
                                          Grid.Column="1"
                                          VerticalAlignment="Center"
                                          IsVisible="{Binding IsSortDescending}"
                                          Kind="ArrowDown"
                                          Size="12"
                                          Foreground="{DynamicResource AccentBrush}" />
                                    </Grid>
                                  </Button>
                                  <Button
                                      Grid.Column="1"
                                      AutomationProperties.Name="{Binding FilterAutomationName}"
                                      Classes="treeAction"
                                      ToolTip.Tip="{Binding FilterToolTip}">
                                    <Grid>
                                      <LucideIcon
                                          IsVisible="{Binding !IsFilterActive}"
                                          Kind="ListFilter"
                                          Size="13" />
                                      <LucideIcon
                                          IsVisible="{Binding IsFilterActive}"
                                          Kind="ListFilter"
                                          Size="13"
                                          Foreground="{DynamicResource AccentBrush}" />
                                    </Grid>
                                    <Button.Flyout>
                                      <Flyout Placement="BottomEdgeAlignedLeft">
                                        <StackPanel Width="260" Margin="4" Spacing="8">
                                          <TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                          <ComboBox
                                              AutomationProperties.Name="Filter operation"
                                              ItemsSource="{Binding FilterOptions}"
                                              SelectedItem="{Binding SelectedFilterOption, Mode=TwoWay}">
                                            <ComboBox.ItemTemplate>
                                              <DataTemplate x:DataType="presentation:KustoResultFilterOption">
                                                <TextBlock Text="{Binding DisplayName}" />
                                              </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                          </ComboBox>
                                          <TextBox
                                              AutomationProperties.Name="Filter value"
                                              IsVisible="{Binding IsFilterValueRequired}"
                                              KeyDown="OnResultColumnFilterKeyDown"
                                              LostFocus="OnResultColumnFilterLostFocus"
                                              PlaceholderText="Value"
                                              Text="{Binding FilterText, Mode=OneWay}"
                                              TextChanged="OnResultColumnFilterTextChanged" />
                                          <TextBlock
                                              Classes="tertiary"
                                              FontSize="{DynamicResource TypeSmallSize}"
                                              IsVisible="{Binding IsFilterActive}"
                                              Text="{Binding FilterSummary}"
                                              TextTrimming="CharacterEllipsis" />
                                          <Button
                                              Classes="command"
                                              Click="OnClearResultColumnFilterClick"
                                              Content="Clear filter"
                                              HorizontalContentAlignment="Left"
                                              IsEnabled="{Binding IsFilterActive}" />
                                        </StackPanel>
                                      </Flyout>
                                    </Button.Flyout>
                                  </Button>
                                </Grid>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ListBox
                          x:Name="ResultsList"
                            Grid.Row="1"
                            AutomationProperties.ControlTypeOverride="DataGrid"
                            AutomationProperties.Name="Query result rows"
                            Background="Transparent"
                            BorderThickness="0"
                            ContainerPrepared="OnResultRowContainerPrepared"
                            ItemsSource="{Binding ResultRows}"
                            KeyDown="OnResultsListKeyDown"
                            SelectionMode="Multiple"
                            ScrollViewer.VerticalScrollBarVisibility="Hidden"
                            TemplateApplied="OnResultsListTemplateApplied">
                          <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                          </ListBox.Styles>
                          <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="presentation:KustoResultRowViewModel">
                              <Border Background="{Binding BackgroundHex}">
                                <ItemsControl ItemsSource="{Binding Cells}">
                                <ItemsControl.ItemsPanel>
                                  <ItemsPanelTemplate>
                                    <controls:KustoResultRowPanel />
                                  </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate x:DataType="presentation:KustoResultCellViewModel">
                                    <Border
                                        MinWidth="{Binding DisplayWidth}"
                                        MinHeight="30"
                                        HorizontalAlignment="Stretch"
                                      AutomationProperties.Name="{Binding AutomationText}"
                                        Background="{Binding BackgroundHex}"
                                        BorderBrush="{DynamicResource DecorativeDividerBrush}"
                                        BorderThickness="0,0,1,1"
                                        PointerPressed="OnResultCellPointerPressed">
                                      <Border.ContextMenu>
                                        <ContextMenu>
                                          <MenuItem Header="Copy selected values" Click="OnCopyResultValueClick" />
                                          <MenuItem Header="Copy row" Click="OnCopyResultRowClick" />
                                          <Separator />
                                          <MenuItem Header="Filter query by this value" Click="OnAddCellFilterClick" />
                                          <MenuItem Header="Filter query by this row" Click="OnAddRowFilterClick" />
                                          <Separator />
                                          <MenuItem Header="Mark value as interesting" Click="OnMarkRecordedCellClick" />
                                          <MenuItem Header="Mark all values in this column as interesting" Click="OnMarkRecordedColumnClick" />
                                          <MenuItem Header="Remove value mark" Click="OnUnmarkRecordedCellClick" />
                                          <Separator />
                                          <MenuItem Header="Copy selected rows as KQL datatable" Click="OnCopyDatatableClick" />
                                          <MenuItem Header="Copy all rows as KQL datatable" Click="OnCopyAllDatatableClick" />
                                          <MenuItem Header="Conditional formatting..." Click="OnConditionalFormattingClick" />
                                        </ContextMenu>
                                      </Border.ContextMenu>
                                        <Grid>
                                          <Border Background="{Binding RecordingHighlightHex}" IsVisible="{Binding HasRecordingAnnotation}" />
                                          <Grid Margin="10,5" ColumnDefinitions="*,Auto" ColumnSpacing="5">
                                            <TextBlock
                                              VerticalAlignment="Center"
                                              AutomationProperties.Name="{Binding AutomationText}"
                                              AutomationProperties.HelpText="{Binding RecordingAnnotationText}"
                                              FontFamily="Cascadia Code, JetBrains Mono, Noto Sans Mono, monospace"
                                              FontSize="{DynamicResource ResultCellTextSize}"
                                              Text="{Binding Text}"
                                              TextTrimming="CharacterEllipsis"
                                              ToolTip.Tip="{Binding Text}" />
                                            <LucideIcon
                                              Grid.Column="1"
                                              VerticalAlignment="Center"
                                              Kind="Bookmark"
                                              Size="11"
                                              Foreground="{Binding RecordingAccentHex}"
                                              IsVisible="{Binding HasRecordingAnnotation}"
                                              ToolTip.Tip="{Binding RecordingAnnotationText}" />
                                          </Grid>
                                        </Grid>
                                    </Border>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                                </ItemsControl>
                              </Border>
                            </DataTemplate>
                          </ListBox.ItemTemplate>
                        </ListBox>
                        </Grid>
                      </ScrollViewer>
                      <Border
                          x:Name="ResultHorizontalOverflowHint"
                          Grid.Column="0"
                          Width="22"
                          HorizontalAlignment="Right"
                          Background="{DynamicResource RaisedSurfaceBrush}"
                          BorderBrush="{DynamicResource DecorativeDividerBrush}"
                          BorderThickness="1,0,0,0"
                          IsHitTestVisible="False"
                          IsVisible="False"
                          Opacity="0.92"
                          ToolTip.Tip="More columns to the right">
                        <LucideIcon
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Kind="ChevronRight"
                            Size="14"
                            Foreground="{DynamicResource TextSecondaryBrush}" />
                      </Border>
                      <ScrollBar
                          x:Name="ResultVerticalScrollBar"
                          Grid.Column="1"
                          AutomationProperties.Name="Scroll result rows"
                          IsEnabled="False"
                          Maximum="0"
                          Minimum="0"
                          Orientation="Vertical"
                          Scroll="OnResultVerticalScroll"
                          ViewportSize="0" />
                    </Grid>
                      <ScrollBar
                          x:Name="ResultHorizontalScrollBar"
                          Grid.Row="2"
                          AutomationProperties.Name="Scroll result columns"
                          IsEnabled="False"
                          Maximum="0"
                          Minimum="0"
                          Orientation="Horizontal"
                          Scroll="OnResultHorizontalScroll"
                          ViewportSize="0" />
                  </Grid>
                </Grid>
              </TabItem>
              <TabItem AutomationProperties.Name="Visualization" Classes="toolTab">
                <TabItem.Header>
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <LucideIcon Kind="ChartNoAxesCombined" Size="14" />
                    <TextBlock Text="Visualization" />
                  </StackPanel>
                </TabItem.Header>
                <Grid RowDefinitions="Auto,*">
                  <ScrollViewer
                      Grid.Row="0"
                      MinHeight="38"
                      Margin="10,5,10,2"
                      HorizontalScrollBarVisibility="Auto"
                      IsVisible="{Binding ShowVisualizationChoices}"
                      VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding VisualizationChoices}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="5" /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="presentation:KustoVisualizationChoiceViewModel">
                          <Button MinWidth="72" Classes="command" Command="{Binding SelectCommand}" Content="{Binding Label}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                  <StackPanel
                      Grid.Row="1"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      IsVisible="{Binding ShowVisualizationEmptyState}"
                      Spacing="6">
                    <LucideIcon
                        HorizontalAlignment="Center"
                        Kind="ChartNoAxesCombined"
                        Size="22"
                        Foreground="{DynamicResource TextTertiaryBrush}" />
                    <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="{Binding VisualizationEmptyTitle}" />
                    <TextBlock
                        MaxWidth="520"
                        HorizontalAlignment="Center"
                        Classes="muted"
                        FontSize="{DynamicResource TypeCompactSize}"
                        Text="{Binding VisualizationEmptyMessage}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                  </StackPanel>

                  <Grid
                      x:Name="VisualizationSurface"
                      Grid.Row="1"
                      Margin="14,8,14,10"
                      Background="Transparent"
                      IsVisible="{Binding HasVisualization}"
                      RowDefinitions="26,*">
                    <Grid.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="Save chart as PNG..." Click="OnSaveChartClick" />
                      </ContextMenu>
                    </Grid.ContextMenu>
                    <TextBlock
                        Grid.Row="0"
                        FontSize="{DynamicResource TypeCompactSize}"
                        FontWeight="SemiBold"
                        Text="{Binding Visualization.Title}"
                        TextTrimming="CharacterEllipsis" />

                    <ScrollViewer
                        Grid.Row="1"
                        HorizontalScrollBarVisibility="Auto"
                        IsVisible="{Binding Visualization.IsCard}"
                        VerticalScrollBarVisibility="Auto">
                      <ItemsControl ItemsSource="{Binding Visualization.Cards}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="presentation:KustoChartCardViewModel">
                            <Border
                                MinWidth="150"
                                Margin="0,0,10,10"
                                Padding="12,10"
                                Background="{DynamicResource SubtleSurfaceBrush}"
                                BorderBrush="{DynamicResource DecorativeDividerBrush}"
                                BorderThickness="1"
                                CornerRadius="5">
                              <StackPanel Spacing="3">
                                <TextBlock Classes="tertiary" FontSize="{DynamicResource TypeMetadataSize}" Text="{Binding Label}" />
                                <TextBlock FontSize="{DynamicResource TypeMetricSize}" FontWeight="SemiBold" Text="{Binding Value}" />
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>

                    <Grid
                        Grid.Row="1"
                        ColumnDefinitions="*,Auto"
                        IsVisible="{Binding Visualization.IsPlot}"
                        RowDefinitions="*,34">
                      <Grid Grid.Row="0" Grid.Column="0" ColumnDefinitions="70,*" ColumnSpacing="8">
                        <Grid Grid.Column="0" ColumnDefinitions="16,*" ColumnSpacing="3">
                          <TextBlock
                              Grid.Column="0"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Classes="tertiary"
                              FontSize="{DynamicResource TypeMetadataSize}"
                              RenderTransformOrigin="50%,50%"
                              Text="{Binding Visualization.VerticalAxisTitle}">
                            <TextBlock.RenderTransform>
                              <RotateTransform Angle="-90" />
                            </TextBlock.RenderTransform>
                          </TextBlock>
                          <ItemsControl Grid.Column="1" ItemsSource="{Binding Visualization.VerticalAxisTicks}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <UniformGrid Columns="1" />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="presentation:KustoChartAxisTickViewModel">
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Classes="tertiary"
                                    FontSize="{DynamicResource TypeMetadataSize}"
                                    Text="{Binding Label}" />
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </Grid>
                        <Border
                            Grid.Column="1"
                            Background="{DynamicResource SubtleSurfaceBrush}"
                            BorderBrush="{DynamicResource DecorativeDividerBrush}"
                            BorderThickness="1">
                          <charts:KustoChart
                              AutomationProperties.Name="Rendered Kusto visualization"
                              Revision="{Binding Visualization.Revision}"
                              Visualization="{Binding Visualization}" />
                        </Border>
                      </Grid>

                      <Grid Grid.Row="1" Grid.Column="0" Margin="78,2,0,0" RowDefinitions="*,Auto">
                        <ItemsControl Grid.Row="0" ItemsSource="{Binding Visualization.HorizontalAxisTicks}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="presentation:KustoChartAxisTickViewModel">
                              <TextBlock
                                  HorizontalAlignment="Center"
                                  Classes="tertiary"
                                  FontSize="{DynamicResource TypeMetadataSize}"
                                  Text="{Binding Label}"
                                  TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock
                            Grid.Row="1"
                            HorizontalAlignment="Center"
                            Classes="tertiary"
                            FontSize="{DynamicResource TypeMetadataSize}"
                            Text="{Binding Visualization.HorizontalAxisTitle}" />
                      </Grid>

                      <Border
                          Grid.Row="0"
                          Grid.RowSpan="2"
                          Grid.Column="1"
                          Width="200"
                          Margin="12,0,0,0"
                          Padding="10,0,0,0"
                          BorderBrush="{DynamicResource DecorativeDividerBrush}"
                          BorderThickness="1,0,0,0"
                          IsVisible="{Binding Visualization.LegendVisible}">
                        <Grid RowDefinitions="Auto,*" RowSpacing="8">
                          <Button
                              Grid.Row="0"
                              HorizontalContentAlignment="Left"
                              AutomationProperties.Name="{Binding Visualization.AllSeriesVisibilityActionText}"
                              Classes="command"
                              Command="{Binding Visualization.ToggleAllSeriesVisibilityCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                              <Grid Width="14" Height="14">
                                <LucideIcon IsVisible="{Binding Visualization.AreAllSeriesVisible}" Kind="EyeOff" Size="14" />
                                <LucideIcon IsVisible="{Binding !Visualization.AreAllSeriesVisible}" Kind="Eye" Size="14" />
                              </Grid>
                              <TextBlock Text="{Binding Visualization.AllSeriesVisibilityActionText}" />
                            </StackPanel>
                          </Button>
                          <ScrollViewer
                              Grid.Row="1"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Visualization.Series}">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                  <StackPanel Orientation="Vertical" />
                                </ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="presentation:KustoChartSeriesViewModel">
                                  <Button
                                      Margin="0,0,0,3"
                                      AutomationProperties.Name="{Binding VisibilityActionText}"
                                      Classes="chartLegendItem"
                                      Command="{Binding ToggleVisibilityCommand}"
                                      Opacity="{Binding LegendOpacity}"
                                      ToolTip.Tip="{Binding VisibilityActionText}">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                      <Ellipse
                                          Width="9"
                                          Height="9"
                                          VerticalAlignment="Center"
                                          Fill="{Binding ColorHex}" />
                                      <TextBlock
                                          MaxWidth="154"
                                          VerticalAlignment="Center"
                                          FontSize="{DynamicResource TypeSmallSize}"
                                          Text="{Binding Name}"
                                          TextTrimming="CharacterEllipsis"
                                          ToolTip.Tip="{Binding Name}" />
                                    </StackPanel>
                                  </Button>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </ScrollViewer>
                        </Grid>
                      </Border>
                    </Grid>
                  </Grid>
                </Grid>
              </TabItem>
              <TabItem AutomationProperties.Name="Query info" Classes="toolTab" Header="Query info">
                <ScrollViewer>
                  <Grid Margin="16,12" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="18" RowSpacing="8">
                    <TextBlock Grid.Row="0" Grid.Column="0" Classes="sectionLabel" Text="STATUS" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding QueryInfo.StatusText}" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Classes="sectionLabel" Text="TARGET" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding QueryInfo.TargetText}" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Classes="sectionLabel" Text="STARTED" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding QueryInfo.StartedText}" />
                    <TextBlock Grid.Row="3" Grid.Column="0" Classes="sectionLabel" Text="COMPLETED" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding QueryInfo.CompletedText}" />
                    <TextBlock Grid.Row="4" Grid.Column="0" Classes="sectionLabel" Text="DURATION" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding QueryInfo.DurationText}" />
                    <TextBlock Grid.Row="5" Grid.Column="0" Classes="sectionLabel" Text="RESULT" />
                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding QueryInfo.ResultShapeText}" />
                    <TextBlock Grid.Row="6" Grid.Column="0" Classes="sectionLabel" Text="VISUALIZATION" />
                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding QueryInfo.VisualizationText}" />
                    <Border Grid.Row="7" Grid.ColumnSpan="2" Margin="0,6,0,0" Padding="10" Background="{DynamicResource SubtleSurfaceBrush}" BorderBrush="{DynamicResource DecorativeDividerBrush}" BorderThickness="1" CornerRadius="5">
                      <TextBlock FontFamily="Cascadia Code, JetBrains Mono, Noto Sans Mono, monospace" FontSize="{DynamicResource TypeSmallSize}" Text="{Binding QueryInfo.ExecutedQueryText}" TextWrapping="Wrap" />
                    </Border>
                  </Grid>
                </ScrollViewer>
              </TabItem>
              <TabItem
                  AutomationProperties.Name="Full result value"
                  Classes="toolTab"
                  IsVisible="{Binding HasInspectedResultValue}">
                <TabItem.Header>
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <LucideIcon Kind="FileText" Size="14" />
                    <TextBlock Text="Value" />
                  </StackPanel>
                </TabItem.Header>
                <Grid RowDefinitions="42,*">
                  <Border
                      Grid.Row="0"
                      Padding="12,0,6,0"
                      Background="{DynamicResource RaisedSurfaceBrush}"
                      BorderBrush="{DynamicResource DecorativeDividerBrush}"
                      BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel VerticalAlignment="Center" Spacing="1">
                        <TextBlock
                            FontWeight="SemiBold"
                            Text="{Binding InspectedResultTitle}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Classes="tertiary"
                            FontSize="{DynamicResource TypeMetadataSize}"
                            Text="{Binding InspectedResultMetadata}" />
                      </StackPanel>
                      <Button
                          Grid.Column="1"
                          AutomationProperties.Name="Close full result value"
                          Classes="treeAction"
                          Command="{Binding CloseResultValueCommand}"
                          ToolTip.Tip="Close value">
                        <LucideIcon Kind="X" Size="14" />
                      </Button>
                    </Grid>
                  </Border>
                  <TextBox
                      Grid.Row="1"
                      AcceptsReturn="True"
                      AutomationProperties.Name="Full result value text"
                      Background="{DynamicResource SubtleSurfaceBrush}"
                      BorderThickness="0"
                      FontFamily="Cascadia Code, JetBrains Mono, Noto Sans Mono, monospace"
                      FontSize="{DynamicResource TypeCompactSize}"
                      IsReadOnly="True"
                      Padding="12,10"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      Text="{Binding InspectedResultText, Mode=OneWay}"
                      TextWrapping="NoWrap" />
                </Grid>
              </TabItem>
            </TabControl>
          </Border>
        </Grid>
      </SplitView>

      <Grid
          Grid.Column="1"
          IsVisible="{Binding IsDashboardView}"
          RowDefinitions="58,*">
        <Border
            Grid.Row="0"
            Background="{DynamicResource RaisedSurfaceBrush}"
            BorderBrush="{DynamicResource DecorativeDividerBrush}"
            BorderThickness="0,0,0,1">
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <Grid MinWidth="900" Margin="14,0" ColumnDefinitions="Auto,240,*,160,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8">
            <TextBlock Grid.Column="0" VerticalAlignment="Center" Classes="sectionLabel" Text="DASHBOARD" />
            <ComboBox
                Grid.Column="1"
                AutomationProperties.Name="Active dashboard"
                ItemsSource="{Binding Dashboard.Dashboards}"
                SelectedItem="{Binding Dashboard.SelectedDashboard, Mode=TwoWay}"
                VerticalAlignment="Center">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="presentation:KustoDashboardViewModel">
                  <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
              <TextBlock FontSize="{DynamicResource TypeCompactSize}" FontWeight="SemiBold" Text="{Binding Dashboard.SelectedDashboard.Title}" TextTrimming="CharacterEllipsis" />
              <TextBlock Classes="tertiary" FontSize="{DynamicResource TypeMetadataSize}" Text="{Binding Dashboard.SelectedDashboard.WidgetCountText}" />
            </StackPanel>
            <ComboBox
              x:Name="DashboardTimeRangeSelector"
                Grid.Column="3"
                AutomationProperties.Name="Dashboard time range"
                IsEnabled="{Binding Dashboard.HasSelectedDashboard}"
                ItemsSource="{Binding Dashboard.TimeRangeOptions}"
                SelectedItem="{Binding Dashboard.SelectedTimeRangeOption, Mode=TwoWay}"
                ToolTip.Tip="Dashboard time range"
                VerticalAlignment="Center">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="presentation:KustoDashboardTimeRangeOptionViewModel">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button
              x:Name="CreateDashboardButton"
                Grid.Column="4"
                AutomationProperties.Name="Create dashboard"
                Classes="treeAction"
                Command="{Binding Dashboard.OpenCreateDashboardCommand}"
                ToolTip.Tip="Create dashboard">
              <LucideIcon Kind="Plus" Size="14" />
            </Button>
            <Button
                Grid.Column="5"
                AutomationProperties.Name="Edit dashboard"
                Classes="treeAction"
                Command="{Binding Dashboard.OpenEditDashboardCommand}"
                ToolTip.Tip="Edit dashboard">
              <LucideIcon Kind="Pencil" Size="14" />
            </Button>
            <Button
              Grid.Column="6"
                AutomationProperties.Name="Delete dashboard"
                Classes="treeAction"
                Command="{Binding Dashboard.OpenDeleteDashboardCommand}"
                ToolTip.Tip="Delete dashboard">
              <LucideIcon Kind="Trash" Size="14" />
            </Button>
            <Button
              Grid.Column="7"
                AutomationProperties.Name="Import dashboard JSON"
                Classes="treeAction"
                Click="OnImportDashboardClick"
                ToolTip.Tip="Import dashboard JSON">
              <LucideIcon Kind="Upload" Size="14" />
            </Button>
            <Button
              Grid.Column="8"
                AutomationProperties.Name="Export dashboard JSON"
                Classes="treeAction"
                Click="OnExportDashboardClick"
                IsEnabled="{Binding Dashboard.HasSelectedDashboard}"
                ToolTip.Tip="Export dashboard JSON">
              <LucideIcon Kind="Download" Size="14" />
            </Button>
            <StackPanel Grid.Column="9" Orientation="Horizontal" Spacing="6">
              <Button
                  AutomationProperties.Name="Pin current query"
                  Classes="command"
                  Command="{Binding OpenPinToDashboardCommand}"
                  ToolTip.Tip="Add the query at the caret">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <LucideIcon Kind="Pin" Size="14" />
                  <TextBlock Text="Add widget" />
                </StackPanel>
              </Button>
              <Button
                  AutomationProperties.Name="Refresh dashboard"
                  Classes="treeAction"
                  Command="{Binding Dashboard.RefreshCommand}"
                  ToolTip.Tip="Refresh all widgets">
                <LucideIcon Kind="RefreshCw" Size="14" />
              </Button>
            </StackPanel>
          </Grid>
          </ScrollViewer>
        </Border>

        <Grid Grid.Row="1" Background="{Binding Dashboard.SelectedDashboard.BackgroundColor}">
          <StackPanel
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              IsVisible="{Binding Dashboard.ShowEmptyState}"
              Spacing="8">
            <LucideIcon HorizontalAlignment="Center" Kind="LayoutDashboard" Size="30" Foreground="{DynamicResource TextTertiaryBrush}" />
            <TextBlock HorizontalAlignment="Center" FontSize="{DynamicResource TypeTitleSize}" FontWeight="SemiBold" Text="No dashboards yet" />
            <Button
                HorizontalAlignment="Center"
                Classes="primaryCommand"
                Command="{Binding Dashboard.OpenCreateDashboardCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <LucideIcon Kind="Plus" Size="14" />
                <TextBlock Text="Create dashboard" />
              </StackPanel>
            </Button>
          </StackPanel>

          <Grid IsVisible="{Binding Dashboard.HasSelectedDashboard}">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsVisible="{Binding !Dashboard.SelectedDashboard.HasWidgets}"
                Spacing="7">
              <LucideIcon HorizontalAlignment="Center" Kind="PanelsTopLeft" Size="26" Foreground="{DynamicResource TextTertiaryBrush}" />
              <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="This dashboard is empty" />
              <Button HorizontalAlignment="Center" Classes="command" Click="OnConnectionsClick" Content="Back to queries" />
            </StackPanel>
          </Grid>

          <ScrollViewer
              HorizontalScrollBarVisibility="Auto"
              IsVisible="{Binding Dashboard.SelectedDashboard.HasWidgets}"
              VerticalScrollBarVisibility="Auto">
            <ItemsControl
                x:Name="DashboardCanvas"
                Width="1152"
                Height="1920"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                ItemsSource="{Binding Dashboard.SelectedDashboard.Widgets}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <Canvas Width="1152" Height="1920" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemContainerTheme>
                <ControlTheme x:DataType="presentation:KustoDashboardWidgetViewModel" TargetType="ContentPresenter">
                  <Setter Property="Canvas.Left" Value="{Binding CanvasLeft}" />
                  <Setter Property="Canvas.Top" Value="{Binding CanvasTop}" />
                  <Setter Property="Width" Value="{Binding CanvasWidth}" />
                  <Setter Property="Height" Value="{Binding CanvasHeight}" />
                </ControlTheme>
              </ItemsControl.ItemContainerTheme>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="presentation:KustoDashboardWidgetViewModel">
                  <Border
                      Margin="4"
                      Background="{Binding BackgroundColor}"
                      BorderBrush="{Binding AccentColor}"
                      BorderThickness="1"
                      ClipToBounds="True"
                      CornerRadius="5"
                      TextElement.Foreground="{Binding ForegroundColor}">
                    <Border.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="Refresh" Click="OnDashboardWidgetRefreshClick">
                          <MenuItem.Icon><LucideIcon Kind="RefreshCw" Size="13" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Edit..." Click="OnDashboardWidgetEditClick">
                          <MenuItem.Icon><LucideIcon Kind="Pencil" Size="13" /></MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Delete..." Click="OnDashboardWidgetDeleteClick">
                          <MenuItem.Icon><LucideIcon Kind="Trash" Size="13" /></MenuItem.Icon>
                        </MenuItem>
                      </ContextMenu>
                    </Border.ContextMenu>
                    <Grid RowDefinitions="38,3,*,16">
                      <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="2">
                        <Border
                            Grid.Column="0"
                            Padding="10,0"
                          AutomationProperties.HelpText="Press Alt with an arrow key to move. Add Shift to resize."
                          AutomationProperties.Name="{Binding LayoutAutomationText}"
                            Background="Transparent"
                            Cursor="SizeAll"
                          Focusable="True"
                          KeyDown="OnDashboardWidgetKeyDown"
                            PointerMoved="OnDashboardWidgetPointerMoved"
                            PointerPressed="OnDashboardWidgetPointerPressed"
                            PointerReleased="OnDashboardWidgetPointerReleased">
                          <StackPanel VerticalAlignment="Center" Spacing="0">
                            <TextBlock FontSize="{DynamicResource TypeCompactSize}" FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                            <TextBlock FontSize="{DynamicResource TypeMicroSize}" Opacity="0.68" Text="{Binding LastRefreshedText}" />
                          </StackPanel>
                        </Border>
                        <Button Grid.Column="1" AutomationProperties.Name="Refresh widget" Classes="treeAction" Command="{Binding RefreshCommand}" ToolTip.Tip="Refresh widget">
                          <LucideIcon Kind="RefreshCw" Size="12" />
                        </Button>
                        <Button Grid.Column="2" AutomationProperties.Name="Edit widget" Classes="treeAction" Click="OnDashboardWidgetEditClick" ToolTip.Tip="Edit widget">
                          <LucideIcon Kind="Pencil" Size="12" />
                        </Button>
                        <Button Grid.Column="3" AutomationProperties.Name="Delete widget" Classes="treeAction" Click="OnDashboardWidgetDeleteClick" ToolTip.Tip="Delete widget">
                          <LucideIcon Kind="Trash" Size="12" />
                        </Button>
                      </Grid>
                      <Border Grid.Row="1" Background="{Binding AccentColor}" />

                      <Grid Grid.Row="2" Margin="8,6">
                        <ProgressBar
                            Height="3"
                            VerticalAlignment="Top"
                            IsIndeterminate="True"
                            IsVisible="{Binding IsRefreshing}" />

                        <Border
                            Padding="10"
                            Background="#18D64545"
                            BorderBrush="#80D64545"
                            BorderThickness="1"
                            CornerRadius="4"
                            IsVisible="{Binding HasError}">
                          <StackPanel VerticalAlignment="Center" Spacing="4">
                            <LucideIcon HorizontalAlignment="Center" Kind="CircleAlert" Size="18" />
                            <TextBlock HorizontalAlignment="Center" FontSize="{DynamicResource TypeSmallSize}" FontWeight="SemiBold" Text="Refresh failed" />
                            <TextBlock HorizontalAlignment="Center" FontSize="{DynamicResource TypeMetadataSize}" Text="{Binding ErrorMessage}" TextAlignment="Center" TextWrapping="Wrap" />
                          </StackPanel>
                        </Border>

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding ShowEmptyState}" Spacing="4">
                          <LucideIcon HorizontalAlignment="Center" Kind="ChartNoAxesCombined" Size="18" Opacity="0.55" />
                          <TextBlock HorizontalAlignment="Center" FontSize="{DynamicResource TypeSmallSize}" Text="{Binding ResultSummary}" />
                        </StackPanel>

                        <ScrollViewer
                            HorizontalScrollBarVisibility="Auto"
                            IsVisible="{Binding IsTable}"
                            VerticalScrollBarVisibility="Auto">
                          <Grid MinWidth="{Binding ResultTableMinimumWidth}" RowDefinitions="32,*" IsVisible="{Binding HasResultTable}">
                            <ItemsControl Grid.Row="0" ItemsSource="{Binding ResultColumns}">
                              <ItemsControl.ItemsPanel><ItemsPanelTemplate><controls:KustoResultRowPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="presentation:KustoResultColumnViewModel">
                                  <Border MinWidth="{Binding DisplayWidth}" Padding="8,3" BorderBrush="#30202020" BorderThickness="0,0,1,1">
                                    <StackPanel VerticalAlignment="Center" Spacing="0">
                                      <TextBlock FontSize="{DynamicResource TypeMetadataSize}" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                      <TextBlock FontSize="{DynamicResource TypeMicroSize}" Opacity="0.6" Text="{Binding TypeName}" />
                                    </StackPanel>
                                  </Border>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding ResultRows}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="presentation:KustoResultRowViewModel">
                                  <ItemsControl ItemsSource="{Binding Cells}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><controls:KustoResultRowPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate x:DataType="presentation:KustoResultCellViewModel">
                                        <Border MinWidth="{Binding DisplayWidth}" MinHeight="25" Padding="8,4" BorderBrush="#20202020" BorderThickness="0,0,1,1">
                                          <TextBlock VerticalAlignment="Center" FontFamily="Cascadia Code, JetBrains Mono, Noto Sans Mono, monospace" FontSize="{DynamicResource TypeMetadataSize}" Text="{Binding Text}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Text}" />
                                        </Border>
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </Grid>
                        </ScrollViewer>

                        <ScrollViewer IsVisible="{Binding Visualization.IsCard}" VerticalScrollBarVisibility="Auto">
                          <ItemsControl ItemsSource="{Binding Visualization.Cards}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="presentation:KustoChartCardViewModel">
                                <Border MinWidth="132" Margin="4" Padding="10,8" Background="#10000000" BorderBrush="#28000000" BorderThickness="1" CornerRadius="4">
                                  <StackPanel Spacing="2">
                                    <TextBlock FontSize="{DynamicResource TypeMicroSize}" Opacity="0.65" Text="{Binding Label}" />
                                    <TextBlock FontSize="{DynamicResource TypeMetricSize}" FontWeight="SemiBold" Text="{Binding Value}" />
                                  </StackPanel>
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </ScrollViewer>

                        <Border
                            Background="#09000000"
                            BorderBrush="#28000000"
                            BorderThickness="1"
                            IsVisible="{Binding Visualization.IsPlot}">
                          <charts:KustoChart
                              Revision="{Binding Visualization.Revision}"
                              Visualization="{Binding Visualization}" />
                        </Border>
                      </Grid>

                      <Grid Grid.Row="3" ColumnDefinitions="*,Auto">
                        <TextBlock Margin="8,0" VerticalAlignment="Center" FontSize="{DynamicResource TypeMicroSize}" Opacity="0.58" Text="{Binding RefreshIntervalText}" />
                        <Border
                            Grid.Column="1"
                            Width="16"
                            Height="16"
                            Cursor="BottomRightCorner"
                            PointerMoved="OnDashboardWidgetPointerMoved"
                            PointerPressed="OnDashboardWidgetResizePointerPressed"
                            PointerReleased="OnDashboardWidgetPointerReleased"
                            ToolTip.Tip="Resize widget">
                          <LucideIcon Kind="Grip" Size="12" Opacity="0.58" />
                        </Border>
                      </Grid>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Grid>

      <Grid
          Grid.Column="1"
          IsVisible="{Binding IsAutomationView}">
        <Grid ColumnDefinitions="310,*">
          <StackPanel
              Grid.ColumnSpan="2"
              ZIndex="2"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              IsVisible="{Binding ShowAutomationEmptyState}"
              Spacing="7">
            <LucideIcon HorizontalAlignment="Center" Kind="Clock3" Size="26" Foreground="{DynamicResource TextTertiaryBrush}" />
            <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="No scheduled queries" />
            <TextBlock Classes="muted" FontSize="{DynamicResource TypeCompactSize}" Text="Return to a query, place the caret inside it, and choose Schedule" />
            <Button HorizontalAlignment="Center" Classes="command" Click="OnConnectionsClick" Content="Back to queries" />
          </StackPanel>
          <Border
              Grid.Column="0"
              Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource DecorativeDividerBrush}"
              BorderThickness="0,0,1,0"
              IsVisible="{Binding HasAutomations}">
            <Grid RowDefinitions="58,*">
              <StackPanel Grid.Row="0" Margin="14,0" VerticalAlignment="Center" Spacing="1">
                <TextBlock FontSize="{DynamicResource TypeEmphasisSize}" FontWeight="SemiBold" Text="Automations" />
                <TextBlock Classes="tertiary" FontSize="{DynamicResource TypeSmallSize}" Text="Scheduled while the app is open" />
              </StackPanel>
              <ListBox
                  Grid.Row="1"
                  Margin="6,0,6,10"
                  Background="Transparent"
                  BorderThickness="0"
                  ItemsSource="{Binding Automations}"
                  SelectedItem="{Binding SelectedAutomation, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="presentation:KustoAutomationViewModel">
                    <Grid MinWidth="270" MinHeight="64" Margin="5,2" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <Grid.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="Rename" Command="{Binding RenameCommand}">
                            <MenuItem.Icon><LucideIcon Kind="Pencil" Size="13" /></MenuItem.Icon>
                          </MenuItem>
                          <MenuItem Header="Actions" Command="{Binding ConfigureNotificationsCommand}">
                            <MenuItem.Icon><LucideIcon Kind="Zap" Size="13" /></MenuItem.Icon>
                          </MenuItem>
                        </ContextMenu>
                      </Grid.ContextMenu>
                      <StackPanel Grid.Row="0" Grid.Column="0" Spacing="1">
                        <TextBlock FontSize="{DynamicResource TypeCaptionSize}" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="tertiary" FontSize="{DynamicResource TypeMetadataSize}" Text="{Binding TargetText}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <Border Grid.Row="0" Grid.Column="1" Padding="6,2" VerticalAlignment="Top" Background="{DynamicResource AccentSubtleBrush}" CornerRadius="3">
                        <TextBlock FontSize="{DynamicResource TypeMetadataSize}" Text="{Binding StatusText}" />
                      </Border>
                      <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8">
                        <TextBlock Classes="muted" FontSize="{DynamicResource TypeSmallSize}" Text="{Binding ScheduleText}" />
                        <TextBlock Classes="tertiary" FontSize="{DynamicResource TypeSmallSize}" Text="{Binding NextRunText}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>

          <Grid Grid.Column="1" IsVisible="{Binding HasAutomations}" RowDefinitions="58,116,*">
            <Border Grid.Row="0" Background="{DynamicResource RaisedSurfaceBrush}" BorderBrush="{DynamicResource DecorativeDividerBrush}" BorderThickness="0,0,0,1">
              <Grid Margin="14,0" ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="1">
                  <TextBlock FontSize="{DynamicResource TypeTitleSize}" FontWeight="SemiBold" Text="{Binding SelectedAutomation.Name}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Classes="tertiary" FontSize="{DynamicResource TypeSmallSize}" Text="{Binding SelectedAutomation.TargetText}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <ToggleSwitch
                    Grid.Column="1"
                    AutomationProperties.Name="Enable selected automation"
                    VerticalAlignment="Center"
                    IsChecked="{Binding SelectedAutomation.IsEnabled}" />
                <Button Grid.Column="2" AutomationProperties.Name="Run selected automation now" Classes="command" VerticalAlignment="Center" Command="{Binding SelectedAutomation.RunNowCommand}" ToolTip.Tip="Run now">
                  <LucideIcon Kind="Play" Size="15" />
                </Button>
                <Button
                    Grid.Column="3"
                    AutomationProperties.Name="Configure automation actions"
                    Classes="command"
                    VerticalAlignment="Center"
                    Command="{Binding SelectedAutomation.ConfigureNotificationsCommand}"
                    ToolTip.Tip="Actions">
                  <LucideIcon Kind="Zap" Size="15" />
                </Button>
                <Button Grid.Column="4" AutomationProperties.Name="Delete selected automation" Classes="command" VerticalAlignment="Center" Command="{Binding SelectedAutomation.DeleteCommand}" ToolTip.Tip="Delete automation">
                  <LucideIcon Kind="Trash" Size="15" />
                </Button>
              </Grid>
            </Border>

            <Border Grid.Row="1" Margin="14,10" Padding="10" Background="{DynamicResource SubtleSurfaceBrush}" BorderBrush="{DynamicResource DecorativeDividerBrush}" BorderThickness="1" CornerRadius="5">
              <Grid RowDefinitions="Auto,*">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
                  <TextBlock Classes="sectionLabel" Text="SCHEDULED QUERY" />
                  <TextBlock Grid.Column="1" Classes="tertiary" FontSize="{DynamicResource TypeMetadataSize}" Text="{Binding SelectedAutomation.NotificationSummary}" />
                  <TextBlock Grid.Column="2" Classes="tertiary" FontSize="{DynamicResource TypeMetadataSize}" Text="{Binding SelectedAutomation.StopText}" />
                  <TextBlock Grid.Column="3" Classes="tertiary" FontSize="{DynamicResource TypeMetadataSize}" Text="{Binding SelectedAutomation.ScheduleText}" />
                </Grid>
                <ScrollViewer Grid.Row="1" Margin="0,6,0,0">
                  <TextBlock FontFamily="Cascadia Code, JetBrains Mono, Noto Sans Mono, monospace" FontSize="{DynamicResource TypeSmallSize}" Text="{Binding SelectedAutomation.QueryText}" TextWrapping="Wrap" />
                </ScrollViewer>
              </Grid>
            </Border>

            <Grid Grid.Row="2" ColumnDefinitions="230,*">
              <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource DecorativeDividerBrush}" BorderThickness="0,1,1,0">
                <Grid RowDefinitions="38,*">
                  <TextBlock Grid.Row="0" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Run history" />
                  <ListBox
                      Grid.Row="1"
                      Margin="6,0,6,8"
                      Background="Transparent"
                      BorderThickness="0"
                      ItemsSource="{Binding SelectedAutomation.Runs}"
                      SelectedItem="{Binding SelectedAutomation.SelectedRun, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="presentation:KustoAutomationRunViewModel">
                        <StackPanel MinWidth="190" MinHeight="58" Margin="5,2" Spacing="2">
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock FontSize="{DynamicResource TypeSmallSize}" FontWeight="SemiBold" Text="{Binding StartedText}" />
                            <TextBlock Grid.Column="1" Classes="tertiary" FontSize="{DynamicResource TypeMetadataSize}" Text="{Binding Status}" />
                          </Grid>
                          <TextBlock Classes="muted" FontSize="{DynamicResource TypeMetadataSize}" Text="{Binding SummaryText}" TextTrimming="CharacterEllipsis" />
                            <TextBlock
                              FontSize="{DynamicResource TypeMetadataSize}"
                              FontWeight="SemiBold"
                              Foreground="{Binding RowDeltaColorHex}"
                              IsVisible="{Binding HasRowDelta}"
                              Text="{Binding RowDeltaText}" />
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Grid>
              </Border>

              <Border Grid.Column="1" Classes="toolPane" BorderThickness="0,1,0,0">
                <TabControl
                    AutomationProperties.Name="Automation run output"
                    FontSize="{DynamicResource TypeCompactSize}"
                    SelectedIndex="{Binding SelectedAutomation.SelectedRun.SelectedOutputTabIndex, Mode=TwoWay}">
                  <TabItem AutomationProperties.Name="Automation results" Classes="toolTab">
                    <TabItem.Header>
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <LucideIcon Kind="Table2" Size="14" />
                        <TextBlock Text="Results" />
                      </StackPanel>
                    </TabItem.Header>
                    <Grid>
                      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="5">
                        <TextBlock Classes="muted" IsVisible="{Binding !SelectedAutomation.SelectedRun.HasResultTable}" Text="Select a successful run to inspect its table" />
                      </StackPanel>
                      <ScrollViewer HorizontalContentAlignment="Stretch" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" IsVisible="{Binding SelectedAutomation.SelectedRun.HasResultTable}">
                        <Grid MinWidth="{Binding SelectedAutomation.SelectedRun.ResultTableMinimumWidth}" HorizontalAlignment="Stretch" RowDefinitions="40,*">
                          <ItemsControl Grid.Row="0" ItemsSource="{Binding SelectedAutomation.SelectedRun.ResultColumns}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><controls:KustoResultRowPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="presentation:KustoResultColumnViewModel">
                                <Border MinWidth="{Binding DisplayWidth}" Padding="10,4" HorizontalAlignment="Stretch" Background="{DynamicResource SubtleSurfaceBrush}" BorderBrush="{DynamicResource DecorativeDividerBrush}" BorderThickness="0,1,1,1">
                                  <StackPanel VerticalAlignment="Center" Spacing="0">
                                    <TextBlock FontSize="{DynamicResource TypeCompactSize}" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Classes="tertiary" FontSize="{DynamicResource TypeMetadataSize}" Text="{Binding TypeName}" />
                                  </StackPanel>
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <ListBox Grid.Row="1" Background="Transparent" BorderThickness="0" ItemsSource="{Binding SelectedAutomation.SelectedRun.ResultRows}">
                            <ListBox.Styles>
                              <Style Selector="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                              </Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                              <DataTemplate x:DataType="presentation:KustoResultRowViewModel">
                                <ItemsControl ItemsSource="{Binding Cells}">
                                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><controls:KustoResultRowPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="presentation:KustoResultCellViewModel">
                                      <Border MinWidth="{Binding DisplayWidth}" MinHeight="30" Padding="10,5" HorizontalAlignment="Stretch" BorderBrush="{DynamicResource DecorativeDividerBrush}" BorderThickness="0,0,1,1">
                                        <TextBlock VerticalAlignment="Center" FontFamily="Cascadia Code, JetBrains Mono, Noto Sans Mono, monospace" FontSize="{DynamicResource TypeSmallSize}" Text="{Binding Text}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Text}" />
                                      </Border>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                              </DataTemplate>
                            </ListBox.ItemTemplate>
                          </ListBox>
                        </Grid>
                      </ScrollViewer>
                    </Grid>
                  </TabItem>

                  <TabItem AutomationProperties.Name="Automation visualization" Classes="toolTab">
                    <TabItem.Header>
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <LucideIcon Kind="ChartNoAxesCombined" Size="14" />
                        <TextBlock Text="Visualization" />
                      </StackPanel>
                    </TabItem.Header>
                    <Grid RowDefinitions="Auto,*">
                      <ScrollViewer
                          Grid.Row="0"
                          MinHeight="38"
                          Margin="10,5,10,2"
                          HorizontalScrollBarVisibility="Auto"
                          IsVisible="{Binding SelectedAutomation.SelectedRun.ShowVisualizationChoices}"
                          VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding SelectedAutomation.SelectedRun.VisualizationChoices}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="5" /></ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="presentation:KustoVisualizationChoiceViewModel">
                              <Button MinWidth="72" Classes="command" Command="{Binding SelectCommand}" Content="{Binding Label}" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                      <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding SelectedAutomation.SelectedRun.ShowVisualizationEmptyState}" Spacing="4">
                        <LucideIcon HorizontalAlignment="Center" Kind="ChartNoAxesCombined" Size="22" Foreground="{DynamicResource TextTertiaryBrush}" />
                        <TextBlock Classes="muted" Text="{Binding SelectedAutomation.SelectedRun.VisualizationMessage}" />
                      </StackPanel>
                      <Grid
                          x:Name="AutomationVisualizationSurface"
                          Grid.Row="1"
                          Margin="12,4,12,10"
                          Background="Transparent"
                          ColumnDefinitions="*,Auto"
                          IsVisible="{Binding SelectedAutomation.SelectedRun.HasVisualization}"
                          RowDefinitions="*">
                        <Grid.ContextMenu>
                          <ContextMenu>
                            <MenuItem Header="Save chart as PNG..." Click="OnSaveAutomationChartClick" />
                          </ContextMenu>
                        </Grid.ContextMenu>
                        <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource SubtleSurfaceBrush}" BorderBrush="{DynamicResource DecorativeDividerBrush}" BorderThickness="1">
                          <charts:KustoChart
                              Revision="{Binding SelectedAutomation.SelectedRun.Visualization.Revision}"
                              Visualization="{Binding SelectedAutomation.SelectedRun.Visualization}" />
                        </Border>
                        <Border
                            Grid.Row="0"
                            Grid.Column="1"
                            Width="200"
                            Margin="12,0,0,0"
                            Padding="10,0,0,0"
                            BorderBrush="{DynamicResource DecorativeDividerBrush}"
                            BorderThickness="1,0,0,0"
                            IsVisible="{Binding SelectedAutomation.SelectedRun.Visualization.LegendVisible}">
                          <Grid RowDefinitions="Auto,*" RowSpacing="8">
                            <Button
                                Grid.Row="0"
                                HorizontalContentAlignment="Left"
                                AutomationProperties.Name="{Binding SelectedAutomation.SelectedRun.Visualization.AllSeriesVisibilityActionText}"
                                Classes="command"
                                Command="{Binding SelectedAutomation.SelectedRun.Visualization.ToggleAllSeriesVisibilityCommand}">
                              <StackPanel Orientation="Horizontal" Spacing="7">
                                <Grid Width="14" Height="14">
                                  <LucideIcon IsVisible="{Binding SelectedAutomation.SelectedRun.Visualization.AreAllSeriesVisible}" Kind="EyeOff" Size="14" />
                                  <LucideIcon IsVisible="{Binding !SelectedAutomation.SelectedRun.Visualization.AreAllSeriesVisible}" Kind="Eye" Size="14" />
                                </Grid>
                                <TextBlock Text="{Binding SelectedAutomation.SelectedRun.Visualization.AllSeriesVisibilityActionText}" />
                              </StackPanel>
                            </Button>
                            <ScrollViewer
                                Grid.Row="1"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                              <ItemsControl ItemsSource="{Binding SelectedAutomation.SelectedRun.Visualization.Series}">
                                <ItemsControl.ItemsPanel>
                                  <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical" />
                                  </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate x:DataType="presentation:KustoChartSeriesViewModel">
                                    <Button
                                        Margin="0,0,0,3"
                                        AutomationProperties.Name="{Binding VisibilityActionText}"
                                      Classes="chartLegendItem"
                                        Command="{Binding ToggleVisibilityCommand}"
                                        Opacity="{Binding LegendOpacity}"
                                        ToolTip.Tip="{Binding VisibilityActionText}">
                                      <StackPanel Orientation="Horizontal" Spacing="7">
                                        <Ellipse
                                            Width="9"
                                            Height="9"
                                            VerticalAlignment="Center"
                                            Fill="{Binding ColorHex}" />
                                        <TextBlock
                                            MaxWidth="154"
                                            VerticalAlignment="Center"
                                            FontSize="{DynamicResource TypeSmallSize}"
                                            Text="{Binding Name}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTip.Tip="{Binding Name}" />
                                      </StackPanel>
                                    </Button>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </ScrollViewer>
                          </Grid>
                        </Border>
                      </Grid>
                    </Grid>
                  </TabItem>
                </TabControl>
              </Border>
            </Grid>
          </Grid>
        </Grid>
      </Grid>

      <Grid
          Grid.Column="1"
          IsVisible="{Binding IsSessionsView}"
          ColumnDefinitions="280,*">
        <Border
            Grid.Column="0"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource DecorativeDividerBrush}"
            BorderThickness="0,0,1,0">
          <Grid RowDefinitions="58,*,Auto">
            <Grid Grid.Row="0" Margin="14,0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
              <StackPanel VerticalAlignment="Center" Spacing="1">
                <TextBlock FontSize="{DynamicResource TypeEmphasisSize}" FontWeight="SemiBold" Text="Recorded sessions" />
                <TextBlock Classes="tertiary" FontSize="{DynamicResource TypeSmallSize}" Text="Choose an investigation" />
              </StackPanel>
              <Button
                  Grid.Column="1"
                  AutomationProperties.Name="Import recorded session"
                  Classes="treeAction"
                  Click="OnImportRecordedSessionClick"
                  IsEnabled="{Binding Recording.CanImportSession}"
                  ToolTip.Tip="Import session archive">
                <LucideIcon Kind="Upload" Size="14" />
              </Button>
              <Button
                  Grid.Column="2"
                  AutomationProperties.Name="Refresh recorded sessions"
                  Classes="treeAction"
                  Command="{Binding Recording.RefreshCommand}"
                  ToolTip.Tip="Refresh sessions">
                <LucideIcon Kind="RefreshCw" Size="14" />
              </Button>
            </Grid>
            <ListBox
                x:Name="RecordedSessionsList"
                Grid.Row="1"
                Margin="6,0,6,8"
                AutomationProperties.Name="Recorded sessions"
                Background="Transparent"
                BorderThickness="0"
                IsVisible="{Binding Recording.HasSessions}"
                ItemsSource="{Binding Recording.Sessions}"
                SelectedItem="{Binding Recording.SelectedSessionSummary, Mode=TwoWay}"
                SelectionChanged="OnRecordedSessionSelectionChanged">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="presentation:KustoRecordedSessionSummaryViewModel">
                  <Grid
                      MinWidth="246"
                      MinHeight="66"
                      Margin="4,2"
                      AutomationProperties.Name="{Binding AutomationName}"
                      RowDefinitions="Auto,Auto,Auto"
                      ColumnDefinitions="*,Auto">
                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Row="1" Classes="tertiary" FontSize="{DynamicResource TypeMetadataSize}" Text="{Binding StoredSizeText}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Classes="tertiary" FontSize="{DynamicResource TypeMetadataSize}" Text="{Binding ExecutionCountText}" />
                    <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Classes="tertiary" FontSize="{DynamicResource TypeMetadataSize}" Text="{Binding LastUpdatedText}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel
                Grid.Row="1"
                Margin="18"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsVisible="{Binding !Recording.HasSessions}"
                Spacing="7">
              <LucideIcon HorizontalAlignment="Center" Kind="History" Size="26" Foreground="{DynamicResource TextTertiaryBrush}" />
              <TextBlock FontWeight="SemiBold" Text="No recorded sessions" />
            </StackPanel>
            <Grid Grid.Row="2" Margin="10" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
              <Button
                  AutomationProperties.Name="Export selected recorded session"
                  Classes="command"
                  Command="{Binding Recording.OpenExportSessionCommand}"
                  IsEnabled="{Binding Recording.CanExportSelectedSession}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <LucideIcon Kind="Download" Size="13" />
                  <TextBlock Text="Export" />
                </StackPanel>
              </Button>
              <Button
                  Grid.Column="2"
                  AutomationProperties.Name="Delete selected recorded session"
                  Classes="command"
                  Command="{Binding Recording.OpenDeleteSessionCommand}"
                  IsEnabled="{Binding Recording.CanDeleteSelectedSession}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <LucideIcon Kind="Trash" Size="13" />
                  <TextBlock Text="Delete" />
                </StackPanel>
              </Button>
            </Grid>
          </Grid>
        </Border>

        <SplitView
            x:Name="PertinentValuesSplitView"
            Grid.Column="1"
            CompactPaneLength="0"
            DisplayMode="Inline"
            IsPaneOpen="True"
            OpenPaneLength="260"
            PaneBackground="{DynamicResource SurfaceBrush}"
            PanePlacement="Right">
          <SplitView.Pane>
            <Border
                Width="260"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource DecorativeDividerBrush}"
                BorderThickness="1,0,0,0">
              <Grid RowDefinitions="58,*,Auto">
                <StackPanel Grid.Row="0" Margin="14,0" VerticalAlignment="Center" Spacing="1">
                  <TextBlock FontWeight="SemiBold" Text="Pertinent values" />
                  <TextBlock
                      Classes="tertiary"
                      FontSize="{DynamicResource TypeMetadataSize}"
                      Text="{Binding Recording.SelectedSession.PertinentValueCountText}" />
                </StackPanel>
                <Grid Grid.Row="1" IsVisible="{Binding Recording.HasSelectedSession}">
                  <ListBox
                      Margin="6,0,6,8"
                      AutomationProperties.Name="Pertinent recorded values"
                      Background="Transparent"
                      BorderThickness="0"
                      IsVisible="{Binding Recording.SelectedSession.HasPertinentValues}"
                      ItemsSource="{Binding Recording.SelectedSession.PertinentValues}"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.Styles>
                      <Style Selector="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                      </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="presentation:KustoRecordedPertinentValueViewModel">
                          <Border
                              AutomationProperties.Name="{Binding AutomationName}"
                              Background="Transparent"
                              HorizontalAlignment="Stretch">
                            <Border.ContextMenu>
                              <ContextMenu>
                                <MenuItem Header="Set as chain start" IsEnabled="{Binding HasCoordinates}" Click="OnSetPertinentValueChainStartClick" />
                                <MenuItem Header="Set as chain end" IsEnabled="{Binding HasCoordinates}" Click="OnSetPertinentValueChainEndClick" />
                              </ContextMenu>
                            </Border.ContextMenu>
                            <Border
                                MinHeight="58"
                                Margin="4,2"
                                Padding="8,6"
                              Background="{Binding HighlightColorHex}"
                              BorderBrush="{Binding AccentColorHex}"
                              BorderThickness="3,0,0,1">
                              <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                <TextBlock
                                    FontFamily="Cascadia Code, JetBrains Mono, Noto Sans Mono, monospace"
                                    FontSize="{DynamicResource TypeSmallSize}"
                                    FontWeight="SemiBold"
                                    Text="{Binding ValueText}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip.Tip="{Binding ValueText}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="3">
                                  <LucideIcon
                                      IsVisible="{Binding IsExtracted}"
                                      Kind="Sparkles"
                                      Size="11"
                                      Foreground="{Binding AccentColorHex}"
                                      ToolTip.Tip="Extracted from a query predicate" />
                                  <LucideIcon
                                      IsVisible="{Binding IsAddedByUser}"
                                      Kind="Bookmark"
                                      Size="11"
                                      Foreground="{Binding AccentColorHex}"
                                      ToolTip.Tip="Added by you" />
                                </StackPanel>
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    Classes="tertiary"
                                    FontSize="{DynamicResource TypeMicroSize}"
                                    Text="{Binding ContextText}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip.Tip="{Binding SourceText}" />
                              </Grid>
                            </Border>
                          </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <StackPanel
                      Margin="18"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      IsVisible="{Binding !Recording.SelectedSession.HasPertinentValues}"
                      Spacing="7">
                    <LucideIcon HorizontalAlignment="Center" Kind="Bookmark" Size="24" Foreground="{DynamicResource TextTertiaryBrush}" />
                    <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="No pertinent values" />
                    <TextBlock
                        Classes="tertiary"
                        FontSize="{DynamicResource TypeMetadataSize}"
                        Text="Query predicates and values you mark will appear here"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                  </StackPanel>
                </Grid>
                <StackPanel
                    Grid.Row="1"
                    Margin="18"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsVisible="{Binding !Recording.HasSelectedSession}"
                    Spacing="7">
                  <LucideIcon HorizontalAlignment="Center" Kind="Bookmark" Size="24" Foreground="{DynamicResource TextTertiaryBrush}" />
                  <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="Select a session" />
                </StackPanel>
                <Button
                    Grid.Row="2"
                    Margin="10"
                    AutomationProperties.Name="Export all pertinent values as CSV"
                    Classes="command"
                    Click="OnExportPertinentValuesCsvClick"
                    IsEnabled="{Binding Recording.SelectedSession.HasPertinentValues}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <LucideIcon Kind="Download" Size="13" />
                    <TextBlock Text="Export CSV" />
                  </StackPanel>
                </Button>
              </Grid>
            </Border>
          </SplitView.Pane>

          <Grid>
            <desktop:DeferredContentControl
                IsContentMaterialized="{Binding Recording.HasSelectedSession}"
                IsVisible="{Binding Recording.HasSelectedSession}"
                RetainContent="True">
              <desktop:DeferredContentControl.ContentTemplate>
                <DataTemplate x:DataType="presentation:MainWindowViewModel">
                  <Grid RowDefinitions="*,Auto" ColumnDefinitions="320,*">
            <Border
                Grid.Row="0"
                Grid.Column="0"
                Background="{DynamicResource RaisedSurfaceBrush}"
                BorderBrush="{DynamicResource DecorativeDividerBrush}"
                BorderThickness="0,0,1,0">
              <Grid RowDefinitions="58,*">
                <StackPanel Grid.Row="0" Margin="14,0" VerticalAlignment="Center" Spacing="1">
                  <TextBlock FontWeight="SemiBold" Text="{Binding Recording.SelectedSession.Name}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Classes="tertiary" FontSize="{DynamicResource TypeMetadataSize}" Text="Choose a query to inspect its results" />
                </StackPanel>
                <ListBox
                    Grid.Row="1"
                    Margin="6,0,6,8"
                    AutomationProperties.Name="Recorded query executions"
                    Background="Transparent"
                    BorderThickness="0"
                    IsVisible="{Binding Recording.HasSelectedSession}"
                    ItemsSource="{Binding Recording.SelectedSession.Executions}"
                    SelectedItem="{Binding Recording.SelectedExecution, Mode=TwoWay}">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="presentation:KustoRecordedExecutionViewModel">
                      <Grid
                          MinWidth="286"
                          MinHeight="76"
                          Margin="4,2"
                          AutomationProperties.Name="{Binding AutomationName}"
                          Background="Transparent"
                          RowDefinitions="Auto,Auto,Auto,Auto"
                          ColumnDefinitions="*,Auto,Auto">
                        <Grid.ContextMenu>
                          <ContextMenu>
                            <MenuItem Header="Rename query..." Click="OnRenameRecordedQueryClick" />
                          </ContextMenu>
                        </Grid.ContextMenu>
                        <TextBlock FontWeight="SemiBold" Text="{Binding QueryTitle}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Classes="tertiary" FontSize="{DynamicResource TypeMetadataSize}" Text="{Binding StatusText}" />
                        <Button
                            Grid.Column="2"
                            Margin="5,0,0,0"
                            AutomationProperties.Name="Rename recorded query"
                            Classes="treeAction"
                            Click="OnRenameRecordedQueryClick"
                            ToolTip.Tip="Rename query">
                          <LucideIcon Kind="Pencil" Size="12" />
                        </Button>
                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" FontFamily="Cascadia Code, JetBrains Mono, Noto Sans Mono, monospace" FontSize="{DynamicResource TypeMetadataSize}" Text="{Binding QueryPreview}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Classes="tertiary" FontSize="{DynamicResource TypeMetadataSize}" Text="{Binding TargetText}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Row="3" Classes="tertiary" FontSize="{DynamicResource TypeMetadataSize}" Text="{Binding StartedText}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Classes="tertiary" FontSize="{DynamicResource TypeMetadataSize}" Text="{Binding ResultSummary}" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel
                    Grid.Row="1"
                    Margin="18"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsVisible="{Binding !Recording.HasSelectedSession}"
                    Spacing="7">
                  <LucideIcon HorizontalAlignment="Center" Kind="FileText" Size="24" Foreground="{DynamicResource TextTertiaryBrush}" />
                  <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="Select a session" />
                  <TextBlock Classes="tertiary" FontSize="{DynamicResource TypeSmallSize}" Text="Its recorded queries will appear here" />
                </StackPanel>
              </Grid>
            </Border>

            <Grid Grid.Row="0" Grid.Column="1" RowDefinitions="58,96,*,Auto">
            <Grid
              Grid.Row="0"
              MinHeight="58"
              Margin="14,0"
              ColumnDefinitions="*,Auto,Auto,Auto"
              ColumnSpacing="8">
            <StackPanel VerticalAlignment="Center" Spacing="1">
              <TextBlock FontWeight="SemiBold" Text="{Binding Recording.SelectedExecution.ResultHeading}" TextTrimming="CharacterEllipsis" />
              <TextBlock Classes="tertiary" FontSize="{DynamicResource TypeMetadataSize}" Text="{Binding Recording.SelectedExecution.TargetText}" />
            </StackPanel>
            <Button
                Grid.Column="1"
                AutomationProperties.Name="Toggle pertinent values panel"
                Classes="treeAction"
                Click="OnTogglePertinentValuesClick"
                ToolTip.Tip="Pertinent values">
              <LucideIcon Kind="Bookmark" Size="14" />
            </Button>
            <Button
                Grid.Column="2"
                AutomationProperties.Name="Delete selected recorded query"
                Classes="treeAction"
                Command="{Binding Recording.OpenDeleteExecutionCommand}"
                IsEnabled="{Binding Recording.CanDeleteSelectedExecution}"
                ToolTip.Tip="Delete recorded query">
              <LucideIcon Kind="Trash" Size="14" />
            </Button>
            <Button
              Grid.Column="3"
                AutomationProperties.Name="Return to query workbench"
                Classes="treeAction"
                Click="OnConnectionsClick"
                ToolTip.Tip="Back to queries">
              <LucideIcon Kind="FileText" Size="14" />
            </Button>
          </Grid>
          <TextBox
              Grid.Row="1"
              Margin="12,0,12,8"
              AcceptsReturn="True"
              AutomationProperties.Name="Recorded KQL query"
              Background="{DynamicResource SubtleSurfaceBrush}"
              FontFamily="Cascadia Code, JetBrains Mono, Noto Sans Mono, monospace"
              FontSize="{DynamicResource TypeSmallSize}"
              IsReadOnly="True"
              IsVisible="{Binding Recording.HasSelectedExecution}"
              Text="{Binding Recording.SelectedExecution.QueryText}"
              TextWrapping="NoWrap" />
              <Grid Grid.Row="2" RowDefinitions="*,Auto">
            <ScrollViewer
                Grid.Row="0"
                HorizontalScrollBarVisibility="Auto"
                IsVisible="{Binding Recording.SelectedExecution.HasRows}"
                VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding Recording.SelectedExecution.Tables}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="presentation:KustoRecordedResultTableViewModel">
                    <StackPanel Margin="0,0,0,12" IsVisible="{Binding HasRows}">
                      <Border
                          Padding="10,6"
                          Background="{DynamicResource RaisedSurfaceBrush}"
                          BorderBrush="{DynamicResource DecorativeDividerBrush}"
                          BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                          <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding DisplayName}" />
                          <TextBlock Grid.Column="1" VerticalAlignment="Center" Classes="tertiary" FontSize="{DynamicResource TypeMetadataSize}" Text="{Binding MetadataText}" TextTrimming="CharacterEllipsis" />
                        </Grid>
                      </Border>
                      <Grid
                          MinWidth="{Binding MinimumWidth}"
                          AutomationProperties.ControlTypeOverride="DataGrid"
                          AutomationProperties.Name="Recorded query result data grid"
                          RowDefinitions="32,Auto">
                        <ItemsControl
                            Grid.Row="0"
                            AutomationProperties.ControlTypeOverride="Header"
                            AutomationProperties.Name="Recorded query result columns"
                            ItemsSource="{Binding Columns}">
                          <ItemsControl.ItemsPanel><ItemsPanelTemplate><controls:KustoResultRowPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="presentation:KustoResultColumnViewModel">
                                <Border
                                  MinWidth="{Binding DisplayWidth}"
                                  Padding="8,3"
                                  AutomationProperties.ControlTypeOverride="HeaderItem"
                                  AutomationProperties.Name="{Binding Name}"
                                  BorderBrush="{DynamicResource DecorativeDividerBrush}"
                                  BorderThickness="0,0,1,1">
                                <StackPanel VerticalAlignment="Center" Spacing="0">
                                  <TextBlock FontSize="{DynamicResource TypeMetadataSize}" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                  <TextBlock Classes="tertiary" FontSize="{DynamicResource TypeMicroSize}" Text="{Binding TypeName}" />
                                </StackPanel>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl
                          Grid.Row="1"
                          AutomationProperties.ControlTypeOverride="DataGrid"
                          AutomationProperties.Name="Recorded query result rows"
                          ItemsSource="{Binding Rows}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="presentation:KustoResultRowViewModel">
                              <Grid Background="{Binding BackgroundHex}">
                                <ItemsControl ItemsSource="{Binding Cells}">
                                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><controls:KustoResultRowPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="presentation:KustoResultCellViewModel">
                                      <Grid MinWidth="{Binding DisplayWidth}" MinHeight="30">
                                        <Border
                                          AutomationProperties.Name="{Binding AutomationText}"
                                            AutomationProperties.HelpText="{Binding RecordingAnnotationText}"
                                            Background="{Binding BackgroundHex}"
                                            BorderBrush="{DynamicResource DecorativeDividerBrush}"
                                            BorderThickness="0,0,1,1"
                                            PointerPressed="OnRecordedResultCellPointerPressed">
                                          <Border.ContextMenu>
                                            <ContextMenu>
                                              <MenuItem Header="Mark value as interesting" Click="OnMarkHistoricalCellClick" />
                                              <MenuItem Header="Mark all values in this column as interesting" Click="OnMarkHistoricalColumnClick" />
                                              <MenuItem Header="Remove value mark" Click="OnUnmarkHistoricalCellClick" />
                                              <Separator />
                                              <MenuItem Header="Set as chain start" Click="OnSetHistoricalChainStartClick" />
                                              <MenuItem Header="Set as chain end" Click="OnSetHistoricalChainEndClick" />
                                            </ContextMenu>
                                          </Border.ContextMenu>
                                          <Grid>
                                            <Border Background="{Binding RecordingHighlightHex}" IsVisible="{Binding HasRecordingAnnotation}" />
                                            <Grid Margin="8,4" ColumnDefinitions="*,Auto" ColumnSpacing="5">
                                              <TextBlock VerticalAlignment="Center" AutomationProperties.Name="{Binding AutomationText}" FontFamily="Cascadia Code, JetBrains Mono, Noto Sans Mono, monospace" FontSize="{DynamicResource TypeSmallSize}" Text="{Binding Text}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Text}" />
                                              <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="3">
                                                <LucideIcon Kind="Sparkles" Size="10" Foreground="{Binding RecordingAccentHex}" IsVisible="{Binding IsRecordedInterestMatch}" ToolTip.Tip="Matches a recorded value of interest" />
                                                <Border Padding="4,1" Background="{Binding RecordingAccentHex}" CornerRadius="2" IsVisible="{Binding IsRecordedPertinent}">
                                                  <TextBlock FontSize="{DynamicResource TypeBadgeSize}" FontWeight="SemiBold" Foreground="{DynamicResource OnAccentBrush}" Text="MARKED" />
                                                </Border>
                                                <Border Padding="4,1" BorderBrush="{DynamicResource SuccessBrush}" BorderThickness="1" CornerRadius="2" IsVisible="{Binding IsChainStart}">
                                                  <TextBlock FontSize="{DynamicResource TypeBadgeSize}" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" Text="START" />
                                                </Border>
                                                <Border Padding="4,1" BorderBrush="{DynamicResource InfoBrush}" BorderThickness="1" CornerRadius="2" IsVisible="{Binding IsChainEnd}">
                                                  <TextBlock FontSize="{DynamicResource TypeBadgeSize}" FontWeight="SemiBold" Foreground="{DynamicResource InfoBrush}" Text="END" />
                                                </Border>
                                              </StackPanel>
                                            </Grid>
                                          </Grid>
                                        </Border>
                                        <Border IsHitTestVisible="False" IsVisible="{Binding IsActionTarget}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" />
                                      </Grid>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </Grid>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <StackPanel
                Grid.Row="0"
                Margin="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsVisible="{Binding !Recording.HasSelectedExecution}"
                Spacing="7">
              <LucideIcon HorizontalAlignment="Center" Kind="FileText" Size="26" Foreground="{DynamicResource TextTertiaryBrush}" />
              <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="Select a recorded query" />
              <TextBlock Classes="tertiary" FontSize="{DynamicResource TypeSmallSize}" Text="Its retained results will appear here" />
            </StackPanel>
            <Grid Grid.Row="0" IsVisible="{Binding Recording.HasSelectedExecution}">
              <StackPanel
                  Margin="20"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  IsVisible="{Binding !Recording.SelectedExecution.HasTables}"
                  Spacing="7">
                <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="No retained result" />
                <TextBlock Classes="tertiary" FontSize="{DynamicResource TypeSmallSize}" Text="{Binding Recording.SelectedExecution.ResultSummary}" />
              </StackPanel>
              <Grid IsVisible="{Binding Recording.SelectedExecution.HasTables}">
                <StackPanel
                    Margin="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsVisible="{Binding !Recording.SelectedExecution.HasRows}"
                    Spacing="7">
                  <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="This query returned no rows" />
                  <TextBlock Classes="tertiary" FontSize="{DynamicResource TypeSmallSize}" Text="Choose another recorded query" />
                </StackPanel>
              </Grid>
            </Grid>
            <Border
                Grid.Row="1"
                Padding="10,6"
                Background="{DynamicResource RaisedSurfaceBrush}"
                BorderBrush="{DynamicResource DecorativeDividerBrush}"
                BorderThickness="0,1,0,0"
                IsVisible="{Binding Recording.SelectedExecution.HasMultiplePages}">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <Button
                    AutomationProperties.Name="Previous recorded result page"
                    Classes="treeAction"
                    Command="{Binding Recording.SelectedExecution.PreviousPageCommand}"
                    ToolTip.Tip="Previous 50 rows">
                  <LucideIcon Kind="ChevronLeft" Size="14" />
                </Button>
                <TextBlock
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Classes="tertiary"
                    FontSize="{DynamicResource TypeMetadataSize}"
                    Text="{Binding Recording.SelectedExecution.PageText}" />
                <Button
                    Grid.Column="2"
                    AutomationProperties.Name="Next recorded result page"
                    Classes="treeAction"
                    Command="{Binding Recording.SelectedExecution.NextPageCommand}"
                    ToolTip.Tip="Next 50 rows">
                  <LucideIcon Kind="ChevronRight" Size="14" />
                </Button>
              </Grid>
            </Border>
          </Grid>
          <Border
              Grid.Row="3"
              Padding="12,9,12,12"
              BorderBrush="{DynamicResource DecorativeDividerBrush}"
              BorderThickness="0,1,0,0"
              IsVisible="{Binding Recording.HasSelectedExecution}">
            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="9">
              <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Query chain" />
              <Button
                  Grid.Column="1"
                  AutomationProperties.Name="Clear chain start and end"
                  Classes="treeAction"
                  Command="{Binding Recording.ClearChainEndpointsCommand}"
                  ToolTip.Tip="Clear start and end">
                <LucideIcon Kind="X" Size="14" />
              </Button>
              <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal">
                <Button
                    Margin="0,0,6,0"
                    AutomationProperties.Name="Mark selected recorded value as interesting"
                    Classes="command"
                    Command="{Binding Recording.MarkSelectedCellCommand}"
                    IsVisible="{Binding !Recording.SelectedResultValueIsMarked}"
                    Content="Mark interesting" />
                <Button
                    Margin="0,0,6,0"
                    AutomationProperties.Name="Remove interesting mark from selected recorded value"
                    Classes="command"
                    Command="{Binding Recording.UnmarkSelectedCellCommand}"
                    IsVisible="{Binding Recording.SelectedResultValueIsMarked}"
                    Content="Remove mark" />
                <Button
                    Margin="0,0,6,0"
                    AutomationProperties.Name="Set selected recorded value as chain start"
                    Classes="command"
                    Command="{Binding Recording.SetChainStartCommand}"
                    Content="Set start" />
                <Button
                    AutomationProperties.Name="Set selected recorded value as chain end"
                    Classes="command"
                    Command="{Binding Recording.SetChainEndCommand}"
                    Content="Set end" />
              </WrapPanel>
              <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnDefinitions="*,1,*,Auto" ColumnSpacing="12">
                <Grid RowDefinitions="Auto,Auto,Auto">
                  <TextBlock Classes="sectionLabel" Text="START" />
                  <TextBlock Grid.Row="1" FontFamily="Cascadia Code, JetBrains Mono, Noto Sans Mono, monospace" FontSize="{DynamicResource TypeSmallSize}" FontWeight="SemiBold" Text="{Binding Recording.ChainStartValueText}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Recording.ChainStartValueText}" />
                  <TextBlock Grid.Row="2" Classes="tertiary" FontSize="{DynamicResource TypeMicroSize}" Text="{Binding Recording.ChainStartLocationText}" TextTrimming="CharacterEllipsis" />
                </Grid>
                <Border Grid.Column="1" Background="{DynamicResource DecorativeDividerBrush}" />
                <Grid Grid.Column="2" RowDefinitions="Auto,Auto,Auto">
                  <TextBlock Classes="sectionLabel" Text="END" />
                  <TextBlock Grid.Row="1" FontFamily="Cascadia Code, JetBrains Mono, Noto Sans Mono, monospace" FontSize="{DynamicResource TypeSmallSize}" FontWeight="SemiBold" Text="{Binding Recording.ChainEndValueText}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Recording.ChainEndValueText}" />
                  <TextBlock Grid.Row="2" Classes="tertiary" FontSize="{DynamicResource TypeMicroSize}" Text="{Binding Recording.ChainEndLocationText}" TextTrimming="CharacterEllipsis" />
                </Grid>
                <Button
                    Grid.Column="3"
                    MinWidth="132"
                    Height="40"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Generate query from selected chain start and end"
                    Classes="primaryCommand"
                    Command="{Binding GenerateRecordedChainCommand}"
                    IsEnabled="{Binding Recording.CanGenerateChain}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <LucideIcon Kind="GitGraph" Size="14" />
                    <TextBlock FontWeight="SemiBold" Text="Generate query" />
                  </StackPanel>
                </Button>
              </Grid>
            </Grid>
          </Border>
            </Grid>

            <Border
                Grid.Row="1"
                Grid.ColumnSpan="2"
                Height="150"
                Background="{DynamicResource SubtleSurfaceBrush}"
                BorderBrush="{DynamicResource AccentBrush}"
                BorderThickness="0,1,0,0"
                IsVisible="{Binding Recording.HasSelectedSession}">
              <Grid RowDefinitions="38,*">
                <Grid Grid.Row="0" Margin="14,0" ColumnDefinitions="4,*" ColumnSpacing="10">
                  <Border Width="4" Height="28" VerticalAlignment="Center" Background="{DynamicResource AccentBrush}" CornerRadius="2" />
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                    <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Text="Discovery timeline" />
                    <TextBlock Classes="tertiary" FontSize="{DynamicResource TypeMetadataSize}" Text="{Binding Recording.SelectedSession.TimelineCountText}" />
                  </StackPanel>
                </Grid>
                <ListBox
                    Grid.Row="1"
                    AutomationProperties.Name="Pertinent value discovery timeline"
                    Background="Transparent"
                    BorderThickness="0"
                    IsVisible="{Binding Recording.SelectedSession.HasTimelineValues}"
                    ItemsSource="{Binding Recording.SelectedSession.TimelineValues}"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollBarVisibility="Disabled">
                  <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                      <Setter Property="Padding" Value="0" />
                      <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    </Style>
                  </ListBox.Styles>
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <VirtualizingStackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="presentation:KustoRecordedTimelineValueViewModel">
                      <Grid
                          Width="228"
                          Margin="12,0,0,6"
                          AutomationProperties.Name="{Binding AutomationName}"
                          RowDefinitions="Auto,12,*">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="5">
                          <TextBlock Foreground="{Binding AccentColorHex}" FontSize="{DynamicResource TypeMetadataSize}" FontWeight="SemiBold" Text="{Binding QueryTitle}" TextTrimming="CharacterEllipsis" />
                          <Border Grid.Column="1" Padding="4,1" Background="{Binding HighlightColorHex}" BorderBrush="{Binding AccentColorHex}" BorderThickness="1" CornerRadius="2">
                            <TextBlock FontSize="{DynamicResource TypeBadgeSize}" FontWeight="SemiBold" Foreground="{Binding AccentColorHex}" Text="{Binding SourceText}" TextTrimming="CharacterEllipsis" />
                          </Border>
                        </Grid>
                        <Grid Grid.Row="1">
                          <Border Height="3" VerticalAlignment="Center" Background="{Binding AccentColorHex}" CornerRadius="2" />
                          <Ellipse
                              Width="12"
                              Height="12"
                              Margin="12,0,0,0"
                              HorizontalAlignment="Left"
                              Fill="{Binding AccentColorHex}"
                              IsVisible="{Binding IsExtracted}" />
                          <Border
                              Width="11"
                              Height="11"
                              Margin="14,0,0,0"
                              HorizontalAlignment="Left"
                              Background="{Binding AccentColorHex}"
                              IsVisible="{Binding IsAddedByUser}"
                              RenderTransformOrigin="50%,50%">
                            <Border.RenderTransform>
                              <RotateTransform Angle="45" />
                            </Border.RenderTransform>
                          </Border>
                        </Grid>
                        <Border
                            Grid.Row="2"
                            MinHeight="54"
                            Background="{Binding HighlightColorHex}"
                            BorderBrush="{Binding AccentColorHex}"
                            BorderThickness="1"
                            CornerRadius="6"
                            PointerPressed="OnRecordedTimelineValuePointerPressed">
                          <Border.ContextMenu>
                            <ContextMenu>
                              <MenuItem Header="Set as chain start" IsEnabled="{Binding HasCoordinates}" Click="OnSetTimelineValueChainStartClick" />
                              <MenuItem Header="Set as chain end" IsEnabled="{Binding HasCoordinates}" Click="OnSetTimelineValueChainEndClick" />
                            </ContextMenu>
                          </Border.ContextMenu>
                          <Grid ColumnDefinitions="5,*">
                            <Border Background="{Binding AccentColorHex}" CornerRadius="5,0,0,5" />
                            <Grid Grid.Column="1" Margin="9,4" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" ColumnSpacing="5" RowSpacing="2">
                              <TextBlock
                                  FontFamily="Cascadia Code, JetBrains Mono, Noto Sans Mono, monospace"
                                  FontSize="{DynamicResource TypeSmallSize}"
                                  FontWeight="SemiBold"
                                  Text="{Binding ValueText}"
                                  TextTrimming="CharacterEllipsis"
                                  ToolTip.Tip="{Binding ValueText}" />
                              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3">
                                <LucideIcon Foreground="{Binding AccentColorHex}" IsVisible="{Binding IsExtracted}" Kind="Sparkles" Size="11" ToolTip.Tip="Extracted automatically" />
                                <LucideIcon Foreground="{Binding AccentColorHex}" IsVisible="{Binding IsAddedByUser}" Kind="Bookmark" Size="11" ToolTip.Tip="Added by you" />
                              </StackPanel>
                              <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6">
                                <Border Width="8" Height="8" VerticalAlignment="Center" Background="{Binding AccentColorHex}" CornerRadius="2" />
                                <TextBlock
                                    Grid.Column="1"
                                    Foreground="{Binding AccentColorHex}"
                                    FontSize="{DynamicResource TypeMetadataSize}"
                                    FontWeight="SemiBold"
                                    Text="{Binding FlowText}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip.Tip="{Binding FlowText}" />
                                <LucideIcon Grid.Column="2" Foreground="{Binding AccentColorHex}" Kind="ArrowRight" Size="12" />
                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4">
                                  <Border Padding="4,1" Background="{DynamicResource SuccessBrush}" CornerRadius="2" IsVisible="{Binding IsChainStart}">
                                    <TextBlock FontSize="{DynamicResource TypeBadgeSize}" FontWeight="SemiBold" Foreground="{DynamicResource OnAccentBrush}" Text="START" />
                                  </Border>
                                  <Border Padding="4,1" Background="{DynamicResource InfoBrush}" CornerRadius="2" IsVisible="{Binding IsChainEnd}">
                                    <TextBlock FontSize="{DynamicResource TypeBadgeSize}" FontWeight="SemiBold" Foreground="{DynamicResource OnAccentBrush}" Text="END" />
                                  </Border>
                                </StackPanel>
                              </Grid>
                            </Grid>
                          </Grid>
                        </Border>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsVisible="{Binding !Recording.SelectedSession.HasTimelineValues}"
                    Spacing="4">
                  <LucideIcon HorizontalAlignment="Center" Kind="GitCommitHorizontal" Size="20" Foreground="{DynamicResource TextTertiaryBrush}" />
                  <TextBlock Classes="tertiary" FontSize="{DynamicResource TypeMetadataSize}" Text="No pertinent values discovered" />
                </StackPanel>
              </Grid>
            </Border>
                  </Grid>
                </DataTemplate>
              </desktop:DeferredContentControl.ContentTemplate>
            </desktop:DeferredContentControl>
            <StackPanel
                Margin="18"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsVisible="{Binding !Recording.HasSelectedSession}"
                Spacing="7">
              <LucideIcon HorizontalAlignment="Center" Kind="FileText" Size="24" Foreground="{DynamicResource TextTertiaryBrush}" />
              <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="Select a session" />
              <TextBlock Classes="tertiary" FontSize="{DynamicResource TypeSmallSize}" Text="Its recorded queries will appear here" />
            </StackPanel>
          </Grid>
        </SplitView>
      </Grid>

      <Grid
          Grid.Column="1"
          IsVisible="{Binding IsGraphView}"
          RowDefinitions="58,*">
        <Border
            Grid.Row="0"
            Background="{DynamicResource RaisedSurfaceBrush}"
            BorderBrush="{DynamicResource DecorativeDividerBrush}"
            BorderThickness="0,0,0,1">
          <Grid Margin="14,0" ColumnDefinitions="Auto,240,*,230,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8">
            <TextBlock Grid.Column="0" VerticalAlignment="Center" Classes="sectionLabel" Text="GRAPH" />
            <ComboBox
                Grid.Column="1"
                AutomationProperties.Name="Active saved graph"
                ItemsSource="{Binding Graph.Graphs}"
              SelectedItem="{Binding Graph.SelectedGraph, Mode=TwoWay}"
              VerticalAlignment="Center">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="graph:GraphCatalogEntry">
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="0">
              <TextBlock FontSize="{DynamicResource TypeSmallSize}" Text="{Binding Graph.GraphDescriptionText}" TextTrimming="CharacterEllipsis" />
              <TextBlock Classes="tertiary" FontSize="{DynamicResource TypeMetadataSize}" Text="{Binding Graph.CountText}" />
            </StackPanel>
            <ComboBox
                Grid.Column="3"
                AutomationProperties.Name="Graph investigation history"
                ItemsSource="{Binding Graph.TimelinePoints}"
                SelectedItem="{Binding Graph.SelectedTimelinePoint, Mode=TwoWay}"
              ToolTip.Tip="View live or retained graph state"
              VerticalAlignment="Center">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="presentation:GraphTimelinePointViewModel">
                  <StackPanel AutomationProperties.Name="{Binding AutomationName}" MinWidth="188" Spacing="0">
                    <TextBlock FontSize="{DynamicResource TypeSmallSize}" FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="tertiary" FontSize="{DynamicResource TypeMicroSize}" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button
                Grid.Column="4"
                AutomationProperties.Name="Create saved graph"
                Classes="treeAction"
                Command="{Binding Graph.OpenCreateGraphCommand}"
                ToolTip.Tip="Create graph">
              <LucideIcon Kind="Plus" Size="14" />
            </Button>
            <Button
              Grid.Column="5"
                AutomationProperties.Name="Edit saved graph details"
                Classes="treeAction"
                Command="{Binding Graph.OpenEditGraphCommand}"
                ToolTip.Tip="Edit graph details">
              <LucideIcon Kind="Pencil" Size="14" />
            </Button>
            <Button
              Grid.Column="6"
                AutomationProperties.Name="Clear active graph"
                Classes="treeAction"
                Command="{Binding Graph.OpenClearGraphCommand}"
                ToolTip.Tip="Clear graph">
              <LucideIcon Kind="Eraser" Size="14" />
            </Button>
            <Button
              Grid.Column="7"
                AutomationProperties.Name="Delete saved graph"
                Classes="treeAction"
                Command="{Binding Graph.OpenDeleteGraphCommand}"
                ToolTip.Tip="Delete graph">
              <LucideIcon Kind="Trash" Size="14" />
            </Button>
            <Button
                Grid.Column="8"
                AutomationProperties.Name="Delete all saved graphs"
                Classes="treeAction"
                Command="{Binding Graph.OpenDeleteAllGraphsCommand}"
                ToolTip.Tip="Delete all graphs">
              <LucideIcon Kind="Trash" Size="14" />
            </Button>
            <Button
                Grid.Column="9"
                AutomationProperties.Name="Refresh graph state"
                Classes="treeAction"
                Command="{Binding Graph.RefreshCommand}"
                ToolTip.Tip="Refresh graph state">
              <LucideIcon Kind="RefreshCw" Size="14" />
            </Button>
          </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="280,*,320">
          <Border
              Grid.Column="0"
              Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource DecorativeDividerBrush}"
              BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
              <Grid Grid.Row="0" Margin="12,12,12,8" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                <TextBox
                    x:Name="GraphSearch"
                    Grid.Column="0"
                    AutomationProperties.Name="Find graph nodes"
                  desktop:EnterKeyCommand.Command="{Binding Graph.SearchCommand}"
                    Height="32"
                    Padding="10,0"
                    PlaceholderText="Find nodes"
                  Text="{Binding Graph.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    VerticalContentAlignment="Center" />
                <Button
                    Grid.Column="1"
                    AutomationProperties.Name="Search graph nodes"
                    Classes="treeAction"
                    Command="{Binding Graph.SearchCommand}"
                    ToolTip.Tip="Search nodes">
                  <LucideIcon Kind="Search" Size="14" />
                </Button>
              </Grid>
              <Border
                  Grid.Row="1"
                  Margin="12,0,12,8"
                  Padding="8,7"
                  Background="{DynamicResource SubtleSurfaceBrush}"
                  BorderBrush="{DynamicResource DecorativeDividerBrush}"
                  BorderThickness="1"
                  CornerRadius="5">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="5">
                  <TextBlock Classes="tertiary" FontSize="{DynamicResource TypeMetadataSize}" Text="{Binding Graph.SelectionCountText}" />
                  <TextBlock Grid.Column="1" FontSize="{DynamicResource TypeMetadataSize}" FontWeight="SemiBold" Text="{Binding Graph.NeighborhoodDepthText}" />
                  <Slider
                      Grid.Row="1"
                      AutomationProperties.Name="Graph connection depth"
                      IsSnapToTickEnabled="True"
                      Maximum="5"
                      Minimum="1"
                      TickFrequency="1"
                      Value="{Binding Graph.NeighborhoodDepth, Mode=TwoWay}" />
                  <Button
                      Grid.Row="1"
                      Grid.Column="1"
                      Padding="7,3"
                      AutomationProperties.Name="Load selected graph neighborhood"
                      Command="{Binding Graph.ReloadNeighborhoodCommand}"
                      ToolTip.Tip="Load selected neighborhood">
                    <LucideIcon Kind="Network" Size="13" />
                  </Button>
                  <TextBlock
                      Grid.Row="2"
                      Grid.ColumnSpan="2"
                      Classes="tertiary"
                      FontSize="{DynamicResource TypeMetadataSize}"
                      IsVisible="{Binding Graph.HasRouteStart}"
                      Text="{Binding Graph.RouteStartText}"
                      TextTrimming="CharacterEllipsis" />
                  <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="5">
                    <Button
                        Padding="7,3"
                        AutomationProperties.Name="Set selected node as route start"
                        Command="{Binding Graph.SetRouteStartCommand}"
                        CommandParameter="{Binding Graph.SelectedEntity}">
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <LucideIcon Kind="MapPin" Size="12" />
                        <TextBlock FontSize="{DynamicResource TypeMetadataSize}" Text="Set start" />
                      </StackPanel>
                    </Button>
                    <Button
                        Padding="7,3"
                        AutomationProperties.Name="Show routes to selected node"
                        Command="{Binding Graph.ShowRoutesToNodeCommand}"
                        CommandParameter="{Binding Graph.SelectedEntity}">
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <LucideIcon Kind="Route" Size="12" />
                        <TextBlock FontSize="{DynamicResource TypeMetadataSize}" Text="Show routes" />
                      </StackPanel>
                    </Button>
                    <Button
                        AutomationProperties.Name="Clear route start"
                        Classes="treeAction"
                        Command="{Binding Graph.ClearRouteStartCommand}"
                        IsVisible="{Binding Graph.HasRouteStart}"
                        ToolTip.Tip="Clear route start">
                      <LucideIcon Kind="X" Size="12" />
                    </Button>
                  </StackPanel>
                </Grid>
              </Border>
              <TextBlock
                  Grid.Row="2"
                  Margin="14,0,14,6"
                  Classes="sectionLabel"
                  Text="SEARCH RESULTS" />
              <ListBox
                  Grid.Row="3"
                  Margin="6,0,6,8"
                  AutomationProperties.Name="Graph node search results"
                  Background="Transparent"
                  BorderThickness="0"
                  ItemsSource="{Binding Graph.SearchResults}"
                  SelectedItem="{Binding Graph.SelectedSearchResult, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="graph:GraphEntitySummary">
                    <Grid MinWidth="244" MinHeight="52" Margin="5,2" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <TextBlock Grid.Row="0" Grid.Column="0" FontSize="{DynamicResource TypeCompactSize}" FontWeight="SemiBold" Text="{Binding DisplayLabel}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Row="0" Grid.Column="1" Classes="tertiary" FontSize="{DynamicResource TypeMetadataSize}" Text="{Binding Degree}" />
                      <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Classes="muted" FontSize="{DynamicResource TypeMetadataSize}" Text="{Binding Entity}" TextTrimming="CharacterEllipsis" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBlock
                  Grid.Row="4"
                  Margin="12,4,12,10"
                  Classes="tertiary"
                  FontSize="{DynamicResource TypeMetadataSize}"
                  Text="{Binding Graph.StatusText}"
                  TextWrapping="Wrap" />
            </Grid>
          </Border>

          <Grid Grid.Column="1" Background="{DynamicResource CanvasBrush}" RowDefinitions="Auto,*">
            <Border
                Grid.Row="0"
                Padding="10,8"
                Background="{DynamicResource ToolbarSurfaceBrush}"
                BorderBrush="{DynamicResource DecorativeDividerBrush}"
                BorderThickness="0,0,0,1">
              <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="7" RowSpacing="5">
                <Grid Grid.Row="0" Grid.ColumnSpan="3" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                  <TextBlock Classes="sectionLabel" Text="OPENCYPHER" />
                  <TextBlock Grid.Column="1" Classes="tertiary" FontSize="{DynamicResource TypeMetadataSize}" Text="{Binding Graph.CypherResultSummary}" TextTrimming="CharacterEllipsis" />
                </Grid>
                <TextBox
                    x:Name="GraphCypherEditor"
                    Grid.Row="1"
                    Grid.Column="0"
                    MinHeight="66"
                    MaxHeight="112"
                    AcceptsReturn="True"
                    AutomationProperties.Name="OpenCypher graph query"
                    FontFamily="Cascadia Code, JetBrains Mono, Noto Sans Mono, monospace"
                    FontSize="{DynamicResource TypeCompactSize}"
                    Text="{Binding Graph.CypherText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="NoWrap" />
                <Button
                    Grid.Row="1"
                    Grid.Column="1"
                    VerticalAlignment="Bottom"
                    Classes="command"
                    Command="{Binding Graph.CancelCypherCommand}"
                    Content="Cancel"
                    IsVisible="{Binding Graph.IsCypherRunning}" />
                <Button
                    Grid.Row="1"
                    Grid.Column="2"
                    VerticalAlignment="Bottom"
                    AutomationProperties.Name="Run openCypher query"
                    Classes="primaryCommand"
                    Command="{Binding Graph.RunCypherCommand}"
                    Content="Run" />
              </Grid>
            </Border>

            <Grid x:Name="GraphViewport" Grid.Row="1" Background="{DynamicResource CanvasBrush}">
            <desktop:DeferredContentControl
                IsContentMaterialized="{Binding Graph.HasLayout}"
                IsVisible="{Binding Graph.HasLayout}"
                RetainContent="True">
              <desktop:DeferredContentControl.ContentTemplate>
                <DataTemplate x:DataType="presentation:MainWindowViewModel">
                  <Grid Loaded="OnGraphLayoutLoaded">
                    <controls:KustoGraphControl
                x:Name="GraphCanvas"
              AutomationProperties.HelpText="Use arrow keys to navigate nodes, Enter to select, plus or minus to zoom, and zero to fit"
                AutomationProperties.Name="Investigation graph canvas"
                ContextEntity="{Binding Graph.ContextEntity, Mode=TwoWay}"
                IsVisible="{Binding Graph.HasLayout}"
                Layout="{Binding Graph.Layout}"
                SelectedEntities="{Binding Graph.SelectedEntities}"
                SelectedEntity="{Binding Graph.SelectedEntity, Mode=TwoWay}"
                SelectedRelationship="{Binding Graph.SelectedRelationship, Mode=TwoWay}">
              <controls:KustoGraphControl.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Expand one level" Command="{Binding Graph.ExpandNodeCommand}" CommandParameter="{Binding Graph.ContextEntity}">
                    <MenuItem.Icon><LucideIcon Kind="Network" Size="13" /></MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Header="Select only this node" Command="{Binding Graph.SelectOnlyNodeCommand}" CommandParameter="{Binding Graph.ContextEntity}">
                    <MenuItem.Icon><LucideIcon Kind="MousePointer2" Size="13" /></MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Header="Change visible label..." Command="{Binding Graph.OpenNodeLabelEditorCommand}" CommandParameter="{Binding Graph.ContextEntity}">
                    <MenuItem.Icon><LucideIcon Kind="Pencil" Size="13" /></MenuItem.Icon>
                  </MenuItem>
                  <Separator />
                  <MenuItem Header="Start route here" Command="{Binding Graph.SetRouteStartCommand}" CommandParameter="{Binding Graph.ContextEntity}">
                    <MenuItem.Icon><LucideIcon Kind="MapPin" Size="13" /></MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Header="Show routes to this node" Command="{Binding Graph.ShowRoutesToNodeCommand}" CommandParameter="{Binding Graph.ContextEntity}">
                    <MenuItem.Icon><LucideIcon Kind="Route" Size="13" /></MenuItem.Icon>
                  </MenuItem>
                  <Separator />
                  <MenuItem Header="Keep only connected to selection" Command="{Binding Graph.KeepConnectedCommand}">
                    <MenuItem.Icon><LucideIcon Kind="ListFilter" Size="13" /></MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Header="Hide this node" Command="{Binding Graph.HideNodeCommand}" CommandParameter="{Binding Graph.ContextEntity}">
                    <MenuItem.Icon><LucideIcon Kind="EyeOff" Size="13" /></MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Header="Hide this node type" Command="{Binding Graph.HideTypeCommand}" CommandParameter="{Binding Graph.ContextEntity}">
                    <MenuItem.Icon><LucideIcon Kind="Tags" Size="13" /></MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Header="Prune incoming chain from view" Command="{Binding Graph.PruneUpstreamCommand}" CommandParameter="{Binding Graph.ContextEntity}">
                    <MenuItem.Icon><LucideIcon Kind="GitBranch" Size="13" /></MenuItem.Icon>
                  </MenuItem>
                  <Separator />
                  <MenuItem Header="Reset view filters" Command="{Binding Graph.ResetFiltersCommand}">
                    <MenuItem.Icon><LucideIcon Kind="RotateCcw" Size="13" /></MenuItem.Icon>
                  </MenuItem>
                </ContextMenu>
              </controls:KustoGraphControl.ContextMenu>
            </controls:KustoGraphControl>

            <Border
                MaxWidth="240"
                Margin="12,12,0,0"
                Padding="10,8"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                AutomationProperties.Name="Graph type legend"
                Background="{DynamicResource RaisedSurfaceBrush}"
                BorderBrush="{DynamicResource ControlBoundaryBrush}"
                BorderThickness="1"
                CornerRadius="5"
                IsVisible="{Binding Graph.HasLegendItems}">
              <StackPanel Spacing="7">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <LucideIcon Kind="Tags" Size="13" Foreground="{DynamicResource TextSecondaryBrush}" />
                  <TextBlock Classes="sectionLabel" Text="TYPE LEGEND" />
                </StackPanel>
                <ScrollViewer MaxHeight="150" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                  <ItemsControl ItemsSource="{Binding Graph.LegendItems}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="presentation:GraphTypeLegendItem">
                        <Grid MinHeight="24" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="7">
                          <Border
                              Width="13"
                              Height="13"
                              VerticalAlignment="Center"
                              Background="{Binding ColorHex}"
                              BorderBrush="{DynamicResource ControlBoundaryBrush}"
                              BorderThickness="1"
                              CornerRadius="3" />
                          <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="{DynamicResource TypeSmallSize}" Text="{Binding TypeName}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="2" VerticalAlignment="Center" Classes="tertiary" FontSize="{DynamicResource TypeMetadataSize}" Text="{Binding NodeCount}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </StackPanel>
            </Border>

            <Border
                MaxWidth="620"
                Margin="12,0,12,12"
                Padding="10,8"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                AutomationProperties.Name="{Binding Graph.HiddenItemsText}"
                Background="{DynamicResource RaisedSurfaceBrush}"
                BorderBrush="{DynamicResource WarningBrush}"
                BorderThickness="1"
                CornerRadius="5"
                IsVisible="{Binding Graph.HasHiddenItems}">
              <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="9" RowSpacing="7">
                <LucideIcon
                    Grid.RowSpan="2"
                    VerticalAlignment="Top"
                    Foreground="{DynamicResource WarningBrush}"
                    Kind="EyeOff"
                    Size="16" />
                <StackPanel Grid.Column="1" Spacing="2">
                  <TextBlock FontSize="{DynamicResource TypeCompactSize}" FontWeight="SemiBold" Text="{Binding Graph.HiddenItemsText}" TextWrapping="Wrap" />
                  <TextBlock Classes="muted" FontSize="{DynamicResource TypeMetadataSize}" Text="{Binding Graph.HiddenItemsHelpText}" TextWrapping="Wrap" />
                </StackPanel>
                <WrapPanel Grid.Row="1" Grid.Column="1">
                  <Button
                      Margin="0,0,6,0"
                      Padding="8,4"
                      AutomationProperties.Name="Expand graph overview"
                      Command="{Binding Graph.ShowMoreCommand}"
                      IsVisible="{Binding Graph.CanShowMore}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <LucideIcon Kind="Scan" Size="12" />
                      <TextBlock FontSize="{DynamicResource TypeSmallSize}" Text="{Binding Graph.ShowMoreButtonText}" />
                    </StackPanel>
                  </Button>
                  <Button
                      Padding="8,4"
                      AutomationProperties.Name="Return to graph overview"
                      Command="{Binding Graph.ShowOverviewCommand}"
                      IsVisible="{Binding Graph.CanShowOverview}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <LucideIcon Kind="LayoutDashboard" Size="12" />
                      <TextBlock FontSize="{DynamicResource TypeSmallSize}" Text="Overview" />
                    </StackPanel>
                  </Button>
                  <Button
                      Margin="6,0,0,0"
                      Padding="8,4"
                      AutomationProperties.Name="Reset graph view filters"
                      Command="{Binding Graph.ResetFiltersCommand}"
                      IsVisible="{Binding Graph.HasViewFilters}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <LucideIcon Kind="RotateCcw" Size="12" />
                      <TextBlock FontSize="{DynamicResource TypeSmallSize}" Text="Reset filters" />
                    </StackPanel>
                  </Button>
                </WrapPanel>
              </Grid>
            </Border>

            <Border
              x:Name="GraphViewportToolbar"
                Margin="0,12,12,0"
                Padding="4"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Background="{DynamicResource RaisedSurfaceBrush}"
                BorderBrush="{DynamicResource ControlBoundaryBrush}"
                BorderThickness="1"
                CornerRadius="5"
                IsVisible="{Binding Graph.HasLayout}">
              <StackPanel Orientation="Horizontal" Spacing="2">
                <Button
                    AutomationProperties.Name="Save graph as PNG"
                    Classes="treeAction"
                    Click="OnSaveGraphPngClick"
                    ToolTip.Tip="Save graph as PNG">
                  <LucideIcon Kind="Download" Size="14" />
                </Button>
                <Button
                    AutomationProperties.Name="Save graph as GraphML"
                    Classes="treeAction"
                    Click="OnSaveGraphMlClick"
                    ToolTip.Tip="Save graph as GraphML">
                  <LucideIcon Kind="GitGraph" Size="14" />
                </Button>
                <Button
                    AutomationProperties.Name="Zoom graph out"
                    Classes="treeAction"
                    Click="OnGraphZoomOutClick"
                    ToolTip.Tip="Zoom out">
                  <LucideIcon Kind="ZoomOut" Size="14" />
                </Button>
                <Button
                    AutomationProperties.Name="Zoom graph in"
                    Classes="treeAction"
                    Click="OnGraphZoomInClick"
                    ToolTip.Tip="Zoom in">
                  <LucideIcon Kind="ZoomIn" Size="14" />
                </Button>
                <Button
                    AutomationProperties.Name="Fit graph to view"
                    Classes="treeAction"
                    Click="OnGraphFitClick"
                    ToolTip.Tip="Fit to view">
                  <LucideIcon Kind="Maximize2" Size="14" />
                </Button>
                <Button
                    AutomationProperties.Name="Reset graph layout"
                    Classes="treeAction"
                    Click="OnGraphResetLayoutClick"
                    ToolTip.Tip="Reset automatic layout">
                  <LucideIcon Kind="RefreshCw" Size="14" />
                </Button>
              </StackPanel>
                    </Border>
                  </Grid>
                </DataTemplate>
              </desktop:DeferredContentControl.ContentTemplate>
            </desktop:DeferredContentControl>

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsVisible="{Binding Graph.ShowEmptyGraphState}"
                Spacing="7">
              <LucideIcon HorizontalAlignment="Center" Kind="GitGraph" Size="28" Foreground="{DynamicResource TextTertiaryBrush}" />
              <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="No graph data yet" />
              <TextBlock Classes="muted" FontSize="{DynamicResource TypeCompactSize}" Text="Run a make-graph query to begin an investigation" />
            </StackPanel>

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsVisible="{Binding Graph.ShowLayoutPlaceholder}"
                Spacing="7">
              <ProgressBar Width="180" IsIndeterminate="True" IsVisible="{Binding Graph.IsBusy}" />
              <TextBlock Classes="muted" Text="{Binding Graph.StatusText}" />
            </StackPanel>

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsVisible="{Binding Graph.HasEmptyCypherResult}"
                Spacing="7">
              <LucideIcon HorizontalAlignment="Center" Kind="SearchX" Size="24" Foreground="{DynamicResource TextTertiaryBrush}" />
              <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="No graph matches" />
            </StackPanel>

            <Border
                MinWidth="260"
                Padding="16,14"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                AutomationProperties.Name="Finding graph routes"
                Background="{DynamicResource RaisedSurfaceBrush}"
                BorderBrush="{DynamicResource ControlBoundaryBrush}"
                BorderThickness="1"
                CornerRadius="5"
                IsVisible="{Binding Graph.IsFindingRoutes}">
              <StackPanel Spacing="9">
                <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="Finding routes" />
                <ProgressBar Width="200" Height="4" IsIndeterminate="True" />
                <TextBlock
                    MaxWidth="300"
                    HorizontalAlignment="Center"
                    Classes="muted"
                    FontSize="{DynamicResource TypeSmallSize}"
                    Text="{Binding Graph.StatusText}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <Button
                    HorizontalAlignment="Center"
                    AutomationProperties.Name="Cancel graph route search"
                    Classes="command"
                    Command="{Binding Graph.CancelRouteCommand}"
                    Content="Cancel" />
              </StackPanel>
            </Border>
            </Grid>
          </Grid>

          <GridSplitter
              Grid.Column="2"
              Width="4"
              HorizontalAlignment="Left"
              Background="{DynamicResource DecorativeDividerBrush}"
              ResizeDirection="Columns" />

          <Border
              Grid.Column="2"
              AutomationProperties.Name="Graph evidence inspector"
              Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource DecorativeDividerBrush}"
              BorderThickness="1,0,0,0">
            <Grid RowDefinitions="42,*">
              <Border
                  Grid.Row="0"
                  BorderBrush="{DynamicResource DecorativeDividerBrush}"
                  BorderThickness="0,0,0,1">
                <Grid Margin="14,0" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                  <LucideIcon VerticalAlignment="Center" Kind="Info" Size="14" Foreground="{DynamicResource TextSecondaryBrush}" />
                  <TextBlock
                      Grid.Column="1"
                      VerticalAlignment="Center"
                      Classes="sectionLabel"
                      Text="{Binding Graph.InspectorTitle}" />
                </Grid>
              </Border>

              <Grid Grid.Row="1">
                <desktop:DeferredContentControl
                    IsContentMaterialized="{Binding Graph.HasInspectorSelection}"
                    IsVisible="{Binding Graph.HasInspectorSelection}"
                    RetainContent="True">
                  <desktop:DeferredContentControl.ContentTemplate>
                    <DataTemplate x:DataType="presentation:MainWindowViewModel">
                      <Grid>
                        <ScrollViewer
                    HorizontalScrollBarVisibility="Disabled"
                    IsVisible="{Binding Graph.HasSelectedEntityDetails}"
                    VerticalScrollBarVisibility="Auto">
                  <StackPanel Margin="14,14,14,18" Spacing="10">
                    <TextBlock
                        FontSize="{DynamicResource TypeSubheadingSize}"
                        FontWeight="SemiBold"
                        Text="{Binding Graph.SelectedEntityDetails.Summary.DisplayLabel}"
                        TextWrapping="Wrap" />

                    <TextBlock Classes="sectionLabel" Text="IDENTITY" />
                    <Grid ColumnDefinitions="92,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="7">
                      <TextBlock Grid.Row="0" Classes="tertiary" FontSize="{DynamicResource TypeSmallSize}" Text="Type" />
                      <TextBlock Grid.Row="0" Grid.Column="1" FontSize="{DynamicResource TypeSmallSize}" Text="{Binding Graph.SelectedEntityDetails.Summary.Entity.TypeName}" TextWrapping="Wrap" />
                      <TextBlock Grid.Row="1" Classes="tertiary" FontSize="{DynamicResource TypeSmallSize}" Text="Category" />
                      <TextBlock Grid.Row="1" Grid.Column="1" FontSize="{DynamicResource TypeSmallSize}" Text="{Binding Graph.SelectedEntityDetails.Summary.Entity.Kind}" />
                      <TextBlock Grid.Row="2" Classes="tertiary" FontSize="{DynamicResource TypeSmallSize}" Text="Canonical ID" />
                      <TextBlock
                          Grid.Row="2"
                          Grid.Column="1"
                          FontFamily="Cascadia Code, JetBrains Mono, Noto Sans Mono, monospace"
                          FontSize="{DynamicResource TypeMetadataSize}"
                          Text="{Binding Graph.SelectedEntityDetails.Summary.Entity.CanonicalId}"
                          TextWrapping="Wrap" />
                      <TextBlock Grid.Row="3" Classes="tertiary" FontSize="{DynamicResource TypeSmallSize}" Text="Namespace" />
                      <TextBlock Grid.Row="3" Grid.Column="1" FontSize="{DynamicResource TypeSmallSize}" Text="{Binding Graph.SelectedEntityNamespaceText}" TextWrapping="Wrap" />
                    </Grid>

                    <Border Height="1" Background="{DynamicResource DecorativeDividerBrush}" />
                    <TextBlock Classes="sectionLabel" Text="ACTIVITY" />
                    <Grid ColumnDefinitions="92,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="7">
                      <TextBlock Grid.Row="0" Classes="tertiary" FontSize="{DynamicResource TypeSmallSize}" Text="Connections" />
                      <TextBlock Grid.Row="0" Grid.Column="1" FontSize="{DynamicResource TypeSmallSize}" Text="{Binding Graph.SelectedEntityDetails.Summary.Degree}" />
                      <TextBlock Grid.Row="1" Classes="tertiary" FontSize="{DynamicResource TypeSmallSize}" Text="Observations" />
                      <TextBlock Grid.Row="1" Grid.Column="1" FontSize="{DynamicResource TypeSmallSize}" Text="{Binding Graph.SelectedEntityDetails.ObservationCount}" />
                      <TextBlock Grid.Row="2" Classes="tertiary" FontSize="{DynamicResource TypeSmallSize}" Text="Evidence rows" />
                      <TextBlock Grid.Row="2" Grid.Column="1" FontSize="{DynamicResource TypeSmallSize}" Text="{Binding Graph.SelectedEntityDetails.EvidenceCount}" />
                      <TextBlock Grid.Row="3" Classes="tertiary" FontSize="{DynamicResource TypeSmallSize}" Text="First seen" />
                      <TextBlock Grid.Row="3" Grid.Column="1" FontSize="{DynamicResource TypeSmallSize}" Text="{Binding Graph.SelectedEntityFirstSeenText}" TextWrapping="Wrap" />
                      <TextBlock Grid.Row="4" Classes="tertiary" FontSize="{DynamicResource TypeSmallSize}" Text="Last updated" />
                      <TextBlock Grid.Row="4" Grid.Column="1" FontSize="{DynamicResource TypeSmallSize}" Text="{Binding Graph.SelectedEntityLastUpdatedText}" TextWrapping="Wrap" />
                    </Grid>

                    <StackPanel IsVisible="{Binding Graph.HasSelectedEntitySourceLabels}" Spacing="7">
                      <Border Height="1" Background="{DynamicResource DecorativeDividerBrush}" />
                      <TextBlock Classes="sectionLabel" Text="SOURCE LABELS" />
                      <TextBlock FontSize="{DynamicResource TypeSmallSize}" Text="{Binding Graph.SelectedEntitySourceLabelsText}" TextWrapping="Wrap" />
                    </StackPanel>

                    <Border Height="1" Background="{DynamicResource DecorativeDividerBrush}" />
                    <TextBlock Classes="sectionLabel" Text="SOURCE PROPERTIES" />
                    <ItemsControl
                        IsVisible="{Binding Graph.HasSelectedEntityProperties}"
                        ItemsSource="{Binding Graph.SelectedEntityDetails.Properties}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="graph:GraphEntityProperty">
                          <Grid Margin="0,2,0,7" RowDefinitions="Auto,Auto" RowSpacing="3">
                            <Grid.ContextMenu>
                              <ContextMenu>
                                <MenuItem Header="Copy" CommandParameter="{Binding Value}" Click="OnCopyGraphInspectorTextClick" />
                              </ContextMenu>
                            </Grid.ContextMenu>
                            <TextBlock Classes="tertiary" FontSize="{DynamicResource TypeMetadataSize}" Text="{Binding Name}" TextWrapping="Wrap" />
                            <TextBlock
                                Grid.Row="1"
                                FontFamily="Cascadia Code, JetBrains Mono, Noto Sans Mono, monospace"
                                FontSize="{DynamicResource TypeMetadataSize}"
                                Text="{Binding Value}"
                                TextWrapping="Wrap" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock
                        Classes="muted"
                        FontSize="{DynamicResource TypeSmallSize}"
                        IsVisible="{Binding Graph.HasNoSelectedEntityProperties}"
                        Text="No retained source properties" />

                    <StackPanel IsVisible="{Binding Graph.HasSelectedEntityEvidence}" Spacing="7">
                      <Border Height="1" Background="{DynamicResource DecorativeDividerBrush}" />
                      <TextBlock Classes="sectionLabel" Text="SUPPORTING EVIDENCE" />
                      <TextBlock Classes="tertiary" FontSize="{DynamicResource TypeMetadataSize}" Text="{Binding Graph.SelectedEntityEvidenceSummary}" />
                      <ItemsControl ItemsSource="{Binding Graph.SelectedEntityDetails.Evidence}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="graph:GraphEvidenceRecord">
                            <Border Margin="0,2,0,7" Padding="8" Background="{DynamicResource SubtleSurfaceBrush}" BorderBrush="{DynamicResource DecorativeDividerBrush}" BorderThickness="1" CornerRadius="4">
                              <StackPanel Spacing="5">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                  <TextBlock FontSize="{DynamicResource TypeSmallSize}" FontWeight="SemiBold" Text="{Binding SourceName}" TextTrimming="CharacterEllipsis" />
                                  <TextBlock Grid.Column="1" Classes="tertiary" FontSize="{DynamicResource TypeMetadataSize}" Text="{Binding SourceKind}" />
                                </Grid>
                                <TextBlock Classes="tertiary" FontSize="{DynamicResource TypeMetadataSize}" Text="{Binding ClusterUri}" TextWrapping="Wrap" />
                                <TextBlock Classes="tertiary" FontSize="{DynamicResource TypeMetadataSize}" Text="{Binding DatabaseName}" TextWrapping="Wrap" />
                                <TextBlock Classes="tertiary" FontSize="{DynamicResource TypeMicroSize}" Text="{Binding DiscoveredAtUtc}" />
                                <TextBlock Classes="sectionLabel" Text="QUERY" />
                                <TextBlock FontFamily="Cascadia Code, JetBrains Mono, Noto Sans Mono, monospace" FontSize="{DynamicResource TypeMetadataSize}" Text="{Binding QueryText}" TextWrapping="Wrap" />
                                <TextBlock Classes="sectionLabel" Text="RAW ROW" />
                                <TextBlock FontFamily="Cascadia Code, JetBrains Mono, Noto Sans Mono, monospace" FontSize="{DynamicResource TypeMetadataSize}" Text="{Binding RowJson}" TextWrapping="Wrap" />
                                <TextBlock Classes="tertiary" FontSize="{DynamicResource TypeMicroSize}" Text="{Binding TableName}" />
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer
                    HorizontalScrollBarVisibility="Disabled"
                    IsVisible="{Binding Graph.HasSelectedRelationshipDetails}"
                    VerticalScrollBarVisibility="Auto">
                  <StackPanel Margin="14,14,14,18" Spacing="10">
                    <TextBlock FontSize="{DynamicResource TypeSubheadingSize}" FontWeight="SemiBold" Text="{Binding Graph.SelectedRelationshipTypeText}" TextWrapping="Wrap" />

                    <TextBlock Classes="sectionLabel" Text="RELATIONSHIP" />
                    <Grid ColumnDefinitions="70,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="7">
                      <TextBlock Classes="tertiary" FontSize="{DynamicResource TypeSmallSize}" Text="Source" />
                      <TextBlock Grid.Column="1" FontFamily="Cascadia Code, JetBrains Mono, Noto Sans Mono, monospace" FontSize="{DynamicResource TypeMetadataSize}" Text="{Binding Graph.SelectedRelationshipSourceText}" TextWrapping="Wrap" />
                      <TextBlock Grid.Row="1" Classes="tertiary" FontSize="{DynamicResource TypeSmallSize}" Text="Type" />
                      <TextBlock Grid.Row="1" Grid.Column="1" FontSize="{DynamicResource TypeSmallSize}" Text="{Binding Graph.SelectedRelationshipTypeText}" TextWrapping="Wrap" />
                      <TextBlock Grid.Row="2" Classes="tertiary" FontSize="{DynamicResource TypeSmallSize}" Text="Target" />
                      <TextBlock Grid.Row="2" Grid.Column="1" FontFamily="Cascadia Code, JetBrains Mono, Noto Sans Mono, monospace" FontSize="{DynamicResource TypeMetadataSize}" Text="{Binding Graph.SelectedRelationshipTargetText}" TextWrapping="Wrap" />
                    </Grid>

                    <Border Height="1" Background="{DynamicResource DecorativeDividerBrush}" />
                    <TextBlock Classes="sectionLabel" Text="ACTIVITY" />
                    <Grid ColumnDefinitions="92,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="7">
                      <TextBlock Classes="tertiary" FontSize="{DynamicResource TypeSmallSize}" Text="Observations" />
                      <TextBlock Grid.Column="1" FontSize="{DynamicResource TypeSmallSize}" Text="{Binding Graph.SelectedRelationshipDetails.ObservationCount}" />
                      <TextBlock Grid.Row="1" Classes="tertiary" FontSize="{DynamicResource TypeSmallSize}" Text="Evidence rows" />
                      <TextBlock Grid.Row="1" Grid.Column="1" FontSize="{DynamicResource TypeSmallSize}" Text="{Binding Graph.SelectedRelationshipDetails.EvidenceCount}" />
                      <TextBlock Grid.Row="2" Classes="tertiary" FontSize="{DynamicResource TypeSmallSize}" Text="First seen" />
                      <TextBlock Grid.Row="2" Grid.Column="1" FontSize="{DynamicResource TypeSmallSize}" Text="{Binding Graph.SelectedRelationshipFirstSeenText}" TextWrapping="Wrap" />
                      <TextBlock Grid.Row="3" Classes="tertiary" FontSize="{DynamicResource TypeSmallSize}" Text="Last updated" />
                      <TextBlock Grid.Row="3" Grid.Column="1" FontSize="{DynamicResource TypeSmallSize}" Text="{Binding Graph.SelectedRelationshipLastUpdatedText}" TextWrapping="Wrap" />
                    </Grid>

                    <StackPanel IsVisible="{Binding Graph.HasSelectedRelationshipSourceLabels}" Spacing="7">
                      <Border Height="1" Background="{DynamicResource DecorativeDividerBrush}" />
                      <TextBlock Classes="sectionLabel" Text="SOURCE LABELS" />
                      <TextBlock FontSize="{DynamicResource TypeSmallSize}" Text="{Binding Graph.SelectedRelationshipSourceLabelsText}" TextWrapping="Wrap" />
                    </StackPanel>

                    <Border Height="1" Background="{DynamicResource DecorativeDividerBrush}" />
                    <TextBlock Classes="sectionLabel" Text="SOURCE PROPERTIES" />
                    <ItemsControl IsVisible="{Binding Graph.HasSelectedRelationshipProperties}" ItemsSource="{Binding Graph.SelectedRelationshipDetails.Properties}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="graph:GraphEntityProperty">
                          <Grid Margin="0,2,0,7" RowDefinitions="Auto,Auto" RowSpacing="3">
                            <Grid.ContextMenu>
                              <ContextMenu>
                                <MenuItem Header="Copy" CommandParameter="{Binding Value}" Click="OnCopyGraphInspectorTextClick" />
                              </ContextMenu>
                            </Grid.ContextMenu>
                            <TextBlock Classes="tertiary" FontSize="{DynamicResource TypeMetadataSize}" Text="{Binding Name}" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="1" FontFamily="Cascadia Code, JetBrains Mono, Noto Sans Mono, monospace" FontSize="{DynamicResource TypeMetadataSize}" Text="{Binding Value}" TextWrapping="Wrap" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Classes="muted" FontSize="{DynamicResource TypeSmallSize}" IsVisible="{Binding Graph.HasNoSelectedRelationshipProperties}" Text="No retained source properties" />

                    <StackPanel IsVisible="{Binding Graph.HasSelectedRelationshipEvidence}" Spacing="7">
                      <Border Height="1" Background="{DynamicResource DecorativeDividerBrush}" />
                      <TextBlock Classes="sectionLabel" Text="SUPPORTING EVIDENCE" />
                      <TextBlock Classes="tertiary" FontSize="{DynamicResource TypeMetadataSize}" Text="{Binding Graph.SelectedRelationshipEvidenceSummary}" />
                      <ItemsControl ItemsSource="{Binding Graph.SelectedRelationshipDetails.Evidence}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="graph:GraphEvidenceRecord">
                            <Border Margin="0,2,0,7" Padding="8" Background="{DynamicResource SubtleSurfaceBrush}" BorderBrush="{DynamicResource DecorativeDividerBrush}" BorderThickness="1" CornerRadius="4">
                              <StackPanel Spacing="5">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                  <TextBlock FontSize="{DynamicResource TypeSmallSize}" FontWeight="SemiBold" Text="{Binding SourceName}" TextTrimming="CharacterEllipsis" />
                                  <TextBlock Grid.Column="1" Classes="tertiary" FontSize="{DynamicResource TypeMetadataSize}" Text="{Binding SourceKind}" />
                                </Grid>
                                <TextBlock Classes="tertiary" FontSize="{DynamicResource TypeMetadataSize}" Text="{Binding ClusterUri}" TextWrapping="Wrap" />
                                <TextBlock Classes="tertiary" FontSize="{DynamicResource TypeMetadataSize}" Text="{Binding DatabaseName}" TextWrapping="Wrap" />
                                <TextBlock Classes="tertiary" FontSize="{DynamicResource TypeMicroSize}" Text="{Binding DiscoveredAtUtc}" />
                                <TextBlock Classes="sectionLabel" Text="QUERY" />
                                <TextBlock FontFamily="Cascadia Code, JetBrains Mono, Noto Sans Mono, monospace" FontSize="{DynamicResource TypeMetadataSize}" Text="{Binding QueryText}" TextWrapping="Wrap" />
                                <TextBlock Classes="sectionLabel" Text="RAW ROW" />
                                <TextBlock FontFamily="Cascadia Code, JetBrains Mono, Noto Sans Mono, monospace" FontSize="{DynamicResource TypeMetadataSize}" Text="{Binding RowJson}" TextWrapping="Wrap" />
                                <TextBlock Classes="tertiary" FontSize="{DynamicResource TypeMicroSize}" Text="{Binding TableName}" />
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </StackPanel>
                        </ScrollViewer>
                      </Grid>
                    </DataTemplate>
                  </desktop:DeferredContentControl.ContentTemplate>
                </desktop:DeferredContentControl>

                <StackPanel
                    HorizontalAlignment="Center"
                    IsVisible="{Binding Graph.IsInspectorDetailsLoading}"
                    Spacing="8"
                    VerticalAlignment="Center">
                  <ProgressBar Width="120" IsIndeterminate="True" />
                  <TextBlock Classes="muted" FontSize="{DynamicResource TypeSmallSize}" Text="Loading graph evidence" />
                </StackPanel>

                <StackPanel
                    Margin="28"
                    HorizontalAlignment="Center"
                    IsVisible="{Binding Graph.HasInspectorDetailsError}"
                    Spacing="7"
                    VerticalAlignment="Center">
                  <LucideIcon HorizontalAlignment="Center" Kind="CircleAlert" Size="20" Foreground="{DynamicResource ErrorBrush}" />
                  <TextBlock Classes="muted" FontSize="{DynamicResource TypeSmallSize}" Text="{Binding Graph.InspectorDetailsError}" TextAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel
                    HorizontalAlignment="Center"
                    IsVisible="{Binding !Graph.HasInspectorSelection}"
                    Spacing="7"
                    VerticalAlignment="Center">
                  <LucideIcon HorizontalAlignment="Center" Kind="MousePointer2" Size="20" Foreground="{DynamicResource TextTertiaryBrush}" />
                  <TextBlock Classes="muted" FontSize="{DynamicResource TypeSmallSize}" Text="Select a node or relationship" />
                </StackPanel>
              </Grid>
            </Grid>
          </Border>
        </Grid>
      </Grid>

      <Border
          Grid.Column="2"
          Width="36"
          AutomationProperties.Name="Copilot sidebar rail"
          Background="{DynamicResource ChromeSurfaceBrush}"
          BorderBrush="{DynamicResource DecorativeDividerBrush}"
          BorderThickness="1,0,0,0"
          IsVisible="{Binding !IsCopilotPanelOpen}">
        <Button
            x:Name="CopilotExpandButton"
            Margin="5,8,5,0"
            VerticalAlignment="Top"
            AutomationProperties.Name="Open Copilot sidebar"
            Classes="treeAction"
            Command="{Binding ToggleCopilotPanelCommand}"
            ToolTip.Tip="Open Copilot">
          <Grid>
            <LucideIcon Kind="PanelRightOpen" Size="15" IsVisible="{Binding !IsCopilotWorking}" />
            <LucideIcon
                AutomationProperties.Name="Copilot is working"
                Classes="copilotSpinner"
                Foreground="{DynamicResource AccentBrush}"
                IsVisible="{Binding IsCopilotWorking}"
                Kind="LoaderCircle"
                Size="16"
                ToolTip.Tip="Copilot is working; open sidebar" />
          </Grid>
        </Button>
      </Border>

      <Border
          x:Name="CopilotPanel"
          Grid.Column="2"
          Width="440"
          Background="{DynamicResource RaisedSurfaceBrush}"
          BorderBrush="{DynamicResource DecorativeDividerBrush}"
          BorderThickness="1,0,0,0"
          IsVisible="{Binding IsCopilotPanelOpen}">
        <Grid RowDefinitions="52,Auto,*,Auto,Auto">
          <Grid Grid.Row="0" Margin="12,0,6,0" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="4">
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="0">
              <TextBlock FontWeight="SemiBold" Text="{Binding CopilotTitle}" />
              <TextBlock Classes="tertiary" FontSize="{DynamicResource TypeMetadataSize}" Text="{Binding CopilotSubtitle}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <LucideIcon
                Grid.Column="1"
                Margin="5"
                VerticalAlignment="Center"
                AutomationProperties.Name="Copilot is working"
                Classes="copilotSpinner"
                Foreground="{DynamicResource AccentBrush}"
                IsVisible="{Binding IsCopilotWorking}"
                Kind="LoaderCircle"
                Size="15"
                ToolTip.Tip="Copilot is working" />
            <Button
                Grid.Column="2"
                AutomationProperties.Name="Clear Copilot conversation"
                Classes="treeAction"
                Command="{Binding Copilot.ClearCommand}"
                ToolTip.Tip="Clear conversation">
              <LucideIcon Kind="Trash" Size="13" />
            </Button>
            <Button
              Grid.Column="3"
                AutomationProperties.Name="Close Copilot sidebar"
                Classes="treeAction"
                Command="{Binding CloseCopilotPanelCommand}"
                ToolTip.Tip="Close Copilot">
              <LucideIcon Kind="PanelRightClose" Size="14" />
            </Button>
          </Grid>

          <Border
              Grid.Row="1"
              Padding="10,7"
              Background="{DynamicResource ToolbarSurfaceBrush}"
              BorderBrush="{DynamicResource DecorativeDividerBrush}"
              BorderThickness="0,1,0,1">
            <StackPanel Spacing="7">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Classes="sectionLabel"
                    Text="Model" />
                <ComboBox
                    Grid.Column="1"
                    AutomationProperties.Name="Copilot model"
                    ItemsSource="{Binding Copilot.Models}"
                    SelectedItem="{Binding Copilot.SelectedModel}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="assistance:KustoCopilotModel">
                      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <Button
                  Grid.Column="2"
                    AutomationProperties.Name="Refresh Copilot models"
                    Classes="treeAction"
                    Command="{Binding Copilot.RefreshModelsCommand}"
                    ToolTip.Tip="Refresh models">
                  <LucideIcon Kind="RefreshCw" Size="13" />
                </Button>
              </Grid>
              <WrapPanel>
                <ToggleSwitch
                    Margin="0,0,12,4"
                    AutomationProperties.Name="Share complete query tab content with Copilot"
                    Content="Share tab content"
                    FontSize="{DynamicResource TypeSmallSize}"
                    IsVisible="{Binding IsQueryTabCopilotScope}"
                    IsChecked="{Binding Copilot.ShareTabContent}"
                    OffContent="{x:Null}"
                    OnContent="{x:Null}"
                    ToolTip.Tip="Include the complete content of this query tab in the next Copilot turn" />
                  <ToggleSwitch
                    Margin="0,0,12,4"
                    AutomationProperties.Name="Share selected recorded query with Copilot"
                    Content="Share selected query"
                    FontSize="{DynamicResource TypeSmallSize}"
                    IsVisible="{Binding IsRecordedSessionCopilotScope}"
                    IsChecked="{Binding Copilot.ShareTabContent}"
                    OffContent="{x:Null}"
                    OnContent="{x:Null}"
                    ToolTip.Tip="Include the selected recorded query text in the next Copilot turn" />
                <ToggleSwitch
                    Margin="0,0,12,4"
                    AutomationProperties.Name="Share schema and database with Copilot"
                    Content="Share schema"
                    FontSize="{DynamicResource TypeSmallSize}"
                    IsVisible="{Binding IsQueryDataCopilotScope}"
                    IsChecked="{Binding Copilot.ShareSchema}"
                    OffContent="{x:Null}"
                    OnContent="{x:Null}"
                    ToolTip.Tip="Include this database's table and column schema and the cluster and database name" />
                  <ToggleSwitch
                    Margin="0,0,12,4"
                    AutomationProperties.Name="Share recorded query schema with Copilot"
                    Content="Share schema"
                    FontSize="{DynamicResource TypeSmallSize}"
                    IsVisible="{Binding IsRecordedSessionCopilotScope}"
                    IsChecked="{Binding Copilot.ShareSchema}"
                    OffContent="{x:Null}"
                    OnContent="{x:Null}"
                    ToolTip.Tip="Include the recorded query database schema in the next Copilot turn" />
                <ToggleSwitch
                    Margin="0,0,12,4"
                    AutomationProperties.Name="Share current result data with Copilot"
                    Content="Share result data"
                    FontSize="{DynamicResource TypeSmallSize}"
                  IsVisible="{Binding IsQueryDataCopilotScope}"
                    IsChecked="{Binding Copilot.ShareResultData}"
                    OffContent="{x:Null}"
                    OnContent="{x:Null}"
                    ToolTip.Tip="Include up to 50 rows from this tab's current result" />
                  <ToggleSwitch
                    Margin="0,0,12,4"
                    AutomationProperties.Name="Enable bounded recorded session tools for Copilot"
                    Content="Enable session tools"
                    FontSize="{DynamicResource TypeSmallSize}"
                    IsVisible="{Binding IsRecordedSessionCopilotScope}"
                    IsChecked="{Binding Copilot.ShareResultData}"
                    OffContent="{x:Null}"
                    OnContent="{x:Null}"
                    ToolTip.Tip="Allow bounded read-only tools to inspect the selected recorded session" />
                <ToggleSwitch
                  Margin="0,0,12,4"
                  AutomationProperties.Name="Share selected graph data with Copilot"
                  Content="Share graph data"
                  FontSize="{DynamicResource TypeSmallSize}"
                  IsVisible="{Binding IsGraphCopilotScope}"
                  IsChecked="{Binding Copilot.ShareGraphData}"
                  OffContent="{x:Null}"
                  OnContent="{x:Null}"
                  ToolTip.Tip="Enable bounded read-only tools for this graph generation" />
                <ToggleSwitch
                    Margin="0,0,12,4"
                    AutomationProperties.Name="Enable Microsoft Learn MCP"
                    Content="MS Learn MCP"
                    FontSize="{DynamicResource TypeSmallSize}"
                    IsVisible="{Binding Copilot.SupportsMcp}"
                    IsChecked="{Binding Copilot.EnableMicrosoftLearnMcp}"
                    OffContent="{x:Null}"
                    OnContent="{x:Null}" />
                <ToggleSwitch
                    Margin="0,0,0,4"
                    AutomationProperties.Name="Enable Azure Data Explorer MCP"
                    Content="Azure MCP"
                    FontSize="{DynamicResource TypeSmallSize}"
                    IsVisible="{Binding IsAzureMcpCopilotScope}"
                    IsChecked="{Binding Copilot.EnableAzureMcp}"
                    IsEnabled="{Binding Copilot.CanEnableAzureMcp}"
                    OffContent="{x:Null}"
                    OnContent="{x:Null}"
                    ToolTip.Tip="Requires result-data sharing consent; read-only Azure Data Explorer tools only" />
              </WrapPanel>
            </StackPanel>
          </Border>

          <Grid Grid.Row="2">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !Copilot.HasMessages}" Spacing="6">
              <LucideIcon HorizontalAlignment="Center" Kind="Sparkles" Size="22" Foreground="{DynamicResource AccentBrush}" />
              <TextBlock Classes="muted" Text="No conversation yet" />
            </StackPanel>
            <ListBox
                Margin="8,0"
                Background="Transparent"
                BorderThickness="0"
                IsVisible="{Binding Copilot.HasMessages}"
              ItemsSource="{Binding Copilot.Messages}"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
              ScrollViewer.VerticalScrollBarVisibility="Auto">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="presentation:KustoCopilotMessageViewModel">
                  <Border
                      Margin="4,3"
                      Padding="9,7"
                      Background="{Binding BackgroundHex}"
                      CornerRadius="5">
                    <Border.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="Copy text" Click="OnCopyCopilotMessageClick">
                          <MenuItem.Icon>
                            <LucideIcon Kind="Copy" Size="13" />
                          </MenuItem.Icon>
                        </MenuItem>
                      </ContextMenu>
                    </Border.ContextMenu>
                    <StackPanel Spacing="3">
                      <TextBlock Classes="sectionLabel" Text="{Binding Author}" />
                        <TextBlock
                          FontFamily="Cascadia Code, JetBrains Mono, Noto Sans Mono, monospace"
                          FontSize="{DynamicResource TypeSmallSize}"
                          Text="{Binding Content}"
                          TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>

          <Border
              Grid.Row="3"
              Margin="10,6"
              Padding="9"
              Background="{DynamicResource AccentSubtleBrush}"
              BorderBrush="{DynamicResource DecorativeDividerBrush}"
              BorderThickness="1"
              CornerRadius="5"
              IsVisible="{Binding Copilot.HasAnyProposal}">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="7">
              <StackPanel Grid.Row="0" Spacing="2">
                <TextBlock FontWeight="SemiBold" Text="{Binding Copilot.ProposalTitle}" />
                <ScrollViewer MaxHeight="150" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                  <TextBlock
                      Classes="muted"
                      FontFamily="Cascadia Code, JetBrains Mono, Noto Sans Mono, monospace"
                      FontSize="{DynamicResource TypeSmallSize}"
                      Text="{Binding Copilot.ProposalText}"
                      TextWrapping="Wrap" />
                </ScrollViewer>
              </StackPanel>
              <WrapPanel Grid.Row="1" HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Margin="3" Classes="command" Command="{Binding Copilot.CreateAutomationCommand}" Content="Create automation" IsVisible="{Binding Copilot.HasAutomationProposal}" />
                <Button Margin="3" Classes="command" Command="{Binding Copilot.CreateNewTabCommand}" Content="New tab" IsVisible="{Binding Copilot.HasProposal}" />
                <Button Margin="3" AutomationProperties.Name="Add Copilot query to end of current tab" Classes="command" Command="{Binding Copilot.AppendToCurrentTabCommand}" Content="Add to end" IsVisible="{Binding Copilot.HasAppendProposal}" />
                <Button x:Name="CopilotApplyEditButton" Margin="3" Classes="primaryCommand" Command="{Binding Copilot.ApplyToCurrentTabCommand}" Content="Apply edit" IsVisible="{Binding Copilot.HasApplyProposal}" />
                <Button Margin="3" Classes="command" Command="{Binding Copilot.LoadCypherCommand}" Content="Load query" IsVisible="{Binding Copilot.HasCypherProposal}" />
                <Button Margin="3" Classes="primaryCommand" Command="{Binding Copilot.RunCypherProposalCommand}" Content="Run query" IsVisible="{Binding Copilot.HasCypherProposal}" />
              </WrapPanel>
            </Grid>
          </Border>

          <Border
              Grid.Row="4"
              Padding="10,8"
              Background="{DynamicResource ToolbarSurfaceBrush}"
              BorderBrush="{DynamicResource DecorativeDividerBrush}"
              BorderThickness="0,1,0,0">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="7">
              <TextBox
                  x:Name="CopilotPrompt"
                  Grid.Row="0"
                  MinHeight="68"
                  MaxHeight="130"
                  AcceptsReturn="True"
                  AutomationProperties.Name="Ask the AI assistant about the active workspace"
                  KeyDown="OnCopilotPromptKeyDown"
                  PlaceholderText="{Binding CopilotPromptPlaceholder}"
                  Text="{Binding Copilot.Prompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  TextWrapping="Wrap" />
              <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="0">
                  <TextBlock
                      Classes="tertiary"
                      FontSize="{DynamicResource TypeMetadataSize}"
                      Text="{Binding Copilot.StatusText}"
                      TextWrapping="Wrap" />
                  <TextBlock Classes="tertiary" FontSize="{DynamicResource TypeMicroSize}" Text="{Binding CopilotSubtitle}" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    Classes="command"
                    Command="{Binding Copilot.SignInCommand}"
                    Content="Sign in"
                    IsVisible="{Binding Copilot.CanSignIn}" />
                <Button
                    Grid.Column="2"
                    Classes="command"
                    Command="{Binding Copilot.CancelCommand}"
                    Content="Cancel"
                    IsVisible="{Binding Copilot.CanCancel}" />
                <Button
                  x:Name="CopilotSendButton"
                  Grid.Column="3"
                    Classes="primaryCommand"
                    Command="{Binding Copilot.SendCommand}"
                    Content="Send"
                    IsVisible="{Binding !Copilot.IsBusy}" />
              </Grid>
            </Grid>
          </Border>
        </Grid>
      </Border>
    </Grid>

    <Border
        x:Name="SettingsDialog"
        Grid.RowSpan="3"
        desktop:ModalDialog.IsEnabled="True"
        ZIndex="106"
        IsVisible="False"
        Background="#66000000">
      <Border
          Width="520"
          Padding="22"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Background="{DynamicResource RaisedSurfaceBrush}"
          BorderBrush="{DynamicResource ControlBoundaryBrush}"
          BorderThickness="1"
          CornerRadius="6">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="16">
          <StackPanel Grid.Row="0" Spacing="3">
            <TextBlock FontSize="{DynamicResource TypeTitleSize}" FontWeight="SemiBold" Text="Application settings" />
            <TextBlock Classes="muted" FontSize="{DynamicResource TypeCompactSize}" Text="Changes apply immediately and are saved for the next launch" />
          </StackPanel>

          <Grid Grid.Row="1" ColumnDefinitions="130,*" ColumnSpacing="18">
            <TextBlock Grid.Column="0" VerticalAlignment="Top" Classes="sectionLabel" Text="THEME" />
            <StackPanel Grid.Column="1" Spacing="4">
              <RadioButton x:Name="SettingsSystemThemeOption" Content="System" GroupName="SettingsThemePreference" IsCheckedChanged="OnSystemThemeChecked" />
              <RadioButton x:Name="SettingsLightThemeOption" Content="Light" GroupName="SettingsThemePreference" IsCheckedChanged="OnLightThemeChecked" />
              <RadioButton x:Name="SettingsDarkThemeOption" Content="Dark" GroupName="SettingsThemePreference" IsCheckedChanged="OnDarkThemeChecked" />
            </StackPanel>
          </Grid>

          <Grid Grid.Row="2" ColumnDefinitions="130,*,Auto" ColumnSpacing="18">
            <TextBlock Grid.Column="0" VerticalAlignment="Center" Classes="sectionLabel" Text="DENSITY" />
            <StackPanel Grid.Column="1" Spacing="2">
              <TextBlock FontWeight="SemiBold" Text="Comfortable controls" />
              <TextBlock Classes="muted" FontSize="{DynamicResource TypeCompactSize}" Text="Adds space to rows, buttons, and tabs" />
            </StackPanel>
            <ToggleSwitch
                x:Name="SettingsDensityToggle"
                Grid.Column="2"
                AutomationProperties.Name="Comfortable controls"
                VerticalAlignment="Center"
                IsCheckedChanged="OnDensityToggleChanged" />
          </Grid>

          <Grid Grid.Row="3" ColumnDefinitions="130,*" ColumnSpacing="18">
            <TextBlock Grid.Column="0" VerticalAlignment="Top" Classes="sectionLabel" Text="EDITOR" />
            <StackPanel Grid.Column="1" Spacing="9">
              <StackPanel Spacing="4">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <TextBlock FontWeight="SemiBold" Text="Application text" />
                  <TextBlock
                      x:Name="SettingsTextZoomValue"
                      Grid.Column="1"
                      Classes="tertiary"
                      FontSize="{DynamicResource TypeCompactSize}"
                      Text="100%" />
                </Grid>
                <TextBlock Classes="muted" FontSize="{DynamicResource TypeCompactSize}" Text="Also changes query editor text" />
                <Slider
                    x:Name="SettingsTextZoomSlider"
                    AutomationProperties.Name="Application text zoom"
                    IsSnapToTickEnabled="True"
                    Maximum="140"
                    Minimum="85"
                    TickFrequency="5"
                    ValueChanged="OnTextZoomChanged" />
              </StackPanel>
              <StackPanel Spacing="4">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <TextBlock FontWeight="SemiBold" Text="Result table text" />
                  <TextBlock
                      x:Name="SettingsResultTextZoomValue"
                      Grid.Column="1"
                      Classes="tertiary"
                      FontSize="{DynamicResource TypeCompactSize}"
                      Text="100%" />
                </Grid>
                <TextBlock Classes="muted" FontSize="{DynamicResource TypeCompactSize}" Text="Changes column headers and cell values" />
                <Slider
                    x:Name="SettingsResultTextZoomSlider"
                    AutomationProperties.Name="Result table text zoom"
                    IsSnapToTickEnabled="True"
                    Maximum="250"
                    Minimum="85"
                    TickFrequency="5"
                    ValueChanged="OnResultTextZoomChanged" />
              </StackPanel>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                  <TextBlock FontWeight="SemiBold" Text="Hover syntax help" />
                  <TextBlock Classes="muted" FontSize="{DynamicResource TypeCompactSize}" Text="Show KQL help after a one-second hover" />
                </StackPanel>
                <ToggleSwitch
                    x:Name="SettingsKqlHoverHelpToggle"
                    Grid.Column="1"
                    AutomationProperties.Name="Show KQL syntax help on hover"
                    IsCheckedChanged="OnSettingsKqlHoverHelpChanged"
                    OffContent="{x:Null}"
                    OnContent="{x:Null}" />
              </Grid>
            </StackPanel>
          </Grid>

          <Grid Grid.Row="4" ColumnDefinitions="130,*" ColumnSpacing="18">
            <TextBlock Grid.Column="0" VerticalAlignment="Top" Classes="sectionLabel" Text="AI" />
            <StackPanel Grid.Column="1" Spacing="7" IsEnabled="{Binding !IsCopilotWorking}">
              <Grid
                  ColumnDefinitions="*,170"
                  ColumnSpacing="8"
                  IsVisible="{Binding HostCapabilities.IsAIProviderUserConfigured}">
                <TextBlock VerticalAlignment="Center" Text="Provider" />
                <ComboBox
                    x:Name="SettingsAIProvider"
                    Grid.Column="1"
                    AutomationProperties.Name="AI provider"
                    SelectionChanged="OnSettingsAIProviderChanged">
                  <ComboBoxItem Content="GitHub Copilot" />
                  <ComboBoxItem Content="Azure OpenAI" />
                  <ComboBoxItem Content="OpenAI" />
                </ComboBox>
              </Grid>
              <Grid
                  ColumnDefinitions="*,Auto"
                  ColumnSpacing="8"
                  IsVisible="{Binding !HostCapabilities.IsAIProviderUserConfigured}">
                <TextBlock VerticalAlignment="Center" Text="Provider" />
                <TextBlock
                    Grid.Column="1"
                    Classes="muted"
                    Text="{Binding HostCapabilities.ManagedAIProviderDisplayName}"
                    TextWrapping="Wrap" />
              </Grid>
              <StackPanel x:Name="SettingsAzureOpenAIOptions" Spacing="5" IsVisible="False">
                <Grid ColumnDefinitions="*,170" ColumnSpacing="8">
                  <TextBlock VerticalAlignment="Center" Text="Azure endpoint" />
                  <TextBox
                      x:Name="SettingsAzureOpenAIEndpoint"
                      Grid.Column="1"
                      AutomationProperties.Name="Azure OpenAI endpoint"
                      LostFocus="OnSettingsAIProviderTextLostFocus"
                      PlaceholderText="https://resource.openai.azure.com" />
                </Grid>
                <Grid ColumnDefinitions="*,170" ColumnSpacing="8">
                  <TextBlock VerticalAlignment="Center" Text="Deployment" />
                  <TextBox
                      x:Name="SettingsAzureOpenAIDeployment"
                      Grid.Column="1"
                      AutomationProperties.Name="Azure OpenAI deployment"
                      LostFocus="OnSettingsAIProviderTextLostFocus" />
                </Grid>
                <Grid ColumnDefinitions="*,170" ColumnSpacing="8">
                  <TextBlock VerticalAlignment="Center" Text="Authentication" />
                  <ComboBox
                      x:Name="SettingsAzureOpenAIAuthentication"
                      Grid.Column="1"
                      AutomationProperties.Name="Azure OpenAI authentication"
                      SelectionChanged="OnSettingsAzureOpenAIAuthenticationChanged"
                      ToolTip.Tip="Microsoft Entra ID uses DefaultAzureCredential">
                    <ComboBoxItem Content="Microsoft Entra ID" />
                    <ComboBoxItem Content="API key" />
                  </ComboBox>
                </Grid>
                <Grid
                    x:Name="SettingsAzureOpenAIApiKeyRow"
                    ColumnDefinitions="*,170"
                    ColumnSpacing="8"
                    IsVisible="False">
                  <TextBlock VerticalAlignment="Center" Text="API key variable" />
                  <TextBox
                      x:Name="SettingsAzureOpenAIApiKeyEnvironmentVariable"
                      Grid.Column="1"
                      AutomationProperties.Name="Azure OpenAI API key environment variable"
                      LostFocus="OnSettingsAIProviderTextLostFocus" />
                </Grid>
              </StackPanel>
              <StackPanel x:Name="SettingsOpenAIOptions" Spacing="5" IsVisible="False">
                <Grid ColumnDefinitions="*,170" ColumnSpacing="8">
                  <TextBlock VerticalAlignment="Center" Text="Endpoint (optional)" />
                  <TextBox
                      x:Name="SettingsOpenAIEndpoint"
                      Grid.Column="1"
                      AutomationProperties.Name="OpenAI endpoint"
                      LostFocus="OnSettingsAIProviderTextLostFocus"
                      PlaceholderText="https://api.openai.com/v1" />
                </Grid>
                <Grid ColumnDefinitions="*,170" ColumnSpacing="8">
                  <TextBlock VerticalAlignment="Center" Text="Model" />
                  <TextBox
                      x:Name="SettingsOpenAIModel"
                      Grid.Column="1"
                      AutomationProperties.Name="OpenAI model"
                      LostFocus="OnSettingsAIProviderTextLostFocus" />
                </Grid>
                <Grid ColumnDefinitions="*,170" ColumnSpacing="8">
                  <TextBlock VerticalAlignment="Center" Text="API key variable" />
                  <TextBox
                      x:Name="SettingsOpenAIApiKeyEnvironmentVariable"
                      Grid.Column="1"
                      AutomationProperties.Name="OpenAI API key environment variable"
                      LostFocus="OnSettingsAIProviderTextLostFocus" />
                </Grid>
              </StackPanel>
              <Grid x:Name="SettingsCopilotDefaultModelRow" ColumnDefinitions="*,170,Auto" ColumnSpacing="8">
                <TextBlock VerticalAlignment="Center" Text="Default model" />
                <ComboBox
                    x:Name="SettingsCopilotDefaultModel"
                    Grid.Column="1"
                    AutomationProperties.Name="Default Copilot model"
                    ItemsSource="{Binding Copilot.Models}"
                    SelectionChanged="OnSettingsCopilotDefaultModelChanged">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="assistance:KustoCopilotModel">
                      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <Button
                    Grid.Column="2"
                    AutomationProperties.Name="Refresh default Copilot models"
                    Classes="treeAction"
                    Click="OnSettingsCopilotModelsRefreshClick"
                    ToolTip.Tip="Refresh models">
                  <LucideIcon Kind="RefreshCw" Size="13" />
                </Button>
              </Grid>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock VerticalAlignment="Center" Text="Share tab content by default" />
                <ToggleSwitch
                    x:Name="SettingsCopilotShareTabContentToggle"
                    Grid.Column="1"
                    AutomationProperties.Name="Share complete query tab content with Copilot by default"
                    IsCheckedChanged="OnSettingsCopilotShareTabContentChanged"
                    OffContent="{x:Null}"
                    OnContent="{x:Null}" />
              </Grid>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock VerticalAlignment="Center" Text="Share schema by default" />
                <ToggleSwitch
                    x:Name="SettingsCopilotShareSchemaToggle"
                    Grid.Column="1"
                    AutomationProperties.Name="Share schema with Copilot by default"
                    IsCheckedChanged="OnSettingsCopilotShareSchemaChanged"
                    OffContent="{x:Null}"
                    OnContent="{x:Null}" />
              </Grid>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock VerticalAlignment="Center" Text="Share result data by default" />
                <ToggleSwitch
                    x:Name="SettingsCopilotShareResultDataToggle"
                    Grid.Column="1"
                    AutomationProperties.Name="Share result data with Copilot by default"
                    IsCheckedChanged="OnSettingsCopilotShareResultDataChanged"
                    OffContent="{x:Null}"
                    OnContent="{x:Null}" />
              </Grid>
              <Grid
                  x:Name="SettingsCopilotMicrosoftLearnMcpRow"
                  ColumnDefinitions="*,Auto"
                  ColumnSpacing="12">
                <TextBlock VerticalAlignment="Center" Text="MS Learn MCP by default" />
                <ToggleSwitch
                    x:Name="SettingsCopilotMicrosoftLearnMcpToggle"
                    Grid.Column="1"
                    AutomationProperties.Name="Enable Microsoft Learn MCP by default"
                    IsCheckedChanged="OnSettingsCopilotMicrosoftLearnMcpChanged"
                    OffContent="{x:Null}"
                    OnContent="{x:Null}" />
              </Grid>
              <Grid
                  x:Name="SettingsCopilotAzureMcpRow"
                  ColumnDefinitions="*,Auto"
                  ColumnSpacing="12">
                <TextBlock VerticalAlignment="Center" Text="Azure MCP by default" />
                <ToggleSwitch
                    x:Name="SettingsCopilotAzureMcpToggle"
                    Grid.Column="1"
                    AutomationProperties.Name="Enable Azure MCP by default"
                    IsCheckedChanged="OnSettingsCopilotAzureMcpChanged"
                    OffContent="{x:Null}"
                    OnContent="{x:Null}" />
              </Grid>
            </StackPanel>
          </Grid>

          <Grid Grid.Row="5" ColumnDefinitions="130,*,Auto" ColumnSpacing="18">
            <TextBlock Grid.Column="0" VerticalAlignment="Center" Classes="sectionLabel" Text="LOCAL DATA" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
              <TextBlock FontWeight="SemiBold" Text="Application storage" />
              <TextBlock Classes="muted" FontSize="{DynamicResource TypeCompactSize}" Text="Connections, documents, sessions, and graphs" />
            </StackPanel>
            <Button
                x:Name="SettingsLocalDataAction"
                Grid.Column="2"
                AutomationProperties.Name="Open local data folder"
                Classes="command"
                Click="OnOpenLocalDataFolderClick">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <LucideIcon Kind="FolderOpen" Size="13" />
                <TextBlock x:Name="SettingsLocalDataActionText" Text="Open folder" />
              </StackPanel>
            </Button>
          </Grid>

          <Grid Grid.Row="6" ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" VerticalAlignment="Center" Classes="tertiary" FontSize="{DynamicResource TypeSmallSize}" Text="High contrast follows Windows settings" />
            <Button Grid.Column="1" Classes="primaryCommand" Click="OnSettingsCloseClick" Content="Done" />
          </Grid>
        </Grid>
      </Border>
    </Border>

    <Border
        Grid.RowSpan="3"
        desktop:ModalDialog.IsEnabled="True"
        ZIndex="120"
        IsVisible="{Binding Recording.IsDatabaseRecoveryOpen}"
        Background="#66000000">
      <Border
          Width="500"
          Padding="20"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Background="{DynamicResource RaisedSurfaceBrush}"
          BorderBrush="{DynamicResource ErrorBrush}"
          BorderThickness="1"
          CornerRadius="6"
          KeyboardNavigation.TabNavigation="Cycle">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="12">
          <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
            <LucideIcon VerticalAlignment="Center" Kind="CircleAlert" Size="18" Foreground="{DynamicResource ErrorBrush}" />
            <TextBlock
                VerticalAlignment="Center"
                FontSize="{DynamicResource TypeTitleSize}"
                FontWeight="SemiBold"
                Text="Recorded sessions cannot be opened" />
          </StackPanel>
          <TextBlock
              Grid.Row="1"
              Text="{Binding Recording.DatabaseRecoveryMessage}"
              TextWrapping="Wrap" />
          <StackPanel Grid.Row="2" Spacing="3">
            <TextBlock Classes="sectionLabel" Text="DATABASE DIRECTORY" />
            <TextBlock
                Classes="muted"
                FontFamily="Cascadia Code, JetBrains Mono, Noto Sans Mono, monospace"
                FontSize="{DynamicResource TypeMetadataSize}"
                Text="{Binding Recording.DatabaseDirectoryPath}"
                TextWrapping="Wrap" />
          </StackPanel>
          <TextBlock
              Grid.Row="3"
              Foreground="{DynamicResource ErrorBrush}"
              IsVisible="{Binding Recording.HasDatabaseRecoveryError}"
              Text="{Binding Recording.DatabaseRecoveryErrorText}"
              TextWrapping="Wrap" />
          <Grid Grid.Row="4" Margin="0,4,0,0" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
            <Button
                Grid.Column="1"
                Classes="command"
                Command="{Binding Recording.CancelDatabaseRecoveryCommand}"
                Content="Cancel" />
            <Button
                Grid.Column="2"
                AutomationProperties.Name="Open recorded-session database folder"
                Classes="command"
                Click="OnOpenLocalDataFolderClick">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <LucideIcon Kind="FolderOpen" Size="13" />
                <TextBlock Text="Open folder" />
              </StackPanel>
            </Button>
            <Button
                Grid.Column="3"
                AutomationProperties.Name="Remove incompatible recorded-session database"
                Classes="dangerCommand"
                Command="{Binding Recording.ResetDatabaseCommand}"
                Content="Remove database" />
          </Grid>
        </Grid>
      </Border>
    </Border>

    <desktop:DeferredContentControl
        Grid.RowSpan="3"
        desktop:ModalDialog.IsEnabled="True"
        ZIndex="105"
        IsContentMaterialized="{Binding Dashboard.IsDashboardEditorOpen}"
        IsVisible="{Binding Dashboard.IsDashboardEditorOpen}"
        Background="#66000000">
      <desktop:DeferredContentControl.ContentTemplate>
        <DataTemplate x:DataType="presentation:MainWindowViewModel">
          <Border
          x:Name="RecordingDialog"
          Width="480"
          Padding="20"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Background="{DynamicResource RaisedSurfaceBrush}"
          BorderBrush="{DynamicResource ControlBoundaryBrush}"
          BorderThickness="1"
          CornerRadius="6">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="13">
          <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock FontSize="{DynamicResource TypeTitleSize}" FontWeight="SemiBold" Text="{Binding Dashboard.DashboardEditorHeading}" />
          </StackPanel>
          <StackPanel Grid.Row="1" Spacing="5">
            <TextBlock Classes="sectionLabel" Text="NAME" />
            <TextBox
                Height="36"
                MaxLength="100"
                AutomationProperties.Name="Dashboard name"
                desktop:EnterKeyCommand.Command="{Binding Dashboard.SaveDashboardCommand}"
                Text="{Binding Dashboard.DashboardEditorTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                VerticalContentAlignment="Center" />
          </StackPanel>
          <StackPanel Grid.Row="2" Spacing="7">
            <TextBlock Classes="sectionLabel" Text="CANVAS THEME" />
            <ItemsControl ItemsSource="{Binding Dashboard.Themes}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="7" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="presentation:KustoDashboardThemeViewModel">
                  <Button Width="70" Height="48" Padding="5" Click="OnDashboardThemeClick" ToolTip.Tip="{Binding Name}">
                    <Grid RowDefinitions="*,Auto" RowSpacing="3">
                      <Border Background="{Binding BackgroundColor}" BorderBrush="{Binding AccentColor}" BorderThickness="2" CornerRadius="3" />
                      <TextBlock Grid.Row="1" HorizontalAlignment="Center" FontSize="{DynamicResource TypeMicroSize}" Text="{Binding Name}" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Height="28" Background="{Binding Dashboard.DashboardEditorBackgroundColor}" BorderBrush="{DynamicResource ControlBoundaryBrush}" BorderThickness="1" CornerRadius="4" />
          </StackPanel>
          <Border
              Grid.Row="3"
              Padding="9,7"
              Background="{DynamicResource SubtleSurfaceBrush}"
              BorderBrush="{DynamicResource ErrorBrush}"
              BorderThickness="1"
              CornerRadius="5"
              IsVisible="{Binding Dashboard.HasDashboardEditorError}">
            <TextBlock FontSize="{DynamicResource TypeCompactSize}" Text="{Binding Dashboard.DashboardEditorErrorText}" TextWrapping="Wrap" />
          </Border>
          <Grid Grid.Row="4" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <Button Grid.Column="1" Classes="command" Command="{Binding Dashboard.CloseDashboardEditorCommand}" Content="Cancel" />
            <Button Grid.Column="2" Classes="primaryCommand" Command="{Binding Dashboard.SaveDashboardCommand}" Content="{Binding Dashboard.DashboardEditorActionText}" />
          </Grid>
        </Grid>
          </Border>
        </DataTemplate>
      </desktop:DeferredContentControl.ContentTemplate>
    </desktop:DeferredContentControl>

    <desktop:DeferredContentControl
        Grid.RowSpan="3"
        desktop:ModalDialog.IsEnabled="True"
        ZIndex="106"
        IsContentMaterialized="{Binding Dashboard.IsCustomTimeRangeOpen}"
        IsVisible="{Binding Dashboard.IsCustomTimeRangeOpen}"
        Background="#66000000">
      <desktop:DeferredContentControl.ContentTemplate>
        <DataTemplate x:DataType="presentation:MainWindowViewModel">
          <Border
              MaxWidth="520"
              Margin="16"
              Padding="20"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Center"
              Background="{DynamicResource RaisedSurfaceBrush}"
              BorderBrush="{DynamicResource ControlBoundaryBrush}"
              BorderThickness="1"
              CornerRadius="6"
              KeyboardNavigation.TabNavigation="Cycle">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="13">
              <TextBlock
                  Grid.Row="0"
                  FontSize="{DynamicResource TypeTitleSize}"
                  FontWeight="SemiBold"
                  Text="Custom time range" />
              <StackPanel Grid.Row="1" Spacing="9">
                <StackPanel Spacing="5">
                  <TextBlock Classes="sectionLabel" Text="START (LOCAL TIME)" />
                  <WrapPanel Orientation="Horizontal">
                    <CalendarDatePicker
                        Width="180"
                        Margin="0,0,10,6"
                        AutomationProperties.Name="Custom time range start date"
                        SelectedDate="{Binding Dashboard.CustomTimeRangeStartDate, Mode=TwoWay}" />
                    <TimePicker
                        Width="240"
                        Margin="0,0,0,6"
                        AutomationProperties.Name="Custom time range start time"
                        SelectedTime="{Binding Dashboard.CustomTimeRangeStartTime, Mode=TwoWay}" />
                  </WrapPanel>
                </StackPanel>
                <StackPanel Spacing="5">
                  <TextBlock Classes="sectionLabel" Text="END (LOCAL TIME)" />
                  <WrapPanel Orientation="Horizontal">
                    <CalendarDatePicker
                        Width="180"
                        Margin="0,0,10,6"
                        AutomationProperties.Name="Custom time range end date"
                        SelectedDate="{Binding Dashboard.CustomTimeRangeEndDate, Mode=TwoWay}" />
                    <TimePicker
                        Width="240"
                        Margin="0,0,0,6"
                        AutomationProperties.Name="Custom time range end time"
                        SelectedTime="{Binding Dashboard.CustomTimeRangeEndTime, Mode=TwoWay}" />
                  </WrapPanel>
                </StackPanel>
              </StackPanel>
              <Border
                  Grid.Row="2"
                  Padding="9,7"
                  Background="{DynamicResource SubtleSurfaceBrush}"
                  BorderBrush="{DynamicResource ErrorBrush}"
                  BorderThickness="1"
                  CornerRadius="5"
                  IsVisible="{Binding Dashboard.HasCustomTimeRangeError}">
                <TextBlock
                    FontSize="{DynamicResource TypeCompactSize}"
                    Text="{Binding Dashboard.CustomTimeRangeErrorText}"
                    TextWrapping="Wrap" />
              </Border>
              <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <Button
                    Grid.Column="1"
                    Classes="command"
                    Command="{Binding Dashboard.CloseCustomTimeRangeCommand}"
                    Content="Cancel" />
                <Button
                    Grid.Column="2"
                    AutomationProperties.Name="Apply custom time range"
                    Classes="primaryCommand"
                    Command="{Binding Dashboard.SaveCustomTimeRangeCommand}"
                    Content="Apply" />
              </Grid>
            </Grid>
          </Border>
        </DataTemplate>
      </desktop:DeferredContentControl.ContentTemplate>
    </desktop:DeferredContentControl>

    <desktop:DeferredContentControl
        Grid.RowSpan="3"
        desktop:ModalDialog.IsEnabled="True"
        ZIndex="106"
        IsContentMaterialized="{Binding Dashboard.IsWidgetEditorOpen}"
        IsVisible="{Binding Dashboard.IsWidgetEditorOpen}"
        Background="#66000000">
      <desktop:DeferredContentControl.ContentTemplate>
        <DataTemplate x:DataType="presentation:MainWindowViewModel">
          <Border
          Width="740"
          MaxHeight="680"
          Margin="36"
          Padding="20"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Background="{DynamicResource RaisedSurfaceBrush}"
          BorderBrush="{DynamicResource ControlBoundaryBrush}"
          BorderThickness="1"
          CornerRadius="6">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="14">
          <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock FontSize="{DynamicResource TypeTitleSize}" FontWeight="SemiBold" Text="{Binding Dashboard.WidgetEditorHeading}" />
          </StackPanel>

          <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0" Spacing="12">
              <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <StackPanel Grid.Column="0" Spacing="5">
                  <TextBlock Classes="sectionLabel" Text="DASHBOARD" />
                  <ComboBox
                      AutomationProperties.Name="Widget dashboard"
                      ItemsSource="{Binding Dashboard.Dashboards}"
                      SelectedItem="{Binding Dashboard.SelectedDashboard, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="presentation:KustoDashboardViewModel">
                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="5">
                  <TextBlock Classes="sectionLabel" Text="WIDGET TITLE" />
                  <TextBox
                      MaxLength="100"
                      AutomationProperties.Name="Widget title"
                      Text="{Binding Dashboard.WidgetEditorTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
              </Grid>

              <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <StackPanel Grid.Column="0" Spacing="5">
                  <TextBlock Classes="sectionLabel" Text="CLUSTER" />
                  <TextBox
                      AutomationProperties.Name="Widget cluster address"
                      Text="{Binding Dashboard.WidgetEditorClusterAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="5">
                  <TextBlock Classes="sectionLabel" Text="DATABASE" />
                  <TextBox
                      AutomationProperties.Name="Widget database"
                      Text="{Binding Dashboard.WidgetEditorDatabaseName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
              </Grid>

              <Grid ColumnDefinitions="Auto,*,*" ColumnSpacing="16">
                <StackPanel Grid.Column="0" Spacing="5">
                  <TextBlock Classes="sectionLabel" Text="DISPLAY" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <RadioButton Content="Table" GroupName="WidgetDisplay" IsChecked="{Binding Dashboard.WidgetEditorUsesTable, Mode=TwoWay}" />
                    <RadioButton Content="Chart" GroupName="WidgetDisplay" IsChecked="{Binding Dashboard.WidgetEditorUsesVisualization, Mode=TwoWay}" />
                  </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="5">
                  <TextBlock Classes="sectionLabel" Text="REFRESH" />
                  <ComboBox
                      AutomationProperties.Name="Widget refresh interval"
                      ItemsSource="{Binding Dashboard.RefreshOptions}"
                      SelectedItem="{Binding Dashboard.SelectedRefreshOption, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="presentation:KustoDashboardRefreshOptionViewModel">
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="5" IsVisible="{Binding Dashboard.WidgetEditorUsesVisualization}">
                  <TextBlock Classes="sectionLabel" Text="VISUALIZATION" />
                  <ComboBox
                      AutomationProperties.Name="Widget visualization"
                      ItemsSource="{Binding Dashboard.VisualizationOptions}"
                      SelectedItem="{Binding Dashboard.SelectedVisualizationOption, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="presentation:KustoDashboardVisualizationOptionViewModel">
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
              </Grid>

              <StackPanel Spacing="5">
                <TextBlock Classes="sectionLabel" Text="KQL" />
                <TextBox
                  MinHeight="300"
                    AcceptsReturn="True"
                    AutomationProperties.Name="Widget KQL query"
                    FontFamily="Cascadia Code, JetBrains Mono, Noto Sans Mono, monospace"
                    FontSize="{DynamicResource TypeCompactSize}"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                    Text="{Binding Dashboard.WidgetEditorQueryText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="NoWrap" />
              </StackPanel>

              <StackPanel Spacing="7">
                <TextBlock Classes="sectionLabel" Text="WIDGET THEME" />
                <ItemsControl ItemsSource="{Binding Dashboard.Themes}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="7" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="presentation:KustoDashboardThemeViewModel">
                      <Button Width="90" Height="54" Padding="5" Click="OnWidgetThemeClick" ToolTip.Tip="{Binding Name}">
                        <Grid RowDefinitions="*,Auto" RowSpacing="3">
                          <Border Background="{Binding BackgroundColor}" BorderBrush="{Binding AccentColor}" BorderThickness="2" CornerRadius="3">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="{DynamicResource TypeMetadataSize}" Foreground="{Binding ForegroundColor}" Text="Aa" />
                          </Border>
                          <TextBlock Grid.Row="1" HorizontalAlignment="Center" FontSize="{DynamicResource TypeMicroSize}" Text="{Binding Name}" />
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid Height="32" Background="{Binding Dashboard.WidgetEditorBackgroundColor}">
                  <Border Height="3" VerticalAlignment="Top" Background="{Binding Dashboard.WidgetEditorAccentColor}" />
                  <TextBlock Margin="10,0" VerticalAlignment="Center" FontSize="{DynamicResource TypeSmallSize}" Foreground="{Binding Dashboard.WidgetEditorForegroundColor}" Text="Widget preview" />
                </Grid>
              </StackPanel>

              <Border
                  Padding="9,7"
                  Background="{DynamicResource SubtleSurfaceBrush}"
                  BorderBrush="{DynamicResource ErrorBrush}"
                  BorderThickness="1"
                  CornerRadius="5"
                  IsVisible="{Binding Dashboard.HasWidgetEditorError}">
                <TextBlock FontSize="{DynamicResource TypeCompactSize}" Text="{Binding Dashboard.WidgetEditorErrorText}" TextWrapping="Wrap" />
              </Border>
            </StackPanel>
          </ScrollViewer>

          <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <Button Grid.Column="1" Classes="command" Command="{Binding Dashboard.CloseWidgetEditorCommand}" Content="Cancel" />
            <Button Grid.Column="2" Classes="primaryCommand" Command="{Binding Dashboard.SaveWidgetCommand}" Content="{Binding Dashboard.WidgetEditorActionText}" />
          </Grid>
        </Grid>
          </Border>
        </DataTemplate>
      </desktop:DeferredContentControl.ContentTemplate>
    </desktop:DeferredContentControl>

    <Border
        Grid.RowSpan="3"
        desktop:ModalDialog.IsEnabled="True"
        ZIndex="107"
        IsVisible="{Binding Dashboard.IsDeleteDashboardOpen}"
        Background="#66000000">
      <Border
          Width="440"
          Padding="20"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Background="{DynamicResource RaisedSurfaceBrush}"
          BorderBrush="{DynamicResource ControlBoundaryBrush}"
          BorderThickness="1"
          CornerRadius="6">
        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="14">
          <StackPanel Spacing="3">
            <TextBlock FontSize="{DynamicResource TypeTitleSize}" FontWeight="SemiBold" Text="Delete dashboard" />
            <TextBlock Classes="muted" FontSize="{DynamicResource TypeCompactSize}" Text="{Binding Dashboard.SelectedDashboard.Title}" />
          </StackPanel>
          <TextBlock Grid.Row="1" Text="This permanently deletes the dashboard and all of its widget definitions." TextWrapping="Wrap" />
          <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <Button Grid.Column="1" Classes="command" Command="{Binding Dashboard.CloseDeleteDashboardCommand}" Content="Cancel" />
            <Button Grid.Column="2" Classes="dangerCommand" Command="{Binding Dashboard.ConfirmDeleteDashboardCommand}" Content="Delete dashboard" />
          </Grid>
        </Grid>
      </Border>
    </Border>

    <Border
        Grid.RowSpan="3"
        desktop:ModalDialog.IsEnabled="True"
        ZIndex="108"
        IsVisible="{Binding Dashboard.IsDeleteWidgetOpen}"
        Background="#66000000">
      <Border
          Width="440"
          Padding="20"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Background="{DynamicResource RaisedSurfaceBrush}"
          BorderBrush="{DynamicResource ControlBoundaryBrush}"
          BorderThickness="1"
          CornerRadius="6">
        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="14">
          <TextBlock FontSize="{DynamicResource TypeTitleSize}" FontWeight="SemiBold" Text="Delete widget" />
          <TextBlock Grid.Row="1" Text="This permanently removes the query-backed widget from the dashboard." TextWrapping="Wrap" />
          <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <Button Grid.Column="1" Classes="command" Command="{Binding Dashboard.CloseDeleteWidgetCommand}" Content="Cancel" />
            <Button Grid.Column="2" Classes="dangerCommand" Command="{Binding Dashboard.ConfirmDeleteWidgetCommand}" Content="Delete widget" />
          </Grid>
        </Grid>
      </Border>
    </Border>

    <Border
        Grid.RowSpan="3"
        desktop:ModalDialog.IsEnabled="True"
        ZIndex="100"
        IsVisible="{Binding IsAddClusterOpen}"
        Background="#66000000">
      <Border
          Width="460"
          Padding="20"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Background="{DynamicResource RaisedSurfaceBrush}"
          BorderBrush="{DynamicResource ControlBoundaryBrush}"
          BorderThickness="1"
          CornerRadius="6">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="12">
          <Grid Grid.Row="0">
            <StackPanel Spacing="2">
              <TextBlock
                  FontSize="{DynamicResource TypeTitleSize}"
                  FontWeight="SemiBold"
                  Text="Add ADX cluster" />
              <TextBlock Classes="muted" FontSize="{DynamicResource TypeCompactSize}" Text="Microsoft sign-in opens in your browser" />
            </StackPanel>
          </Grid>

          <StackPanel Grid.Row="1" Spacing="5">
            <TextBlock Classes="sectionLabel" Text="CLUSTER URL" />
            <TextBox
                AutomationProperties.Name="Cluster URL"
              desktop:EnterKeyCommand.Command="{Binding AddClusterCommand}"
                Height="36"
                Padding="10,0"
                PlaceholderText="https://mycluster.region.kusto.windows.net"
              Text="{Binding NewClusterAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                VerticalContentAlignment="Center" />
          </StackPanel>

          <StackPanel Grid.Row="2" Spacing="5">
            <TextBlock Classes="sectionLabel" Text="DISPLAY NAME (OPTIONAL)" />
            <TextBox
                AutomationProperties.Name="Cluster display name"
                desktop:EnterKeyCommand.Command="{Binding AddClusterCommand}"
                Height="36"
                Padding="10,0"
                PlaceholderText="Production analytics"
                Text="{Binding NewClusterDisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                VerticalContentAlignment="Center" />
          </StackPanel>

          <StackPanel Grid.Row="3" Spacing="5">
            <TextBlock Classes="sectionLabel" Text="FOLDER (OPTIONAL)" />
            <TextBox
                AutomationProperties.Name="New cluster folder"
              desktop:EnterKeyCommand.Command="{Binding AddClusterCommand}"
                Height="36"
                Padding="10,0"
                PlaceholderText="Production"
              Text="{Binding NewClusterFolderName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                VerticalContentAlignment="Center" />
          </StackPanel>

          <Border
              Grid.Row="4"
              Padding="10,8"
              Background="{DynamicResource SubtleSurfaceBrush}"
              BorderBrush="{DynamicResource ErrorBrush}"
              BorderThickness="1"
              CornerRadius="5"
              IsVisible="{Binding HasAddClusterError}">
            <TextBlock
                FontSize="{DynamicResource TypeCompactSize}"
                Text="{Binding AddClusterErrorText}"
                TextWrapping="Wrap" />
          </Border>

          <Grid Grid.Row="5" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <ProgressBar
                Grid.Column="0"
                Width="150"
                Height="4"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                IsIndeterminate="True"
                IsVisible="{Binding IsAddingCluster}" />
            <Button
                Grid.Column="1"
                Classes="command"
                Command="{Binding CloseAddClusterCommand}"
              Content="Cancel"
              Height="36" />
            <Button
                Grid.Column="2"
                AutomationProperties.Name="Add cluster and discover databases"
                Classes="primaryCommand"
                Command="{Binding AddClusterCommand}"
                Content="Add cluster"
                Height="36" />
          </Grid>
        </Grid>
      </Border>
    </Border>

    <Border
        Grid.RowSpan="3"
        desktop:ModalDialog.IsEnabled="True"
        ZIndex="101"
        IsVisible="{Binding IsOrganizeClusterOpen}"
        Background="#66000000">
      <Border
          Width="420"
          Padding="20"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Background="{DynamicResource RaisedSurfaceBrush}"
          BorderBrush="{DynamicResource ControlBoundaryBrush}"
          BorderThickness="1"
          CornerRadius="6">
        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="14">
          <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock
                FontSize="{DynamicResource TypeTitleSize}"
                FontWeight="SemiBold"
                Text="Organize cluster" />
            <TextBlock
                Classes="muted"
                FontSize="{DynamicResource TypeCompactSize}"
                Text="{Binding OrganizeClusterDisplayName}"
                TextTrimming="CharacterEllipsis" />
          </StackPanel>

          <StackPanel Grid.Row="1" Spacing="5">
            <TextBlock Classes="sectionLabel" Text="FOLDER" />
            <TextBox
                AutomationProperties.Name="Cluster folder"
              desktop:EnterKeyCommand.Command="{Binding SaveClusterFolderCommand}"
                Height="36"
                Padding="10,0"
                PlaceholderText="Leave empty for Explorer root"
              Text="{Binding OrganizeFolderName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                VerticalContentAlignment="Center" />
          </StackPanel>

          <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                Classes="tertiary"
                FontSize="{DynamicResource TypeSmallSize}"
                Text="Folders are shared by name" />
            <Button
                Grid.Column="1"
                Classes="command"
                Command="{Binding CloseOrganizeClusterCommand}"
                Content="Cancel"
                Height="36" />
            <Button
                Grid.Column="2"
                AutomationProperties.Name="Save cluster folder"
                Classes="primaryCommand"
                Command="{Binding SaveClusterFolderCommand}"
                Content="Move"
                Height="36" />
          </Grid>
        </Grid>
      </Border>
    </Border>

    <Border
        Grid.RowSpan="3"
        desktop:ModalDialog.IsEnabled="True"
        ZIndex="102"
        IsVisible="{Binding IsRenameTabOpen}"
        Background="#66000000">
      <Border
          Width="420"
          Padding="20"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Background="{DynamicResource RaisedSurfaceBrush}"
          BorderBrush="{DynamicResource ControlBoundaryBrush}"
          BorderThickness="1"
          CornerRadius="6">
        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="14">
          <TextBlock
              Grid.Row="0"
              FontSize="{DynamicResource TypeTitleSize}"
              FontWeight="SemiBold"
              Text="Rename tab" />
          <StackPanel Grid.Row="1" Spacing="5">
            <TextBlock Classes="sectionLabel" Text="TAB NAME" />
            <TextBox
                AutomationProperties.Name="Tab name"
              desktop:EnterKeyCommand.Command="{Binding SaveRenameTabCommand}"
                Height="36"
                MaxLength="80"
                Padding="10,0"
              Text="{Binding RenameTabTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                VerticalContentAlignment="Center" />
          </StackPanel>
          <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <Button
                Grid.Column="1"
                Classes="command"
                Command="{Binding CloseRenameTabCommand}"
                Content="Cancel"
                Height="36" />
            <Button
                Grid.Column="2"
                AutomationProperties.Name="Save tab name"
                Classes="primaryCommand"
                Command="{Binding SaveRenameTabCommand}"
                Content="Rename"
                Height="36" />
          </Grid>
        </Grid>
      </Border>
    </Border>

    <Border
        Grid.RowSpan="3"
        desktop:ModalDialog.IsEnabled="True"
        ZIndex="103"
        IsVisible="{Binding Recording.IsRenameExecutionOpen}"
        Background="#66000000">
      <Border
          Width="440"
          Padding="20"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Background="{DynamicResource RaisedSurfaceBrush}"
          BorderBrush="{DynamicResource ControlBoundaryBrush}"
          BorderThickness="1"
          CornerRadius="6">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="14">
          <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock FontSize="{DynamicResource TypeTitleSize}" FontWeight="SemiBold" Text="Rename recorded query" />
            <TextBlock Classes="tertiary" FontSize="{DynamicResource TypeSmallSize}" Text="The original query text and source tab remain unchanged" />
          </StackPanel>
          <StackPanel Grid.Row="1" Spacing="5">
            <TextBlock Classes="sectionLabel" Text="QUERY NAME" />
            <TextBox
                AutomationProperties.Name="Recorded query name"
                desktop:EnterKeyCommand.Command="{Binding Recording.SaveRenameExecutionCommand}"
                Height="36"
                MaxLength="80"
                Padding="10,0"
                Text="{Binding Recording.RenameExecutionName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                VerticalContentAlignment="Center" />
          </StackPanel>
          <TextBlock
              Grid.Row="2"
              Classes="tertiary"
              Foreground="{DynamicResource ErrorBrush}"
              IsVisible="{Binding Recording.HasRenameExecutionError}"
              Text="{Binding Recording.RenameExecutionErrorText}"
              TextWrapping="Wrap" />
          <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <Button
                Grid.Column="1"
                Classes="command"
                Command="{Binding Recording.CloseRenameExecutionCommand}"
                Content="Cancel"
                Height="36" />
            <Button
                Grid.Column="2"
                AutomationProperties.Name="Save recorded query name"
                Classes="primaryCommand"
                Command="{Binding Recording.SaveRenameExecutionCommand}"
                Content="Rename"
                Height="36" />
          </Grid>
        </Grid>
      </Border>
    </Border>

    <Border
        Grid.RowSpan="3"
        desktop:ModalDialog.IsEnabled="True"
        ZIndex="104"
        IsVisible="{Binding IsGroupTabOpen}"
        Background="#66000000">
      <Border
          Width="420"
          Padding="20"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Background="{DynamicResource RaisedSurfaceBrush}"
          BorderBrush="{DynamicResource ControlBoundaryBrush}"
          BorderThickness="1"
          CornerRadius="6">
        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="14">
          <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock
                FontSize="{DynamicResource TypeTitleSize}"
                FontWeight="SemiBold"
                Text="Assign tab group" />
            <TextBlock
                Classes="muted"
                FontSize="{DynamicResource TypeCompactSize}"
                Text="Matching names keep tabs together" />
          </StackPanel>
          <StackPanel Grid.Row="1" Spacing="5">
            <TextBlock Classes="sectionLabel" Text="GROUP" />
            <ComboBox
                AutomationProperties.Name="Tab group"
              desktop:EnterKeyCommand.Command="{Binding SaveGroupTabCommand}"
                Height="36"
                IsEditable="True"
                ItemsSource="{Binding ExistingTabGroups}"
                PlaceholderText="Leave empty for no group"
              Text="{Binding TabGroupName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                VerticalContentAlignment="Center" />
          </StackPanel>
          <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <Button
                Grid.Column="1"
                Classes="command"
                Command="{Binding CloseGroupTabCommand}"
                Content="Cancel"
                Height="36" />
            <Button
                Grid.Column="2"
                AutomationProperties.Name="Save tab group"
                Classes="primaryCommand"
                Command="{Binding SaveGroupTabCommand}"
                Content="Apply"
                Height="36" />
          </Grid>
        </Grid>
      </Border>
    </Border>

    <Border
        Grid.RowSpan="3"
        desktop:ModalDialog.IsEnabled="True"
        ZIndex="104"
        IsVisible="{Binding IsRenameAutomationOpen}"
        Background="#66000000">
      <Border
          Width="430"
          Padding="20"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Background="{DynamicResource RaisedSurfaceBrush}"
          BorderBrush="{DynamicResource ControlBoundaryBrush}"
          BorderThickness="1"
          CornerRadius="6">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="12">
          <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock FontSize="{DynamicResource TypeTitleSize}" FontWeight="SemiBold" Text="Rename automation" />
            <TextBlock Classes="muted" FontSize="{DynamicResource TypeCompactSize}" Text="Automation names must be unique" />
          </StackPanel>
          <TextBox
              Grid.Row="1"
              Height="36"
              MaxLength="100"
              AutomationProperties.Name="Automation name"
              desktop:EnterKeyCommand.Command="{Binding SaveRenameAutomationCommand}"
              Text="{Binding RenameAutomationName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
              VerticalContentAlignment="Center" />
          <TextBlock
              Grid.Row="2"
              Foreground="{DynamicResource ErrorBrush}"
              FontSize="{DynamicResource TypeCompactSize}"
              IsVisible="{Binding HasRenameAutomationError}"
              Text="{Binding RenameAutomationErrorText}"
              TextWrapping="Wrap" />
          <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <Button Grid.Column="1" Classes="command" Command="{Binding CloseRenameAutomationCommand}" Content="Cancel" />
            <Button Grid.Column="2" Classes="primaryCommand" Command="{Binding SaveRenameAutomationCommand}" Content="Rename" />
          </Grid>
        </Grid>
      </Border>
    </Border>

    <desktop:DeferredContentControl
        Grid.RowSpan="3"
        desktop:ModalDialog.IsEnabled="True"
        ZIndex="104"
        IsContentMaterialized="{Binding IsConditionalFormattingOpen}"
        IsVisible="{Binding IsConditionalFormattingOpen}"
        Background="#66000000">
      <desktop:DeferredContentControl.ContentTemplate>
        <DataTemplate x:DataType="presentation:MainWindowViewModel">
          <Border
          Width="680"
          MaxHeight="700"
          Padding="20"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Background="{DynamicResource RaisedSurfaceBrush}"
          BorderBrush="{DynamicResource ControlBoundaryBrush}"
          BorderThickness="1"
          CornerRadius="6">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" RowSpacing="12">
          <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock FontSize="{DynamicResource TypeTitleSize}" FontWeight="SemiBold" Text="Conditional formatting" />
            <TextBlock Classes="muted" FontSize="{DynamicResource TypeCompactSize}" Text="Rules are saved with the current query tab" />
          </StackPanel>

          <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="10">
            <StackPanel Grid.Column="0" Spacing="5">
              <TextBlock Classes="sectionLabel" Text="COLUMN" />
              <ComboBox ItemsSource="{Binding ResultColumns}" SelectedValue="{Binding ConditionalRuleColumnName}" SelectedValueBinding="{Binding Name}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="presentation:KustoResultColumnViewModel">
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="5">
              <TextBlock Classes="sectionLabel" Text="COMPARISON" />
              <ComboBox ItemsSource="{Binding ConditionalComparisonOptions}" SelectedItem="{Binding ConditionalRuleComparison}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="5">
              <TextBlock Classes="sectionLabel" Text="TARGET" />
              <ComboBox ItemsSource="{Binding ConditionalTargetOptions}" SelectedItem="{Binding ConditionalRuleTarget}" />
            </StackPanel>
          </Grid>

          <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <StackPanel Grid.Column="0" Spacing="5">
              <TextBlock Classes="sectionLabel" Text="{Binding ConditionalRuleValueLabel}" />
                <TextBox
                  Height="36"
                  Padding="10,0"
                  desktop:EnterKeyCommand.Command="{Binding AddConditionalFormattingRuleCommand}"
                  Text="{Binding ConditionalRuleComparisonValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  VerticalContentAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="5">
              <TextBlock Classes="sectionLabel" Text="COLOR" />
              <ColorPicker
                  x:Name="ConditionalColorPicker"
                  Width="94"
                  Height="36"
                  Color="#FECACA"
                  ColorChanged="OnConditionalColorChanged"
                  IsColorPaletteVisible="True"
                  IsColorSpectrumVisible="True" />
            </StackPanel>
          </Grid>

          <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
            <ItemsControl Grid.Column="0" ItemsSource="{Binding ConditionalColorPresets}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Width="28" Height="28" Padding="0" AutomationProperties.Name="{Binding StringFormat='Use color {0}'}" Click="OnConditionalPresetClick" CommandParameter="{Binding}" ToolTip.Tip="{Binding}">
                    <Border Width="18" Height="18" Background="{Binding}" BorderBrush="{DynamicResource ControlBoundaryBrush}" BorderThickness="1" CornerRadius="3" />
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBox
              Grid.Column="1"
              Height="32"
              desktop:EnterKeyCommand.Command="{Binding AddConditionalFormattingRuleCommand}"
              Text="{Binding ConditionalRuleColorHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
              VerticalContentAlignment="Center" />
            <Button Grid.Column="2" Classes="primaryCommand" Command="{Binding AddConditionalFormattingRuleCommand}" Content="Add rule" />
          </Grid>

          <Border Grid.Row="4" Padding="9,7" Background="{DynamicResource SubtleSurfaceBrush}" BorderBrush="{DynamicResource ErrorBrush}" BorderThickness="1" CornerRadius="5" IsVisible="{Binding HasConditionalFormattingError}">
            <TextBlock FontSize="{DynamicResource TypeCompactSize}" Text="{Binding ConditionalFormattingErrorText}" TextWrapping="Wrap" />
          </Border>

          <Grid Grid.Row="5" RowDefinitions="*,Auto" RowSpacing="10">
            <ScrollViewer Grid.Row="0" MaxHeight="260">
              <ItemsControl ItemsSource="{Binding SelectedDocument.ConditionalFormattingRules}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="presentation:KustoConditionalFormatRuleViewModel">
                    <Grid MinHeight="36" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
                      <Border Grid.Column="0" Width="18" Height="18" VerticalAlignment="Center" Background="{Binding ColorHex}" CornerRadius="3" />
                      <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="{DynamicResource TypeCompactSize}" Text="{Binding Summary}" TextTrimming="CharacterEllipsis" />
                      <Button Grid.Column="2" AutomationProperties.Name="{Binding Summary, StringFormat='Remove rule: {0}'}" Classes="treeAction" Command="{Binding RemoveCommand}" ToolTip.Tip="Remove rule"><LucideIcon Kind="Trash" Size="13" /></Button>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
              <Button Grid.Column="1" Classes="command" Command="{Binding CloseConditionalFormattingCommand}" Content="Done" />
            </Grid>
          </Grid>
        </Grid>
          </Border>
        </DataTemplate>
      </desktop:DeferredContentControl.ContentTemplate>
    </desktop:DeferredContentControl>

    <Border
        Grid.RowSpan="3"
        desktop:ModalDialog.IsEnabled="True"
        ZIndex="109"
        IsVisible="{Binding Graph.IsClearGraphOpen}"
        Background="#66000000">
      <Border
          Width="460"
          Padding="20"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Background="{DynamicResource RaisedSurfaceBrush}"
          BorderBrush="{DynamicResource ControlBoundaryBrush}"
          BorderThickness="1"
          CornerRadius="6">
        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="14">
          <StackPanel Grid.Row="0" Spacing="3">
            <TextBlock
                FontSize="{DynamicResource TypeTitleSize}"
                FontWeight="SemiBold"
                Text="Clear active graph" />
            <TextBlock Classes="muted" FontSize="{DynamicResource TypeCompactSize}" Text="{Binding Graph.State.GraphName}" />
          </StackPanel>

          <TextBlock
              Grid.Row="1"
              Text="This starts a new empty generation. The named graph remains available, and retained generations stay available for historical investigation."
              TextWrapping="Wrap" />

          <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <Button
                Grid.Column="1"
                Classes="command"
                Command="{Binding Graph.CloseClearGraphCommand}"
                Content="Cancel" />
            <Button
                Grid.Column="2"
                Classes="dangerCommand"
                Command="{Binding Graph.ClearGraphCommand}"
                Content="Clear graph" />
          </Grid>
        </Grid>
      </Border>
    </Border>

    <Border
        Grid.RowSpan="3"
        desktop:ModalDialog.IsEnabled="True"
        ZIndex="109"
        IsVisible="{Binding Graph.IsNodeLabelEditorOpen}"
        Background="#66000000">
      <Border
          Width="460"
          Padding="20"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Background="{DynamicResource RaisedSurfaceBrush}"
          BorderBrush="{DynamicResource ControlBoundaryBrush}"
          BorderThickness="1"
          CornerRadius="6">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="12">
          <StackPanel Grid.Row="0" Spacing="3">
            <TextBlock
                FontSize="{DynamicResource TypeTitleSize}"
                FontWeight="SemiBold"
                Text="Change visible node label" />
            <TextBlock
                Classes="muted"
                FontSize="{DynamicResource TypeCompactSize}"
                Text="This label is saved for this graph without changing source evidence."
                TextWrapping="Wrap" />
          </StackPanel>

          <Grid Grid.Row="1" RowDefinitions="Auto,Auto" RowSpacing="5">
            <TextBlock Classes="sectionLabel" Text="VISIBLE LABEL" />
            <TextBox
                Grid.Row="1"
                AutomationProperties.Name="Visible graph node label"
                desktop:EnterKeyCommand.Command="{Binding Graph.SaveNodeLabelCommand}"
                MaxLength="200"
                Text="{Binding Graph.NodeLabelText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
          </Grid>

          <TextBlock
              Grid.Row="2"
              Foreground="{DynamicResource ErrorBrush}"
              FontSize="{DynamicResource TypeCompactSize}"
              IsVisible="{Binding Graph.HasNodeLabelError}"
              Text="{Binding Graph.NodeLabelError}"
              TextWrapping="Wrap" />

          <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <Button
                Grid.Column="1"
                Classes="command"
                Command="{Binding Graph.CloseNodeLabelEditorCommand}"
                Content="Cancel" />
            <Button
                Grid.Column="2"
                AutomationProperties.Name="Save visible graph node label"
                Classes="primaryCommand"
                Command="{Binding Graph.SaveNodeLabelCommand}"
                Content="Save label" />
          </Grid>
        </Grid>
      </Border>
    </Border>

    <Border
        Grid.RowSpan="3"
        desktop:ModalDialog.IsEnabled="True"
        ZIndex="108"
        IsVisible="{Binding Graph.IsGraphEditorOpen}"
        Background="#66000000">
      <Border
          Width="520"
          Padding="20"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Background="{DynamicResource RaisedSurfaceBrush}"
          BorderBrush="{DynamicResource ControlBoundaryBrush}"
          BorderThickness="1"
          CornerRadius="6">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="12">
          <TextBlock
              Grid.Row="0"
              FontSize="{DynamicResource TypeTitleSize}"
              FontWeight="SemiBold"
              Text="{Binding Graph.GraphEditorTitle}" />

          <Grid Grid.Row="1" RowDefinitions="Auto,Auto" RowSpacing="5">
            <TextBlock Classes="sectionLabel" Text="NAME" />
            <TextBox
                Grid.Row="1"
                AutomationProperties.Name="Graph name"
              desktop:EnterKeyCommand.Command="{Binding Graph.SaveGraphCommand}"
                MaxLength="120"
                Text="{Binding Graph.GraphEditorName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
          </Grid>

          <Grid Grid.Row="2" RowDefinitions="Auto,Auto" RowSpacing="5">
            <TextBlock Classes="sectionLabel" Text="DESCRIPTION" />
            <TextBox
                Grid.Row="1"
                MinHeight="92"
                MaxHeight="180"
                AcceptsReturn="True"
                AutomationProperties.Name="Graph description"
                MaxLength="2000"
                Text="{Binding Graph.GraphEditorDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="Wrap" />
          </Grid>

          <TextBlock
              Grid.Row="3"
              Foreground="{DynamicResource ErrorBrush}"
              FontSize="{DynamicResource TypeCompactSize}"
              IsVisible="{Binding Graph.HasGraphEditorError}"
              Text="{Binding Graph.GraphEditorError}"
              TextWrapping="Wrap" />

          <Grid Grid.Row="4" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <Button
                Grid.Column="1"
                Classes="command"
                Command="{Binding Graph.CloseGraphEditorCommand}"
                Content="Cancel" />
            <Button
                Grid.Column="2"
                Classes="primaryCommand"
                Command="{Binding Graph.SaveGraphCommand}"
                Content="{Binding Graph.GraphEditorSaveText}" />
          </Grid>
        </Grid>
      </Border>
    </Border>

    <Border
        Grid.RowSpan="3"
        desktop:ModalDialog.IsEnabled="True"
        ZIndex="108"
        IsVisible="{Binding Graph.IsDeleteGraphOpen}"
        Background="#66000000">
      <Border
          Width="460"
          Padding="20"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Background="{DynamicResource RaisedSurfaceBrush}"
          BorderBrush="{DynamicResource ControlBoundaryBrush}"
          BorderThickness="1"
          CornerRadius="6">
        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="14">
          <StackPanel Grid.Row="0" Spacing="3">
            <TextBlock
                FontSize="{DynamicResource TypeTitleSize}"
                FontWeight="SemiBold"
                Text="Delete graph" />
            <TextBlock Classes="muted" FontSize="{DynamicResource TypeCompactSize}" Text="{Binding Graph.DeleteGraphName}" />
          </StackPanel>

          <TextBlock
              Grid.Row="1"
              Text="This permanently removes every retained generation and evidence occurrence owned by this graph."
              TextWrapping="Wrap" />

          <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <Button
                Grid.Column="1"
                Classes="command"
                Command="{Binding Graph.CloseDeleteGraphCommand}"
                Content="Cancel" />
            <Button
                Grid.Column="2"
                Classes="dangerCommand"
                Command="{Binding Graph.DeleteGraphCommand}"
                Content="Delete graph" />
          </Grid>
        </Grid>
      </Border>
    </Border>

    <Border
        Grid.RowSpan="3"
        desktop:ModalDialog.IsEnabled="True"
        ZIndex="108"
        IsVisible="{Binding Graph.IsDeleteAllGraphsOpen}"
        Background="#66000000">
      <Border
          Width="500"
          Padding="20"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Background="{DynamicResource RaisedSurfaceBrush}"
          BorderBrush="{DynamicResource ControlBoundaryBrush}"
          BorderThickness="1"
          CornerRadius="6">
        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="14">
          <StackPanel Grid.Row="0" Spacing="3">
            <TextBlock
                FontSize="{DynamicResource TypeTitleSize}"
                FontWeight="SemiBold"
                Text="Delete all saved graphs?" />
            <TextBlock Classes="muted" FontSize="{DynamicResource TypeCompactSize}" Text="{Binding Graph.DeleteAllGraphsSummary}" />
          </StackPanel>

          <TextBlock
              Grid.Row="1"
              Text="This permanently deletes every saved graph, retained generation, and evidence occurrence. One new empty Default graph will be created. This cannot be undone."
              TextWrapping="Wrap" />

          <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <Button
                Grid.Column="1"
                Classes="command"
                Command="{Binding Graph.CloseDeleteAllGraphsCommand}"
                Content="Cancel" />
            <Button
                Grid.Column="2"
                AutomationProperties.Name="Confirm delete all saved graphs"
                Classes="dangerCommand"
                Command="{Binding Graph.DeleteAllGraphsCommand}"
                Content="Delete all graphs" />
          </Grid>
        </Grid>
      </Border>
    </Border>

    <Border
        Grid.RowSpan="3"
        desktop:ModalDialog.IsEnabled="True"
        ZIndex="107"
        IsVisible="{Binding IsGraphIdentityResolutionOpen}"
        Background="#66000000">
      <Border
          Width="620"
          MaxHeight="520"
          Padding="20"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Background="{DynamicResource RaisedSurfaceBrush}"
          BorderBrush="{DynamicResource ControlBoundaryBrush}"
          BorderThickness="1"
          CornerRadius="6">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="14">
          <StackPanel Grid.Row="0" Spacing="3">
            <TextBlock
                FontSize="{DynamicResource TypeTitleSize}"
                FontWeight="SemiBold"
                Text="Possible duplicate graph nodes" />
            <TextBlock
                Classes="muted"
                FontSize="{DynamicResource TypeCompactSize}"
                Text="Compare the inferred types and values before these results are added."
                TextWrapping="Wrap" />
          </StackPanel>

          <TextBlock
              Grid.Row="1"
              FontWeight="SemiBold"
              Text="{Binding GraphIdentityMatchText}"
              TextWrapping="Wrap" />

          <ScrollViewer Grid.Row="2" MaxHeight="260" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10">
              <TextBlock
                  FontFamily="Cascadia Code, JetBrains Mono, Noto Sans Mono, monospace"
                  FontSize="{DynamicResource TypeSmallSize}"
                  Text="{Binding GraphIdentityCandidatesText}"
                  TextWrapping="Wrap" />
              <TextBlock
                  Classes="muted"
                  FontSize="{DynamicResource TypeSmallSize}"
                  Text="{Binding GraphIdentityMergeText}"
                  TextWrapping="Wrap" />
            </StackPanel>
          </ScrollViewer>

          <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
            <Button
                Grid.Column="1"
                AutomationProperties.Name="Cancel graph import"
                Classes="command"
                Command="{Binding CancelGraphIdentityResolutionCommand}"
                Content="Cancel import" />
            <Button
                Grid.Column="2"
                AutomationProperties.Name="Keep graph nodes separate"
                Classes="command"
                Command="{Binding KeepGraphIdentitiesSeparateCommand}"
                Content="Keep separate" />
            <Button
                Grid.Column="3"
                AutomationProperties.Name="Merge as the same graph node"
                Classes="primaryCommand"
                Command="{Binding MergeGraphIdentityCommand}"
                Content="Same node" />
          </Grid>
        </Grid>
      </Border>
    </Border>

    <desktop:DeferredContentControl
        Grid.RowSpan="3"
        desktop:ModalDialog.IsEnabled="True"
        ZIndex="106"
        IsContentMaterialized="{Binding AutomationNotifications.IsOpen}"
        IsVisible="{Binding AutomationNotifications.IsOpen}"
        Background="#66000000">
      <desktop:DeferredContentControl.ContentTemplate>
        <DataTemplate x:DataType="presentation:MainWindowViewModel">
          <Border
          Width="720"
          MaxHeight="760"
          Padding="20"
          Loaded="OnAutomationNotificationEditorLoaded"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Background="{DynamicResource RaisedSurfaceBrush}"
          BorderBrush="{DynamicResource ControlBoundaryBrush}"
          BorderThickness="1"
          CornerRadius="6">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="14">
          <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock FontSize="{DynamicResource TypeTitleSize}" FontWeight="SemiBold" Text="Automation actions" />
            <TextBlock Classes="muted" FontSize="{DynamicResource TypeCompactSize}" Text="{Binding AutomationNotifications.AutomationName}" />
          </StackPanel>

          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16">
              <StackPanel Spacing="8">
                <TextBlock Classes="sectionLabel" Text="CRITERIA" />
                <ToggleSwitch
                    AutomationProperties.Name="Notify when row count changes"
                    Content="Row count changed since the previous successful run"
                    IsChecked="{Binding AutomationNotifications.NotifyWhenRowCountChanges}" />
                <Grid ColumnDefinitions="*,150" ColumnSpacing="10">
                  <ComboBox
                      Grid.Column="0"
                      AutomationProperties.Name="Row count comparison"
                      ItemsSource="{Binding AutomationNotifications.RowCountComparisonOptions}"
                      SelectedItem="{Binding AutomationNotifications.RowCountComparison}" />
                  <NumericUpDown
                      Grid.Column="1"
                      Minimum="0"
                      AutomationProperties.Name="Row count value"
                      IsVisible="{Binding AutomationNotifications.HasRowCountComparison}"
                      Value="{Binding AutomationNotifications.RowCountValue}" />
                </Grid>
              </StackPanel>

              <Border Height="1" Background="{DynamicResource DecorativeDividerBrush}" />

              <StackPanel Spacing="8">
                <TextBlock Classes="sectionLabel" Text="ACTIONS" />
                <StackPanel Orientation="Horizontal" Spacing="20">
                  <ToggleSwitch
                      x:Name="AutomationToastAction"
                      AutomationProperties.Name="Desktop automation notifications"
                      Content="Desktop toast"
                      IsChecked="{Binding AutomationNotifications.DesktopEnabled}" />
                  <ToggleSwitch
                      x:Name="AutomationEmailAction"
                      AutomationProperties.Name="Email automation notifications"
                      Content="Email"
                      IsChecked="{Binding AutomationNotifications.EmailEnabled}" />
                    <ToggleSwitch
                      x:Name="AutomationApplicationAction"
                      AutomationProperties.Name="Run application for matching automation result"
                      Content="Run application"
                      IsChecked="{Binding AutomationNotifications.RunApplicationEnabled}" />
                  <ToggleSwitch
                      x:Name="AutomationWebhookAction"
                      AutomationProperties.Name="Send webhook for matching automation result"
                      Content="Webhook"
                      IsChecked="{Binding AutomationNotifications.WebhookEnabled}" />
                </StackPanel>
                <Grid
                    x:Name="AutomationEmailSettings"
                    IsVisible="{Binding AutomationNotifications.ShowEmailSettings}"
                    ColumnDefinitions="*,*"
                    RowDefinitions="Auto,Auto,Auto"
                    ColumnSpacing="10"
                    RowSpacing="9">
                  <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                    <TextBlock Classes="sectionLabel" Text="RECIPIENT" />
                    <TextBox
                        desktop:EnterKeyCommand.Command="{Binding AutomationNotifications.SaveCommand}"
                        Text="{Binding AutomationNotifications.EmailRecipient, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                  <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                    <TextBlock Classes="sectionLabel" Text="SENDER" />
                    <TextBox
                        desktop:EnterKeyCommand.Command="{Binding AutomationNotifications.SaveCommand}"
                        Text="{Binding AutomationNotifications.EmailSender, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                  <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4">
                    <TextBlock Classes="sectionLabel" Text="SMTP HOST" />
                    <TextBox
                        desktop:EnterKeyCommand.Command="{Binding AutomationNotifications.SaveCommand}"
                        Text="{Binding AutomationNotifications.SmtpHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                  <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                    <TextBlock Classes="sectionLabel" Text="SMTP PORT (TLS)" />
                    <NumericUpDown Minimum="1" Maximum="65535" Value="{Binding AutomationNotifications.SmtpPort}" />
                  </StackPanel>
                  <TextBlock
                      Grid.Row="2"
                      Grid.ColumnSpan="2"
                      Classes="tertiary"
                      FontSize="{DynamicResource TypeMetadataSize}"
                      Text="Optional credentials: OPENKUSTOEXPLORER_SMTP_USERNAME and OPENKUSTOEXPLORER_SMTP_PASSWORD"
                      TextWrapping="Wrap" />
                </Grid>
                <Grid
                  x:Name="AutomationApplicationSettings"
                    IsVisible="{Binding AutomationNotifications.ShowApplicationSettings}"
                    ColumnDefinitions="*,*"
                    ColumnSpacing="10">
                  <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Classes="sectionLabel" Text="APPLICATION" />
                    <TextBox
                        AutomationProperties.Name="Automation application path"
                        PlaceholderText="C:\Path\to\application.exe"
                        Text="{Binding AutomationNotifications.ApplicationPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Classes="sectionLabel" Text="ARGUMENTS" />
                    <TextBox
                        AutomationProperties.Name="Automation application arguments"
                        PlaceholderText="--rows {row_count}"
                        Text="{Binding AutomationNotifications.ApplicationArguments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                </Grid>
                <StackPanel
                    x:Name="AutomationWebhookSettings"
                    IsVisible="{Binding AutomationNotifications.ShowWebhookSettings}"
                    Spacing="8">
                  <TextBlock Classes="sectionLabel" Text="WEBHOOK ENDPOINT" />
                  <StackPanel Orientation="Horizontal" Spacing="16">
                    <RadioButton
                        AutomationProperties.Name="Use webhook URL stored in automation settings"
                        Content="Stored HTTPS URL"
                        GroupName="WebhookEndpointSource"
                        IsChecked="{Binding AutomationNotifications.WebhookUsesStoredUrl, Mode=TwoWay}" />
                    <RadioButton
                        AutomationProperties.Name="Read webhook URL from an environment variable"
                        Content="Environment variable"
                        GroupName="WebhookEndpointSource"
                        IsChecked="{Binding AutomationNotifications.WebhookUsesEnvironmentVariable, Mode=TwoWay}" />
                  </StackPanel>
                  <TextBox
                      AutomationProperties.Name="Stored webhook HTTPS URL"
                      IsVisible="{Binding AutomationNotifications.WebhookUsesStoredUrl}"
                      PlaceholderText="https://hooks.example.com/automation"
                      Text="{Binding AutomationNotifications.WebhookStoredUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                  <TextBox
                      AutomationProperties.Name="Webhook URL environment variable name"
                      IsVisible="{Binding AutomationNotifications.WebhookUsesEnvironmentVariable}"
                      PlaceholderText="OPENKUSTOEXPLORER_AUTOMATION_WEBHOOK"
                      Text="{Binding AutomationNotifications.WebhookEnvironmentVariableName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
              </StackPanel>

              <Border Height="1" Background="{DynamicResource DecorativeDividerBrush}" />

              <StackPanel Spacing="8">
                <TextBlock Classes="sectionLabel" Text="MESSAGE" />
                <TextBox
                    AutomationProperties.Name="Automation notification subject"
                  desktop:EnterKeyCommand.Command="{Binding AutomationNotifications.SaveCommand}"
                    PlaceholderText="Subject"
                  Text="{Binding AutomationNotifications.SubjectTemplate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox
                    MinHeight="92"
                    AcceptsReturn="True"
                    AutomationProperties.Name="Automation notification message"
                    PlaceholderText="Message"
                    Text="{Binding AutomationNotifications.MessageTemplate}"
                    TextWrapping="Wrap" />
                <WrapPanel>
                  <Button Margin="0,0,6,6" Classes="command" Command="{Binding AutomationNotifications.AppendMessageHelperCommand}" CommandParameter="{}{row_count}" Content="{}{row_count}" />
                  <Button Margin="0,0,6,6" Classes="command" Command="{Binding AutomationNotifications.AppendMessageHelperCommand}" CommandParameter="{}{name}" Content="{}{name}" />
                  <Button Margin="0,0,6,6" Classes="command" Command="{Binding AutomationNotifications.AppendMessageHelperCommand}" CommandParameter="{}{query}" Content="{}{query}" />
                  <Button Margin="0,0,6,6" Classes="command" Command="{Binding AutomationNotifications.AppendMessageHelperCommand}" CommandParameter="{}{rows_changed}" Content="{}{rows_changed}" />
                </WrapPanel>
              </StackPanel>

              <Border
                  Padding="9,7"
                  Background="{DynamicResource SubtleSurfaceBrush}"
                  BorderBrush="{DynamicResource ErrorBrush}"
                  BorderThickness="1"
                  CornerRadius="5"
                  IsVisible="{Binding AutomationNotifications.HasError}">
                <TextBlock FontSize="{DynamicResource TypeCompactSize}" Text="{Binding AutomationNotifications.ErrorText}" TextWrapping="Wrap" />
              </Border>
            </StackPanel>
          </ScrollViewer>

          <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <Button Grid.Column="1" Classes="command" Command="{Binding AutomationNotifications.CloseCommand}" Content="Cancel" />
            <Button Grid.Column="2" Classes="primaryCommand" Command="{Binding AutomationNotifications.SaveCommand}" Content="Save actions" />
          </Grid>
        </Grid>
          </Border>
        </DataTemplate>
      </desktop:DeferredContentControl.ContentTemplate>
    </desktop:DeferredContentControl>

    <desktop:DeferredContentControl
        Grid.RowSpan="3"
        desktop:ModalDialog.IsEnabled="True"
        ZIndex="105"
        IsContentMaterialized="{Binding IsScheduleAutomationOpen}"
        IsVisible="{Binding IsScheduleAutomationOpen}"
        Background="#66000000">
      <desktop:DeferredContentControl.ContentTemplate>
        <DataTemplate x:DataType="presentation:MainWindowViewModel">
          <Border
          Width="600"
          Padding="20"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Background="{DynamicResource RaisedSurfaceBrush}"
          BorderBrush="{DynamicResource ControlBoundaryBrush}"
          BorderThickness="1"
          CornerRadius="6">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="13">
          <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock FontSize="{DynamicResource TypeTitleSize}" FontWeight="SemiBold" Text="Run query on schedule" />
            <TextBlock Classes="muted" FontSize="{DynamicResource TypeCompactSize}" Text="Schedules execute only while Open Kusto Explorer is running" />
          </StackPanel>

          <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="12">
            <StackPanel Grid.Column="0" Spacing="5">
              <TextBlock Classes="sectionLabel" Text="NAME" />
                <TextBox
                  Height="36"
                  MaxLength="100"
                  Padding="10,0"
                  desktop:EnterKeyCommand.Command="{Binding SaveAutomationCommand}"
                  Text="{Binding AutomationName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  VerticalContentAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="5">
              <TextBlock Classes="sectionLabel" Text="TARGET" />
              <Border Height="36" Padding="10,0" Background="{DynamicResource SubtleSurfaceBrush}" BorderBrush="{DynamicResource DecorativeDividerBrush}" BorderThickness="1" CornerRadius="4">
                <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource TypeCompactSize}" Text="{Binding AutomationTargetText}" TextTrimming="CharacterEllipsis" />
              </Border>
            </StackPanel>
          </Grid>

          <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
            <TextBlock Grid.Column="0" VerticalAlignment="Center" Classes="sectionLabel" Text="RUN EVERY" />
            <NumericUpDown Grid.Column="1" Minimum="1" Value="{Binding AutomationIntervalValue}" />
            <ComboBox Grid.Column="2" Width="130" ItemsSource="{Binding AutomationIntervalUnits}" SelectedItem="{Binding AutomationIntervalUnit}" />
            <TextBlock Grid.Column="3" VerticalAlignment="Center" Classes="tertiary" FontSize="{DynamicResource TypeSmallSize}" Text="First run occurs after this interval" />
          </Grid>

          <Grid Grid.Row="3" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
            <TextBlock Grid.Column="0" VerticalAlignment="Center" Classes="sectionLabel" Text="STOP" />
            <ComboBox Grid.Column="1" Width="120" ItemsSource="{Binding AutomationStopModes}" SelectedItem="{Binding AutomationStopMode}" />
            <NumericUpDown Grid.Column="2" Minimum="1" Value="{Binding AutomationStopAfterValue}" />
            <TextBlock Grid.Column="3" VerticalAlignment="Center" Classes="tertiary" FontSize="{DynamicResource TypeSmallSize}" Text="Ignored when Never is selected" />
          </Grid>

          <Border Grid.Row="4" MaxHeight="150" Padding="10" Background="{DynamicResource SubtleSurfaceBrush}" BorderBrush="{DynamicResource DecorativeDividerBrush}" BorderThickness="1" CornerRadius="5">
            <ScrollViewer>
              <TextBlock FontFamily="Cascadia Code, JetBrains Mono, Noto Sans Mono, monospace" FontSize="{DynamicResource TypeSmallSize}" Text="{Binding AutomationQueryText}" TextWrapping="Wrap" />
            </ScrollViewer>
          </Border>

          <Grid Grid.Row="5" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="{DynamicResource ErrorBrush}" FontSize="{DynamicResource TypeCompactSize}" IsVisible="{Binding HasAutomationScheduleError}" Text="{Binding AutomationScheduleErrorText}" TextWrapping="Wrap" />
            <Button Grid.Column="1" Classes="command" Command="{Binding CloseScheduleAutomationCommand}" Content="Cancel" />
            <Button Grid.Column="2" Classes="primaryCommand" Command="{Binding SaveAutomationCommand}" Content="Create automation" />
          </Grid>
        </Grid>
          </Border>
        </DataTemplate>
      </desktop:DeferredContentControl.ContentTemplate>
    </desktop:DeferredContentControl>

    <desktop:DeferredContentControl
        Grid.RowSpan="3"
        desktop:ModalDialog.IsEnabled="True"
        ZIndex="106"
        IsContentMaterialized="{Binding Recording.IsRecordingDialogOpen}"
        IsVisible="{Binding Recording.IsRecordingDialogOpen}"
        Background="#66000000">
      <desktop:DeferredContentControl.ContentTemplate>
        <DataTemplate x:DataType="presentation:MainWindowViewModel">
          <Border
          Width="480"
          Padding="20"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Background="{DynamicResource RaisedSurfaceBrush}"
          BorderBrush="{DynamicResource ControlBoundaryBrush}"
          BorderThickness="1"
          CornerRadius="6"
          KeyboardNavigation.TabNavigation="Cycle">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="13">
          <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock FontSize="{DynamicResource TypeTitleSize}" FontWeight="SemiBold" Text="Record query session" />
            <TextBlock Classes="muted" FontSize="{DynamicResource TypeCompactSize}" Text="Query text and retained results are stored locally until you delete the session" TextWrapping="Wrap" />
          </StackPanel>
          <ToggleSwitch
              Grid.Row="1"
              AutomationProperties.Name="Append to an existing recorded session"
              Content="Append to existing session"
              IsChecked="{Binding Recording.IsAppendMode}" />
          <TextBox
              x:Name="RecordingNameTextBox"
              Grid.Row="2"
              Height="36"
              MaxLength="100"
              Padding="10,0"
              AutomationProperties.Name="New recorded session name"
              IsVisible="{Binding !Recording.IsAppendMode}"
              Text="{Binding Recording.NewSessionName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
              VerticalContentAlignment="Center" />
          <ComboBox
              Grid.Row="2"
              AutomationProperties.Name="Existing recorded session"
              IsVisible="{Binding Recording.IsAppendMode}"
              ItemsSource="{Binding Recording.Sessions}"
              SelectedItem="{Binding Recording.SelectedAppendSession, Mode=TwoWay}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="presentation:KustoRecordedSessionSummaryViewModel">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1" Classes="tertiary" FontSize="{DynamicResource TypeMetadataSize}" Text="{Binding ExecutionCountText}" />
                </Grid>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock
              Grid.Row="3"
              Foreground="{DynamicResource ErrorBrush}"
              FontSize="{DynamicResource TypeCompactSize}"
              IsVisible="{Binding Recording.HasRecordingError}"
              Text="{Binding Recording.RecordingErrorText}"
              TextWrapping="Wrap" />
          <Grid Grid.Row="4" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <Button Grid.Column="1" Classes="command" Click="OnCloseRecordingClick" Content="Cancel" />
            <Button
                Grid.Column="2"
                AutomationProperties.Name="Save and start query recording"
                Classes="primaryCommand"
              Click="OnStartRecordingClick"
              IsEnabled="{Binding Recording.CanStartRecording}"
                Content="Save and start" />
          </Grid>
        </Grid>
          </Border>
        </DataTemplate>
      </desktop:DeferredContentControl.ContentTemplate>
    </desktop:DeferredContentControl>

    <Border
        Grid.RowSpan="3"
        desktop:ModalDialog.IsEnabled="True"
        ZIndex="107"
        IsVisible="{Binding Recording.IsExportConfirmationOpen}"
        Background="#66000000">
      <Border
          Width="460"
          Padding="20"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Background="{DynamicResource RaisedSurfaceBrush}"
          BorderBrush="{DynamicResource WarningBrush}"
          BorderThickness="1"
          CornerRadius="6"
          KeyboardNavigation.TabNavigation="Cycle">
        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="14">
          <TextBlock FontSize="{DynamicResource TypeTitleSize}" FontWeight="SemiBold" Text="Export recorded session?" />
          <TextBlock Grid.Row="1" Text="The archive is not encrypted. It includes query text, cluster and database names, errors, annotations, and retained result values." TextWrapping="Wrap" />
          <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <Button Grid.Column="1" Classes="command" Click="OnCancelRecordedSessionExportClick" Content="Cancel" />
            <Button Grid.Column="2" AutomationProperties.Name="Choose recorded session export file" Classes="primaryCommand" Click="OnConfirmRecordedSessionExportClick" Content="Choose file" />
          </Grid>
        </Grid>
      </Border>
    </Border>

    <Border
        Grid.RowSpan="3"
        desktop:ModalDialog.IsEnabled="True"
        ZIndex="108"
        IsVisible="{Binding Recording.IsDeleteConfirmationOpen}"
        Background="#66000000">
      <Border
          Width="440"
          Padding="20"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Background="{DynamicResource RaisedSurfaceBrush}"
          BorderBrush="{DynamicResource ErrorBrush}"
          BorderThickness="1"
          CornerRadius="6"
          KeyboardNavigation.TabNavigation="Cycle">
        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="14">
          <TextBlock FontSize="{DynamicResource TypeTitleSize}" FontWeight="SemiBold" Text="Delete recorded session?" />
          <TextBlock Grid.Row="1" Text="This permanently removes the recorded queries, results, marks, and chain endpoints from local storage." TextWrapping="Wrap" />
          <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <Button Grid.Column="1" Classes="command" Click="OnCancelRecordedSessionDeleteClick" Content="Cancel" />
            <Button Grid.Column="2" AutomationProperties.Name="Confirm delete recorded session" Classes="dangerCommand" Click="OnDeleteRecordedSessionClick" Content="Delete" />
          </Grid>
        </Grid>
      </Border>
    </Border>

    <Border
        Grid.RowSpan="3"
        desktop:ModalDialog.IsEnabled="True"
        ZIndex="109"
        IsVisible="{Binding Recording.IsDeleteExecutionConfirmationOpen}"
        Background="#66000000">
      <Border
          Width="440"
          Padding="20"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Background="{DynamicResource RaisedSurfaceBrush}"
          BorderBrush="{DynamicResource ErrorBrush}"
          BorderThickness="1"
          CornerRadius="6"
          KeyboardNavigation.TabNavigation="Cycle">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10">
          <TextBlock FontSize="{DynamicResource TypeTitleSize}" FontWeight="SemiBold" Text="Delete recorded query?" />
          <TextBlock Grid.Row="1" FontWeight="SemiBold" Text="{Binding Recording.SelectedExecution.QueryTitle}" />
          <TextBlock Grid.Row="2" Text="This permanently removes the query, results, marks, and chain endpoints that depend on it." TextWrapping="Wrap" />
          <Grid Grid.Row="3" Margin="0,4,0,0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <Button Grid.Column="1" Classes="command" Command="{Binding Recording.CancelDeleteExecutionCommand}" Content="Cancel" />
            <Button Grid.Column="2" AutomationProperties.Name="Confirm delete recorded query" Classes="dangerCommand" Command="{Binding Recording.DeleteExecutionCommand}" Content="Delete query" />
          </Grid>
        </Grid>
      </Border>
    </Border>

    <Border
        Grid.RowSpan="3"
        desktop:ModalDialog.IsEnabled="True"
        ZIndex="110"
        IsVisible="{Binding Recording.IsChainGenerationDialogOpen}"
        Background="#66000000">
      <Border
          Width="500"
          Padding="20"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Background="{DynamicResource RaisedSurfaceBrush}"
          BorderBrush="{DynamicResource ErrorBrush}"
          BorderThickness="1"
          CornerRadius="6"
          KeyboardNavigation.TabNavigation="Cycle">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="14">
          <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
            <LucideIcon VerticalAlignment="Center" Kind="CircleAlert" Size="18" Foreground="{DynamicResource ErrorBrush}" />
            <TextBlock
                VerticalAlignment="Center"
                FontSize="{DynamicResource TypeTitleSize}"
                FontWeight="SemiBold"
                Text="Query could not be generated" />
          </StackPanel>
          <TextBlock
              Grid.Row="1"
              Text="{Binding Recording.ChainGenerationDialogMessage}"
              TextWrapping="Wrap" />
          <StackPanel Grid.Row="2" Spacing="4">
            <TextBlock FontWeight="SemiBold" Text="How to enable generation" />
            <TextBlock
                Classes="muted"
                FontSize="{DynamicResource TypeCompactSize}"
                Text="{Binding Recording.ChainGenerationGuidanceText}"
                TextWrapping="Wrap" />
          </StackPanel>
          <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <Button
                Grid.Column="1"
                Classes="command"
                Command="{Binding Recording.DismissChainGenerationDialogCommand}"
                Content="Not now" />
            <Button
                Grid.Column="2"
                AutomationProperties.Name="Run more queries to enable query generation"
                Classes="primaryCommand"
                Command="{Binding Recording.AddChainEvidenceCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <LucideIcon Kind="CirclePlus" Size="14" />
                <TextBlock FontWeight="SemiBold" Text="Run more queries" />
              </StackPanel>
            </Button>
          </Grid>
        </Grid>
      </Border>
    </Border>

    <Border
        Grid.RowSpan="3"
        desktop:ModalDialog.IsEnabled="True"
        ZIndex="109"
        IsVisible="{Binding IsGraphImportChoiceOpen}"
        Background="#66000000">
      <Border
          Width="500"
          Padding="20"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Background="{DynamicResource RaisedSurfaceBrush}"
          BorderBrush="{DynamicResource ControlBoundaryBrush}"
          BorderThickness="1"
          CornerRadius="6">
        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="14">
          <StackPanel Grid.Row="0" Spacing="3">
            <TextBlock
                FontSize="{DynamicResource TypeTitleSize}"
                FontWeight="SemiBold"
                Text="Graph already contains data" />
            <TextBlock
                Classes="muted"
                FontSize="{DynamicResource TypeCompactSize}"
                Text="{Binding GraphImportChoiceSummary}" />
          </StackPanel>

          <TextBlock
              Grid.Row="1"
              Text="Add these results to the current graph or replace the active graph."
              TextWrapping="Wrap" />

          <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
            <Button
                Grid.Column="1"
                Classes="command"
                Command="{Binding CancelGraphImportCommand}"
                Content="Cancel" />
            <Button
                Grid.Column="2"
                Classes="command"
                Command="{Binding ReplaceGraphImportCommand}"
                Content="Replace graph" />
            <Button
                Grid.Column="3"
                Classes="primaryCommand"
                Command="{Binding AddGraphImportCommand}"
                Content="Add to graph" />
          </Grid>
        </Grid>
      </Border>
    </Border>
  </Grid>
</UserControl>