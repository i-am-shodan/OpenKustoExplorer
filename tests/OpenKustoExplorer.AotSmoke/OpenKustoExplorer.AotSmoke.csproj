<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
    <!-- Azure.AI.OpenAI emits aggregate warnings for generated serializers; see azure-sdk-for-net#45712. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);IL2104;IL3053</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
    <ProjectReference Include="..\..\src\OpenKustoExplorer.Infrastructure\OpenKustoExplorer.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\OpenKustoExplorer.Kusto\OpenKustoExplorer.Kusto.csproj" />
    <ProjectReference Include="..\..\src\OpenKustoExplorer.Portable\OpenKustoExplorer.Portable.csproj" />
  </ItemGroup>
</Project>